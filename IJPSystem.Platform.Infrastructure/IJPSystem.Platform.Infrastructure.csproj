<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.72" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.5" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Devices/Meniscus (DMD Modbus RTU) -->
    <PackageReference Include="NModbus" Version="3.0.81" />
    <PackageReference Include="NModbus.Serial" Version="3.0.81" />
    <!-- Devices/DropWatcher (iCore Strobe 시리얼) -->
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <!-- Devices/DropWatcher 액적 영상분석(OpenCV). runtime.win 은 x86/x64 네이티브 모두 포함 → win-x86 빌드 지원 -->
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IJPSystem.Platform.Common\IJPSystem.Platform.Common.csproj" />
    <ProjectReference Include="..\IJPSystem.Platform.Domain\IJPSystem.Platform.Domain.csproj" />
  </ItemGroup>

  <!-- Devices/DropWatcher — Meteor PrinterInterface 직접 참조(x86 인프로세스, AnyCPU 래퍼).
       네이티브 PrinterInterface.dll 은 제어PC의 Meteor 설치본을 런타임에 사용(또는 배포 시 동봉).
       상세: lib\Meteor\x86\README.md, 메모리 project_meteor_bitness. -->
  <ItemGroup>
    <Reference Include="PrinterInterfaceCLS">
      <HintPath>..\lib\Meteor\x86\PrinterInterfaceCLS.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="MeteorCLS">
      <HintPath>..\lib\Meteor\x86\MeteorCLS.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Database\AlarmMaster_Seed.sql" />
  </ItemGroup>

</Project>
