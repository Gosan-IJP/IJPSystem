<Window x:Class="IJPSystem.Platform.HMI.Nozzle.NozzleSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:nz="clr-namespace:IJPSystem.Platform.HMI.Nozzle"
        Title="Nozzle Select" Height="560" MinHeight="560" Width="900" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A" Foreground="#E2E8F0"
        FontFamily="Segoe UI">
    <!-- Height 는 2줄(BaselineRows) 기준값이다. 줄이 더 많으면 코드비하인드가 줄 수만큼 늘린다.

         MinHeight 는 <b>막대를 뺀 나머지가 다 들어가는 높이</b>다(고정 내용 ≈400 + 막대 최소 120).
         이보다 작게 잡으면 창을 줄였을 때 다시 [확인]/[취소]가 잘린다 — 440 이었을 때가 그랬다. -->
    <Window.Resources>
        <Style x:Key="LightBox" TargetType="TextBox">
            <Setter Property="Background"      Value="#E5E7EB"/>
            <Setter Property="Foreground"      Value="#111827"/>
            <Setter Property="BorderBrush"     Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"      Value="Consolas"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="Padding"         Value="6,4"/>
        </Style>

        <!-- 공통 버튼 — 배경을 TemplateBinding 해야 강조색이 실제로 보인다. -->
        <Style x:Key="NzBtn" TargetType="Button">
            <Setter Property="Foreground"      Value="#E2E8F0"/>
            <Setter Property="Background"      Value="#1E293B"/>
            <Setter Property="BorderBrush"     Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <!-- ★ 남는 공간을 갖는 행은 <b>노즐 막대 하나뿐</b>이다(Height="*").
             나머지는 전부 Auto — 즉 창이 작아지면 막대가 줄고 그 안에서 스크롤되며,
             [확인]/[취소]는 어떤 높이에서도 화면에 남는다.

             예전에는 막대도 Auto 라 8줄(S3200 = 4칩 × 2열)이면 제 크기를 그대로 요구했고,
             창 높이는 작업 영역에서 잘리므로 아래 버튼이 밖으로 밀려 눌 수가 없었다. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 제목 + 개수 + 도움말 -->
            <RowDefinition Height="*"/>      <!-- 노즐 막대 — 여기만 늘고 준다 -->
            <RowDefinition Height="Auto"/>   <!-- 선택 구간 -->
            <RowDefinition Height="Auto"/>   <!-- 빠른 선택 -->
            <RowDefinition Height="Auto"/>   <!-- 명령 입력 -->
            <RowDefinition Height="Auto"/>   <!-- 도움말(접힘) -->
            <RowDefinition Height="Auto"/>   <!-- 상태 -->
            <RowDefinition Height="Auto"/>   <!-- 확인 / 취소 -->
        </Grid.RowDefinitions>

        <!-- ── 머리 ─────────────────────────────────────────────── -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="노즐 선택" FontSize="20" FontWeight="Bold" Foreground="#F1F5F9"/>
            <ToggleButton x:Name="HelpToggle" DockPanel.Dock="Right" Content="?" Width="28" Height="28"
                          Foreground="#93C5FD" Background="#1E293B" BorderBrush="#475569"
                          FontWeight="Bold" Cursor="Hand" ToolTip="입력 문법 도움말"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Foreground="#38BDF8"
                       FontSize="15" FontWeight="Bold" FontFamily="Consolas"
                       VerticalAlignment="Center" Margin="0,0,14,0"/>
            <TextBlock Text="{Binding HoverText}" Foreground="#64748B" FontSize="12" FontFamily="Consolas"
                       VerticalAlignment="Center" Margin="14,4,0,0"/>
        </DockPanel>

        <!-- ── 노즐 막대 ────────────────────────────────────────── -->
        <Border Grid.Row="1" Background="#0D1117" BorderBrush="#1E293B" BorderThickness="1"
                CornerRadius="6" Padding="10,8">
            <!-- 높이 상한은 바깥 행(Height="*")이 정한다 — 여기서 MaxHeight 로 고정하면
                 큰 화면에서 남는 공간을 못 쓴다. 줄이 많으면(S3200 = 8줄) 여기서 스크롤된다.
                 MinHeight: 창을 아무리 줄여도 막대가 한 줄은 보이게. -->
            <ScrollViewer MinHeight="120" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ModernScrollBarStyle}"/>
                </ScrollViewer.Resources>
            <StackPanel>
                <nz:NozzleStrip x:Name="Strip"
                                FirstNozzle="{Binding FirstNozzle}"
                                TotalNozzles="{Binding TotalNozzles}"
                                Rows="{Binding Rows}"
                                Selected="{Binding Selected}"
                                PreviewSelection="{Binding PreviewSelection}"/>
                <TextBlock Text="드래그로 선택 · 선택된 곳을 다시 드래그하면 해제 · 줄을 넘겨 끌면 그 사이 번호가 모두 잡힙니다"
                           Foreground="#475569" FontSize="11" Margin="0,6,0,0"/>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ── 선택 구간 ────────────────────────────────────────── -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="선택 구간" Foreground="#94A3B8" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox Grid.Column="1" Style="{StaticResource LightBox}" IsReadOnly="True"
                     Height="34" VerticalContentAlignment="Center"
                     Text="{Binding UsingNozzleText, Mode=OneWay}"
                     ToolTip="복사해서 기록하거나 아래 입력창에 붙여 쓸 수 있습니다"/>
        </Grid>

        <!-- ── 빠른 선택 ────────────────────────────────────────── -->
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource NzBtn}" Content="전체" Margin="0,0,6,0" Command="{Binding SelectAllCommand}"/>
                <Button Style="{StaticResource NzBtn}" Content="홀수" Margin="0,0,6,0" Command="{Binding SelectOddCommand}"/>
                <Button Style="{StaticResource NzBtn}" Content="짝수" Margin="0,0,6,0" Command="{Binding SelectEvenCommand}"/>
                <Button Style="{StaticResource NzBtn}" Content="반전" Margin="0,0,6,0" Command="{Binding InvertCommand}"/>
                <Button Style="{StaticResource NzBtn}" Content="해제" Command="{Binding ClearCommand}"
                        Background="#7F1D1D" BorderBrush="#B91C1C"/>
            </StackPanel>

            <!-- ── 칩 / 열 단위 ─────────────────────────────────
                 헤드가 칩·열로 나뉘어 있으므로 그 단위로 집는 버튼을 둔다. 800개(S3200 은 3,200)를
                 막대에서 손으로 끌어 칩 경계를 정확히 맞추는 것은 사실상 불가능하다.
                 개수는 헤드 설정을 따라간다 — 칩이 1개면 칩 줄 자체가 사라진다. -->
            <ItemsControl ItemsSource="{Binding ChipButtons}" Margin="0,8,0,0"
                          Visibility="{Binding HasChips, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- 왼쪽=더하기 / 오른쪽=빼기. 한 칩만 빼는 조작이 잦아 따로 버튼을 두지 않았다. -->
                        <Button Style="{StaticResource NzBtn}" Content="{Binding Label}" MinWidth="64"
                                Margin="0,0,6,0" Command="{Binding AddCommand}"
                                Background="#1E3A5F" BorderBrush="#3B82F6"
                                ToolTip="왼쪽 클릭 = 선택에 더함 / 오른쪽 클릭 = 뺌">
                            <Button.InputBindings>
                                <MouseBinding MouseAction="RightClick" Command="{Binding RemoveCommand}"/>
                            </Button.InputBindings>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding RowButtons}" Margin="0,6,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource NzBtn}" Content="{Binding Label}" MinWidth="64"
                                Margin="0,0,6,0" Command="{Binding AddCommand}"
                                Background="#312E81" BorderBrush="#6366F1"
                                ToolTip="왼쪽 클릭 = 선택에 더함 / 오른쪽 클릭 = 뺌 (칩 전체에 걸친 그 열)">
                            <Button.InputBindings>
                                <MouseBinding MouseAction="RightClick" Command="{Binding RemoveCommand}"/>
                            </Button.InputBindings>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- ── 명령 입력 ────────────────────────────────────────── -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBox x:Name="InputBox" Height="38" VerticalContentAlignment="Center"
                         Style="{StaticResource LightBox}"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="ADD(1~100); DEL(40~45)" IsHitTestVisible="False"
                           Foreground="#6B7280" FontFamily="Consolas" FontSize="14"
                           VerticalAlignment="Center" Margin="9,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=InputBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Button Grid.Column="2" Style="{StaticResource NzBtn}" Width="120" Height="38"
                    Content="적용" Command="{Binding ApplyCommand}" IsDefault="True"
                    Background="#1D4ED8" BorderBrush="#3B82F6"/>
        </Grid>

        <!-- ── 도움말 (기본 접힘) ─────────────────────────────────
             이 행은 Auto 다 — 펼치면 제 크기를 그대로 요구하므로 MaxHeight 가 없으면
             [확인]/[취소]를 다시 밀어낸다. 넘치는 만큼은 안에서 스크롤된다. -->
        <Border Grid.Row="5" Margin="0,10,0,0" Background="#33415580" CornerRadius="6"
                BorderBrush="#1E293B" BorderThickness="1" MaxHeight="240"
                Visibility="{Binding IsChecked, ElementName=HelpToggle,
                                     Converter={StaticResource BooleanToVisibilityConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                <ScrollViewer.Resources>
                    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ModernScrollBarStyle}"/>
                </ScrollViewer.Resources>
                <TextBlock Foreground="#CBD5E1" FontSize="13" LineHeight="21">
                    <Run FontWeight="Bold" Foreground="#93C5FD">입력 문법</Run><LineBreak/>
                    <Run>ADD( ) 추가 · DEL( ) 제거 · 구분자 ;  · 함수 ODD / EVEN</Run><LineBreak/>
                    <LineBreak/>
                    <Run>1~100 사용</Run>  <Run Foreground="#93C5FD">→ ADD(1~100)</Run><LineBreak/>
                    <Run>1~100 중 40~45 제외</Run>  <Run Foreground="#93C5FD">→ ADD(1~100); DEL(40~45)</Run><LineBreak/>
                    <Run>1~100 중 홀수만</Run>  <Run Foreground="#93C5FD">→ ADD(ODD:1~100)</Run><LineBreak/>
                    <Run>전체 중 짝수만</Run>  <Run Foreground="#93C5FD">→ ADD(EVEN)</Run><LineBreak/>
                    <LineBreak/>
                    <Run Foreground="#94A3B8">※ [적용]은 입력한 명령으로 선택을 새로 만듭니다 — 기존 선택에 더하지 않습니다.</Run><LineBreak/>
                    <Run Foreground="#94A3B8">※ 위 [선택 구간] 표기를 그대로 복사해 ADD( ) 안에 붙여 쓸 수 있습니다.</Run>
                </TextBlock>
            </ScrollViewer>
        </Border>

        <!-- ── 상태 ─────────────────────────────────────────────── -->
        <TextBlock Grid.Row="6" Margin="2,10,0,0" Text="{Binding StatusText}"
                   Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap"/>

        <!-- ── 확인 / 취소 ──────────────────────────────────────
             [적용]은 입력한 명령을 화면 선택에 반영할 뿐이고, 실제로 장비가 쓸 노즐이
             되는 것은 [확인]을 눌렀을 때다. 예전에는 창을 닫기만 해도 반영돼,
             잘못 건드린 선택을 되돌릴 방법이 없었다. -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <!-- IsDefault 는 [적용]이 갖는다 — 명령을 입력하다 Enter 를 치면 창이 닫히는 게 아니라
                 그 명령이 적용돼야 한다. 취소는 Esc(IsCancel)로도 된다. -->
            <Button Style="{StaticResource NzBtn}" Width="130" Height="40" FontSize="15"
                    Content="확인" Click="Ok_Click"
                    Background="#15803D" BorderBrush="#22C55E"/>
            <Button Style="{StaticResource NzBtn}" Width="130" Height="40" FontSize="15" Margin="10,0,0,0"
                    Content="취소" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
