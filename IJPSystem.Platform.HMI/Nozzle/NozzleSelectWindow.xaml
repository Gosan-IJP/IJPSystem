<Window x:Class="IJPSystem.Platform.HMI.Nozzle.NozzleSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nozzle Select" Height="780" Width="430"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A" Foreground="#E2E8F0"
        FontFamily="Segoe UI">
    <Window.Resources>
        <!-- 입력/표시 박스 (밝은 배경) -->
        <Style x:Key="LightBox" TargetType="TextBox">
            <Setter Property="Background"      Value="#E5E7EB"/>
            <Setter Property="Foreground"      Value="#111827"/>
            <Setter Property="BorderBrush"     Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"      Value="Consolas"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="Padding"         Value="6,4"/>
        </Style>
        <!-- Set Use Nozzle 버튼 -->
        <Style x:Key="SetBtn" TargetType="Button">
            <Setter Property="Foreground"      Value="#E2E8F0"/>
            <Setter Property="Background"      Value="#1E293B"/>
            <Setter Property="BorderBrush"     Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="FontSize"        Value="15"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 제목 -->
            <RowDefinition Height="170"/>    <!-- 현재 사용 노즐 목록 -->
            <RowDefinition Height="Auto"/>   <!-- 입력 + 버튼 -->
            <RowDefinition Height="*"/>      <!-- 도움말 -->
            <RowDefinition Height="Auto"/>   <!-- 상태 -->
        </Grid.RowDefinitions>

        <!-- 제목 -->
        <TextBlock Grid.Row="0" Text="Nozzle Select" FontSize="22" FontWeight="Bold"
                   Foreground="#F1F5F9" Margin="2,0,0,8"/>

        <!-- 현재 사용 노즐(읽기 전용, 콤마 목록) -->
        <TextBox Grid.Row="1" Style="{StaticResource LightBox}"
                 IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Text="{Binding UsingNozzleText, Mode=OneWay}"/>

        <!-- 입력 + Set Use Nozzle -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 워터마크가 있는 입력창 -->
            <Grid Grid.Column="0">
                <TextBox x:Name="InputBox" Height="44" VerticalContentAlignment="Center"
                         Style="{StaticResource LightBox}"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="ADD(0~999)" IsHitTestVisible="False"
                           Foreground="#6B7280" FontFamily="Consolas" FontSize="14"
                           VerticalAlignment="Center" Margin="9,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=InputBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Button Grid.Column="2" Style="{StaticResource SetBtn}" Width="150" Height="44"
                    Content="Set Use Nozzle" Command="{Binding SetUseNozzleCommand}"
                    IsDefault="True"/>
        </Grid>

        <!-- 도움말 패널 -->
        <Border Grid.Row="3" Margin="0,12,0,0" Background="#33415580" CornerRadius="6"
                BorderBrush="#1E293B" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,12">
                <TextBlock Foreground="#CBD5E1" FontSize="13" TextAlignment="Center" LineHeight="22">
                    <Run FontWeight="Bold" Foreground="#93C5FD">**** 노즐 설정 방법 ****</Run><LineBreak/>
                    <Run>문법: ADD( ), DEL( )</Run><LineBreak/>
                    <Run>지원 함수: ODD  EVEN</Run><LineBreak/>
                    <Run>구분 문자: ;</Run><LineBreak/>
                    <LineBreak/>
                    <Run FontWeight="Bold">사용 예시</Run><LineBreak/>
                    <Run Foreground="#64748B">--------- EX 1 ---------</Run><LineBreak/>
                    <Run>1,2,3,4,5,10,11,12,13,14번 노즐 사용</Run><LineBreak/>
                    <Run Foreground="#93C5FD">→ ADD(1,2,3,4,5,10,11,12,13,14)</Run><LineBreak/>
                    <Run>1~100까지 노즐 추가</Run>  <Run Foreground="#93C5FD">→ ADD(1~100)</Run><LineBreak/>
                    <Run>20~30 노즐 제거</Run>  <Run Foreground="#93C5FD">→ DEL(20~30)</Run><LineBreak/>
                    <Run>응용) 1~100 사용, 단 40~45 제외</Run><LineBreak/>
                    <Run Foreground="#93C5FD">→ ADD(1~100); DEL(40~45)</Run><LineBreak/>
                    <LineBreak/>
                    <Run Foreground="#64748B">--------- EX 2 ---------</Run><LineBreak/>
                    <Run>1~100 중 홀수만 추가</Run><LineBreak/>
                    <Run Foreground="#93C5FD">→ ADD(ODD:1~100)</Run><LineBreak/>
                    <Run>전체 노즐 중 짝수만 사용</Run>  <Run Foreground="#93C5FD">→ ADD(EVEN)</Run><LineBreak/>
                </TextBlock>
            </ScrollViewer>
        </Border>

        <!-- 상태 -->
        <TextBlock Grid.Row="4" Margin="2,10,0,0" Text="{Binding StatusText}"
                   Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap"/>
    </Grid>
</Window>
