<Window x:Class="IJPSystem.Platform.HMI.Print.EditPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Drawing Panel" Height="900" Width="1320"
        WindowStartupLocation="CenterOwner"
        Background="#E5E7EB" FontFamily="Segoe UI">
    <Window.Resources>
        <!-- 우측 액션 버튼 -->
        <Style x:Key="ActBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#3E4C63"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter VerticalAlignment="Center" Margin="16,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#4D5E7A"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 좌측 도구(라디오) -->
        <Style x:Key="ToolBtn" TargetType="RadioButton">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="GroupName" Value="tool"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#F3F4F6" BorderBrush="#9CA3AF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#BFDBFE"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 헤더 -->
            <RowDefinition Height="*"/>      <!-- 본체 -->
            <RowDefinition Height="Auto"/>   <!-- 상태바 -->
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <Border Grid.Row="0" Background="Black" Height="74">
            <TextBlock Text="Edit Panel" Foreground="White" FontSize="34" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- 본체: 도구 | 캔버스 | 액션 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>   <!-- 좌측 도구 -->
                <ColumnDefinition Width="*"/>       <!-- 캔버스 -->
                <ColumnDefinition Width="250"/>     <!-- 우측 액션 -->
            </Grid.ColumnDefinitions>

            <!-- 좌측 도구 스트립 -->
            <StackPanel Grid.Column="0" Background="#D1D5DB" Margin="6,8,0,8">
                <RadioButton Style="{StaticResource ToolBtn}" Tag="None"      Content="🔍" ToolTip="Zoom"/>
                <RadioButton Style="{StaticResource ToolBtn}" Tag="None"      Content="➤"  ToolTip="Select"/>
                <RadioButton Style="{StaticResource ToolBtn}" Tag="None"      Content="✋" ToolTip="Pan"/>
                <RadioButton Style="{StaticResource ToolBtn}" Tag="None"      Content="✛"  ToolTip="Crosshair"/>
                <RadioButton Style="{StaticResource ToolBtn}" Tag="Line"      Content="╱"  ToolTip="Line"      Checked="Tool_Checked"/>
                <RadioButton Style="{StaticResource ToolBtn}" Tag="Rectangle" Content="▭"  ToolTip="Rectangle" Checked="Tool_Checked"/>
                <RadioButton Style="{StaticResource ToolBtn}" Tag="Diamond"   Content="◇"  ToolTip="Diamond"   Checked="Tool_Checked"/>
                <RadioButton Style="{StaticResource ToolBtn}" Tag="Pen"       Content="〰"  ToolTip="Curve / Free draw" IsChecked="True" Checked="Tool_Checked"/>
                <RadioButton Style="{StaticResource ToolBtn}" Tag="Ellipse"   Content="◯"  ToolTip="Ellipse"   Checked="Tool_Checked"/>
            </StackPanel>

            <!-- 캔버스 영역 -->
            <Border Grid.Column="1" Background="#C7CBD1" Margin="0,8" ClipToBounds="True">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Border Background="White" BorderBrush="#9CA3AF" BorderThickness="1"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                        <Canvas x:Name="DrawCanvas" Background="White"
                                MouseDown="DrawCanvas_MouseDown" MouseMove="DrawCanvas_MouseMove"
                                MouseUp="DrawCanvas_MouseUp"/>
                    </Border>
                </ScrollViewer>
            </Border>

            <!-- 우측 액션 패널 -->
            <StackPanel Grid.Column="2" Margin="8,8,8,8">
                <Button Style="{StaticResource ActBtn}" Height="48" Margin="0,0,0,10" Content="✓   Apply Draw" Click="ApplyDraw_Click"/>
                <RadioButton GroupName="tool" Tag="Eraser" Checked="Tool_Checked" Cursor="Hand" Margin="0,0,0,4">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" Background="#3E4C63" CornerRadius="3" Height="44">
                                <TextBlock Text="⬚   Eraser" Foreground="White" FontSize="15" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="16,0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="bd" Property="Background" Value="#2563EB"/></Trigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#4D5E7A"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>
                <Button Style="{StaticResource ActBtn}" Height="44" Margin="0,0,0,12" Content="🗑   Clear Canvas" Click="ClearCanvas_Click"/>

                <Button Style="{StaticResource ActBtn}" Height="44" Margin="0,0,0,4" Content="⤓   Fill" Click="Fill_Click"/>
                <Button Style="{StaticResource ActBtn}" Height="44" Margin="0,0,0,12" Content="⤓   Auto Fill" Click="AutoFill_Click"/>

                <Button Style="{StaticResource ActBtn}" Height="44" Margin="0,0,0,4" Content="←   Undo" Click="Undo_Click"/>
                <Button Style="{StaticResource ActBtn}" Height="44" Margin="0,0,0,12" Content="→   Redo" Click="Redo_Click"/>

                <Button Style="{StaticResource ActBtn}" Height="44" Margin="0,0,0,12" Content="💾   Save" Click="Save_Click"/>

                <!-- 분할 -->
                <Border Background="White" BorderBrush="#374151" BorderThickness="2" Width="64" Height="64"
                        HorizontalAlignment="Center" Margin="0,4,0,2">
                    <Grid>
                        <Line X1="32" Y1="0" X2="32" Y2="64" Stroke="#374151" StrokeThickness="2"/>
                        <Line X1="0" Y1="32" X2="64" Y2="32" Stroke="#374151" StrokeThickness="2"/>
                    </Grid>
                </Border>
                <Border Background="#3E4C63" Width="90" Height="26" HorizontalAlignment="Center" Margin="0,0,0,12" CornerRadius="2">
                    <TextBlock Text="2x2" Foreground="White" FontFamily="Consolas" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Boundary Thickness" Foreground="#1E3A5F" FontWeight="Bold" FontSize="13" Margin="0,0,0,3"/>
                <TextBox x:Name="BoundaryBox" Height="26" Width="120" HorizontalAlignment="Left"
                         VerticalContentAlignment="Center" FontFamily="Consolas" Text="3"
                         TextChanged="Boundary_Changed"/>
                <Border Background="#E2E5E9" BorderBrush="#B7BEC8" BorderThickness="1" Width="120" Height="24"
                        HorizontalAlignment="Left" Margin="0,3,0,12">
                    <TextBlock x:Name="BoundaryMm" Text="0.0423 mm" FontFamily="Consolas" FontSize="12"
                               VerticalAlignment="Center" Margin="6,0"/>
                </Border>

                <Button Style="{StaticResource ActBtn}" Height="50" Content="⤓   Pattern Dittering" Click="PatternDittering_Click"/>
            </StackPanel>
        </Grid>

        <!-- 상태바 -->
        <Border Grid.Row="2" Background="#D1D5DB" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#F9FAFB" BorderBrush="#9CA3AF" BorderThickness="1" Padding="6,2">
                    <TextBlock x:Name="StatusInfo" FontFamily="Consolas" FontSize="12" Foreground="#1F2937"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="Line Width" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center"/>
                    <TextBox x:Name="LineWidthBox" Width="60" Height="26" Margin="8,0,0,0"
                             VerticalContentAlignment="Center" FontFamily="Consolas" Text="7"
                             TextChanged="LineWidth_Changed"/>
                    <Border Background="#F9FAFB" BorderBrush="#9CA3AF" BorderThickness="1" Padding="6,2" Margin="8,0,0,0">
                        <TextBlock x:Name="LineWidthMm" FontFamily="Consolas" FontSize="12" Text="0.2961 mm"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,8,0">
                    <TextBlock Text="Length Measure" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center"/>
                    <CheckBox x:Name="LengthMeasureChk" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
