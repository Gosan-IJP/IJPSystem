<Window x:Class="IJPSystem.Platform.HMI.Print.EditPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IJPSystem.Platform.HMI.Print"
        Title="Drawing Panel" Height="900" Width="1320"
        WindowStartupLocation="CenterOwner"
        Background="#E5E7EB" FontFamily="Segoe UI">
    <Window.Resources>
        <!-- 우측 액션 버튼 -->
        <Style x:Key="ActBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#3E4C63"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter VerticalAlignment="Center" Margin="16,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#4D5E7A"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#9AA3B2"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 모드 토글 버튼(Eraser/Fill): 활성 시 파란색 -->
        <Style x:Key="ModeBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#3E4C63"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter VerticalAlignment="Center" Margin="16,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#4D5E7A"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 헤더 -->
            <RowDefinition Height="*"/>      <!-- 본체 -->
            <RowDefinition Height="Auto"/>   <!-- 상태바 -->
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <Border Grid.Row="0" Background="Black" Height="74">
            <TextBlock Text="Edit Panel" Foreground="White" FontSize="34" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- 본체: 캔버스 | 액션 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>       <!-- 캔버스 -->
                <ColumnDefinition Width="250"/>     <!-- 우측 액션 -->
            </Grid.ColumnDefinitions>

            <!-- 그리기 캔버스(그리드 비트맵) -->
            <Border Grid.Column="0" Background="#C7CBD1" Margin="8" ClipToBounds="True">
                <Border Background="White" BorderBrush="#9CA3AF" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                    <local:DrawingPanelView x:Name="Panel"/>
                </Border>
            </Border>

            <!-- 우측 액션 패널 -->
            <StackPanel Grid.Column="1" Margin="8,8,8,8">
                <Button Style="{StaticResource ActBtn}" Height="48" Margin="0,0,0,10" Content="✓   Apply Draw"
                        Command="{Binding ApplyDrawCommand}"/>

                <Button Height="44" Margin="0,0,0,4" Content="⬚   Eraser" Command="{Binding EraserCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Mode}" Value="Erase">
                                    <Setter Property="Background" Value="#2563EB"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Style="{StaticResource ActBtn}" Height="44" Margin="0,0,0,12" Content="🗑   Clear Canvas"
                        Command="{Binding ClearCanvasCommand}"/>

                <Button Height="44" Margin="0,0,0,4" Content="⤓   Fill" Command="{Binding FillCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Mode}" Value="RoiFill">
                                    <Setter Property="Background" Value="#2563EB"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Style="{StaticResource ActBtn}" Height="44" Margin="0,0,0,12" Content="⤓   Auto Fill"
                        Command="{Binding AutoFillCommand}"/>

                <Button Style="{StaticResource ActBtn}" Height="44" Margin="0,0,0,4" Content="←   Undo"
                        Command="{Binding UndoCommand}"/>
                <Button Style="{StaticResource ActBtn}" Height="44" Margin="0,0,0,12" Content="→   Redo"
                        Command="{Binding RedoCommand}"/>

                <Button Style="{StaticResource ActBtn}" Height="44" Margin="0,0,0,12" Content="💾   Save"
                        Command="{Binding SaveCommand}"/>

                <!-- NxN 크기: 스피너로 조절 → 그리드 재생성 -->
                <Border Background="White" BorderBrush="#374151" BorderThickness="2" Width="64" Height="64"
                        HorizontalAlignment="Center" Margin="0,4,0,2">
                    <Grid>
                        <Line X1="32" Y1="0" X2="32" Y2="64" Stroke="#374151" StrokeThickness="2"/>
                        <Line X1="0" Y1="32" X2="64" Y2="32" Stroke="#374151" StrokeThickness="2"/>
                    </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <StackPanel Margin="0,0,4,0" VerticalAlignment="Center">
                        <RepeatButton Content="▲" Width="20" Height="14" FontSize="8" Command="{Binding SizeUpCommand}"/>
                        <RepeatButton Content="▼" Width="20" Height="14" FontSize="8" Command="{Binding SizeDownCommand}"/>
                    </StackPanel>
                    <Border Background="White" BorderBrush="#9CA3AF" BorderThickness="1" Width="120" Height="28">
                        <TextBlock Text="{Binding SizeText}" Foreground="#1F2937" FontFamily="Consolas" FontWeight="Bold" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <TextBlock Text="Boundary Thickness" Foreground="#1E3A5F" FontWeight="Bold" FontSize="13" Margin="0,0,0,3"/>
                <TextBox x:Name="BoundaryBox" Height="26" Width="120" HorizontalAlignment="Left"
                         VerticalContentAlignment="Center" FontFamily="Consolas" Text="3"
                         TextChanged="Boundary_Changed"/>
                <Border Background="#E2E5E9" BorderBrush="#B7BEC8" BorderThickness="1" Width="120" Height="24"
                        HorizontalAlignment="Left" Margin="0,3,0,12">
                    <TextBlock x:Name="BoundaryMm" Text="0.0423 mm" FontFamily="Consolas" FontSize="12"
                               VerticalAlignment="Center" Margin="6,0"/>
                </Border>

                <Button Style="{StaticResource ActBtn}" Height="50" Content="⤓   Pattern Dittering" Click="PatternDittering_Click"/>
            </StackPanel>
        </Grid>

        <!-- 상태바 -->
        <Border Grid.Row="2" Background="#D1D5DB" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#F9FAFB" BorderBrush="#9CA3AF" BorderThickness="1" Padding="6,2">
                    <TextBlock Text="{Binding StatusText}" FontFamily="Consolas" FontSize="12" Foreground="#1F2937"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="Pen Width" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center"/>
                    <TextBox x:Name="LineWidthBox" Width="60" Height="26" Margin="8,0,0,0"
                             VerticalContentAlignment="Center" FontFamily="Consolas"
                             Text="{Binding PenWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="LineWidth_Changed"/>
                    <Border Background="#F9FAFB" BorderBrush="#9CA3AF" BorderThickness="1" Padding="6,2" Margin="8,0,0,0">
                        <TextBlock x:Name="LineWidthMm" FontFamily="Consolas" FontSize="12" Text="0.0423 mm"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,8,0">
                    <TextBlock Text="Length Measure" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center"/>
                    <CheckBox x:Name="LengthMeasureChk" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
