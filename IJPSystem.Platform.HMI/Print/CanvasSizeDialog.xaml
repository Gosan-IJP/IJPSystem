<Window x:Class="IJPSystem.Platform.HMI.Print.CanvasSizeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set size of canvas" Height="380" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F1F3F5" FontFamily="Segoe UI">
    <Border Margin="14" Background="White" BorderBrush="#C7CBD1" BorderThickness="1" CornerRadius="3">
        <Grid Margin="24,20">
            <!-- 입력 줄은 Auto — 예전에는 * 로 두고 가운데 정렬해서, 내용이 칸보다 몇 px 만 커져도
                 위아래로 똑같이 삐져나가 "Width (mm)" 글자의 윗부분이 잘렸다.
                 남는 자리는 빈 행(2)이 먹는다. 이러면 창이 작아져도 글자부터 잘리는 일은 없다. -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- 안내 문구 -->
                <RowDefinition Height="Auto"/>   <!-- 입력 -->
                <RowDefinition Height="*"/>      <!-- 여백 -->
                <RowDefinition Height="Auto"/>   <!-- 버튼 -->
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Foreground="#1F2937" FontSize="14">
                <Run Text="Please set your Canvas size"/><LineBreak/>
                <Run Text="(max size: 200mm x 200mm)"/>
            </TextBlock>

            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                <TextBlock Text="Width (mm)" Foreground="#1F2937" FontSize="14" Margin="0,0,0,4"/>
                <TextBox x:Name="WidthBox" Width="150" HorizontalAlignment="Left" Height="28"
                         VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="14"
                         Background="#E2E5E9" BorderBrush="#9CA3AF" Text="200"/>
                <TextBlock Text="Length (mm)" Foreground="#1F2937" FontSize="14" Margin="0,12,0,4"/>
                <TextBox x:Name="LengthBox" Width="150" HorizontalAlignment="Left" Height="28"
                         VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="14"
                         Background="#E2E5E9" BorderBrush="#9CA3AF" Text="200"/>
                <TextBlock x:Name="ErrorText" Foreground="#DC2626" FontSize="12" Margin="0,8,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button Content="OK" Width="150" Height="36" Margin="0,0,12,0"
                        Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="Bold"
                        IsDefault="True" Click="Ok_Click"/>
                <Button Content="Cancel" Width="150" Height="36"
                        Background="#E5E7EB" Foreground="#1F2937" BorderBrush="#9CA3AF"
                        IsCancel="True" Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
