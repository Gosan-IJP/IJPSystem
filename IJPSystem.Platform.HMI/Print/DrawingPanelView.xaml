<UserControl x:Class="IJPSystem.Platform.HMI.Print.DrawingPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid>
        <!-- NxN 그리드를 1px=1셀 비트맵으로 렌더 후 NearestNeighbor 로 확대 -->
        <Image x:Name="CanvasImage" Stretch="Fill"
               RenderOptions.BitmapScalingMode="NearestNeighbor"
               SnapsToDevicePixels="True"/>
        <!-- 입력 캡처 + ROI 미리보기(투명 오버레이 Canvas) -->
        <Canvas x:Name="CanvasHost" Background="Transparent"
                MouseLeftButtonDown="CanvasHost_MouseLeftButtonDown"
                MouseMove="CanvasHost_MouseMove"
                MouseLeftButtonUp="CanvasHost_MouseLeftButtonUp">
            <Rectangle x:Name="RoiRect" Visibility="Collapsed"
                       Stroke="#2563EB" StrokeThickness="1" StrokeDashArray="3 2"
                       Fill="#332563EB"/>
        </Canvas>
    </Grid>
</UserControl>
