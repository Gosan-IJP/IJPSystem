<Window x:Class="IJPSystem.Platform.HMI.Print.PatternPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:print="clr-namespace:IJPSystem.Platform.HMI.Print"
        Title="패턴 미리보기" Height="760" Width="1180"
        WindowStartupLocation="CenterOwner" Background="#F3F4F6">

    <Window.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground"          Value="#374151"/>
            <Setter Property="FontSize"            Value="12"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="Margin"              Value="0,0,8,0"/>
        </Style>
        <Style x:Key="Num" TargetType="TextBox">
            <Setter Property="Height"              Value="26"/>
            <Setter Property="Margin"              Value="0,0,0,8"/>
            <Setter Property="TextAlignment"       Value="Right"/>
            <Setter Property="FontFamily"          Value="Consolas"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Act" TargetType="Button">
            <Setter Property="Height"     Value="34"/>
            <Setter Property="Margin"     Value="0,4,0,0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor"     Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ 미리보기 ══════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Grid.Column="0" Background="White"
                BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="발사 지도  (가로 = 노즐, 세로 = 스캔 진행, 밝을수록 큰 방울)"
                           Foreground="#374151" FontSize="12" Margin="2,0,0,6"/>
                <print:PatternPreview x:Name="Preview"/>
            </DockPanel>
        </Border>

        <!-- ══ 파라미터 ══════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="0" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 원본 -->
                <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                        CornerRadius="6" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="원본 이미지" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,8"/>
                        <TextBlock x:Name="SourceText" Text="(없음)" Foreground="#6B7280" FontSize="11"
                                   FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                        <Button Style="{StaticResource Act}" Content="이미지 열기" Click="OpenImage_Click"/>
                    </StackPanel>
                </Border>

                <!-- 노즐 배열 -->
                <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                        CornerRadius="6" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="노즐 배열" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,2"/>
                        <!-- 이 값들이 미확인이라 화면에서 바꿀 수 있게 둔다. 실장 스핏 한 줄로
                             확정되면 장비 설정(MachineData.db)으로 옮긴다. -->
                        <TextBlock Text="※ 실물 확인 전 가정값입니다" Foreground="#B45309" FontSize="10" Margin="0,0,0,8"/>

                        <TextBlock Style="{StaticResource Lbl}" Text="열 수"/>
                        <TextBox  x:Name="RowsBox"        Style="{StaticResource Num}" Text="3"/>

                        <TextBlock Style="{StaticResource Lbl}" Text="열당 노즐 수"/>
                        <TextBox  x:Name="PerRowBox"      Style="{StaticResource Num}" Text="266"/>

                        <TextBlock Style="{StaticResource Lbl}" Text="한 열 안 간격 [µm]"/>
                        <TextBox  x:Name="InRowPitchBox"  Style="{StaticResource Num}" Text="254.1"/>

                        <TextBlock Style="{StaticResource Lbl}" Text="열 오프셋 [µm]"/>
                        <TextBox  x:Name="RowOffsetBox"   Style="{StaticResource Num}" Text="84.7"/>

                        <TextBlock Style="{StaticResource Lbl}" Text="번호 규약"/>
                        <ComboBox x:Name="OrderBox" Height="26" SelectedIndex="0" Margin="0,0,0,4">
                            <ComboBoxItem Content="번갈아 (번호 1 = X 한 칸)"/>
                            <ComboBoxItem Content="한 열씩 (열을 끝까지)"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- RIP -->
                <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                        CornerRadius="6" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="RIP" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,8"/>

                        <TextBlock Style="{StaticResource Lbl}" Text="방울 단계"/>
                        <TextBox x:Name="LevelsBox"   Style="{StaticResource Num}" Text="2"/>

                        <TextBlock Style="{StaticResource Lbl}" Text="스캔 스텝 [µm]  (0 = 실효 간격)"/>
                        <TextBox x:Name="ScanStepBox" Style="{StaticResource Num}" Text="0"/>

                        <TextBlock Style="{StaticResource Lbl}" Text="원본 1픽셀 크기 [µm]"/>
                        <TextBox x:Name="UmPerPxBox"  Style="{StaticResource Num}" Text="84.7"/>

                        <CheckBox x:Name="BlendBox" Content="헤드 이음새 섞기" IsChecked="True"
                                  Foreground="#374151" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource Act}" Content="패턴 만들기" Click="Build_Click"
                        Background="#1D4ED8" Foreground="White" Height="40"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ══ 결과 요약 ═════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0"
                Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="10,8">
            <TextBlock x:Name="SummaryText" Foreground="#374151" FontSize="12"
                       FontFamily="Consolas" TextWrapping="Wrap"
                       Text="파라미터를 확인하고 [패턴 만들기]를 누르세요."/>
        </Border>
    </Grid>
</Window>
