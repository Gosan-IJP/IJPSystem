<UserControl x:Class="IJPSystem.Platform.HMI.Common.Controls.NumericSpinner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 화살표 버튼 — 칸 높이를 늘리지 않도록 자체 높이를 갖지 않는다.
             위/아래가 남은 높이를 반씩 나눠 갖는다. -->
        <Style x:Key="SpinButton" TargetType="RepeatButton">
            <Setter Property="Background"  Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Focusable"   Value="False"/>
            <Setter Property="Delay"       Value="400"/>
            <Setter Property="Interval"    Value="60"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,0,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#334155"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="PART_Root" Background="#0F172A" BorderBrush="#334155"
            BorderThickness="1" CornerRadius="3">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="PART_Text" Grid.Column="0"
                     Background="Transparent" Foreground="#E2E8F0" CaretBrush="#E2E8F0"
                     BorderThickness="0" FontFamily="Consolas" FontSize="11"
                     TextAlignment="Right" VerticalContentAlignment="Center" Padding="4,0"
                     LostFocus="OnTextLostFocus" KeyDown="OnTextKeyDown"/>

            <!-- 읽기 전용(계산값) 칸에서는 화살표를 감춘다 — 눌러도 안 바뀌는 버튼은
                 "고장난 것"으로 읽힌다. -->
            <Grid x:Name="PART_Spin" Grid.Column="1" Width="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <RepeatButton x:Name="PART_Up" Grid.Row="0" Style="{StaticResource SpinButton}"
                              Click="OnUp">
                    <Path Data="M 0,3 L 4,0 L 8,3 Z" Fill="#94A3B8"/>
                </RepeatButton>
                <RepeatButton x:Name="PART_Down" Grid.Row="1" Style="{StaticResource SpinButton}"
                              Click="OnDown">
                    <Path Data="M 0,0 L 4,3 L 8,0 Z" Fill="#94A3B8"/>
                </RepeatButton>
            </Grid>
        </Grid>
    </Border>
</UserControl>
