<UserControl x:Class="IJPSystem.Platform.HMI.Common.Controls.Barrel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="root">
    <!-- Barrel: 디스펜싱 시린지(주사기) 모양 잉크 배럴 — Pulse 단일 헤드용.
         flange(상단 핑거그립) + 원통 body + 어깨 콘 + 루어 팁.
         body 내부 y=26~180. 상단 purple = 가압(P) 인입 포트, 좌측 orange = 액위 센서.
         x<0 = 좌측 센서 영역, y<0 = 상단 포트 -->
    <Canvas>
        <!-- 상단 핑거 그립(flange) -->
        <Rectangle Canvas.Left="-3" Canvas.Top="8" Width="76" Height="16"
                   Stroke="#3B82F6" StrokeThickness="2" Fill="#1E293B"
                   RadiusX="4" RadiusY="4"/>

        <!-- 가압 인입 포트(P) — flange 위 중앙 -->
        <Ellipse Canvas.Left="28" Canvas.Top="-4" Width="14" Height="14"
                 Stroke="#A855F7" StrokeThickness="1.5" Fill="#1E293B"/>

        <!-- 원통 body -->
        <Rectangle Canvas.Left="10" Canvas.Top="24" Width="50" Height="158"
                   Stroke="#3B82F6" StrokeThickness="2" Fill="#1E293B"
                   RadiusX="3" RadiusY="3"/>

        <!-- 잉크(액위) — body 내부, 하단 기준 -->
        <Rectangle x:Name="Liquid" Canvas.Left="13" Canvas.Top="171" Width="44" Height="9"
                   Fill="#991B1B" Opacity="0.85"/>
        <!-- 액면(메니스커스) — 붉은 물결 -->
        <Polyline x:Name="Wave" Canvas.Left="0" Canvas.Top="168"
                  Points="13,4 19,0 25,5 31,1 37,5 43,0 49,5 55,1 57,3"
                  Stroke="#EF4444" StrokeThickness="3"
                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

        <!-- 눈금(시린지 스케일) — body 우측 안쪽 -->
        <Line X1="52" Y1="50"  X2="58" Y2="50"  Stroke="#475569" StrokeThickness="0.8"/>
        <Line X1="52" Y1="78"  X2="58" Y2="78"  Stroke="#475569" StrokeThickness="0.8"/>
        <Line X1="52" Y1="106" X2="58" Y2="106" Stroke="#475569" StrokeThickness="0.8"/>
        <Line X1="52" Y1="134" X2="58" Y2="134" Stroke="#475569" StrokeThickness="0.8"/>
        <Line X1="52" Y1="162" X2="58" Y2="162" Stroke="#475569" StrokeThickness="0.8"/>

        <!-- 어깨 하이라이트(입체감) -->
        <Line X1="13" Y1="28" X2="13" Y2="178" Stroke="#60A5FA" StrokeThickness="0.6" Opacity="0.35"/>

        <!-- 어깨 콘(테이퍼) -->
        <Path Stroke="#3B82F6" StrokeThickness="2" Fill="#1E293B"
              Data="M 10,182 L 60,182 L 46,202 L 24,202 Z"/>

        <!-- 루어 팁(노즐) -->
        <Rectangle Canvas.Left="29" Canvas.Top="202" Width="12" Height="12"
                   Stroke="#3B82F6" StrokeThickness="2" Fill="#1E293B"/>
        <!-- 토출구 표시 -->
        <Rectangle Canvas.Left="33" Canvas.Top="214" Width="4" Height="6" Fill="#EF4444"/>

        <!-- ── 2 Sensors (좌측 외부) ── -->
        <!-- HIGH (액위 상한) -->
        <Ellipse Canvas.Left="-18" Canvas.Top="44" Width="8" Height="8"
                 Fill="{Binding ElementName=root, Path=SensorHigh, Converter={StaticResource BoolToSensorBrush}}"/>
        <TextBlock Canvas.Left="-40" Canvas.Top="41" Text="HIGH" Foreground="#64748B" FontSize="8"/>
        <!-- LOW (액위 하한 — 보충 경고, 알람 색) -->
        <Ellipse Canvas.Left="-18" Canvas.Top="150" Width="8" Height="8"
                 Fill="{Binding ElementName=root, Path=SensorLow, Converter={StaticResource BoolToSensorBrush}, ConverterParameter=Alarm}"/>
        <TextBlock Canvas.Left="-38" Canvas.Top="147" Text="LOW" Foreground="#64748B" FontSize="8"/>

    </Canvas>
</UserControl>
