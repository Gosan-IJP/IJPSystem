<UserControl x:Class="IJPSystem.Platform.HMI.Views.DropWatcherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cvts="clr-namespace:IJPSystem.Platform.HMI.Common.Converters"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d" d:DesignHeight="780" d:DesignWidth="1400"
             Background="#0B0F1A">

    <UserControl.Resources>

        <!-- 파라미터 입력 박스 (라벨 + 단위) 공통 스타일 -->
        <Style x:Key="DwFieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>
        <Style x:Key="DwTextBox" TargetType="TextBox">
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="Foreground"               Value="White"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="FontFamily"               Value="Consolas"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding"                  Value="6,0"/>
            <Setter Property="CaretBrush"               Value="White"/>
        </Style>
        <Style x:Key="DwReadonlyBox" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="#94A3B8"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="FontFamily"   Value="Consolas"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment"  Value="Center"/>
            <Setter Property="Padding"      Value="6,0"/>
        </Style>
        <Style x:Key="DwUnit" TargetType="TextBlock">
            <Setter Property="Foreground"        Value="#64748B"/>
            <Setter Property="FontSize"          Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="6,0,8,0"/>
        </Style>
        <Style x:Key="DwSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="#3B82F6"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="Margin"      Value="0,0,0,12"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ 좌측: 카메라 이미지 패널 ════════════════════════════════════ -->
        <Border Grid.Column="0" Background="#111827" CornerRadius="12"
                BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 헤더 -->
                <Border Grid.Row="0" Background="#1E293B" CornerRadius="12,12,0,0" Padding="16,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="💧" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="DROP WATCHER  —  CAM_DW" Foreground="White"
                                   FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        <Border Margin="12,0,0,0" CornerRadius="6" Padding="8,3">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#450A0A"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CamStatus.IsConnected}" Value="True">
                                            <Setter Property="Background" Value="#14532D"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="11" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text"       Value="● DISCONNECTED"/>
                                        <Setter Property="Foreground" Value="#EF4444"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CamStatus.IsConnected}" Value="True">
                                                <Setter Property="Text"       Value="● CONNECTED"/>
                                                <Setter Property="Foreground" Value="#22C55E"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 툴바 (돋보기 / 포인터 / 손 / 선) — 표시용 -->
                <Border Grid.Row="1" Background="#0F172A" Padding="8,5" BorderBrush="#1F2937" BorderThickness="0,0,0,1">
                    <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button Width="30" Height="26" Margin="0,0,4,0" Content="🔍" FontSize="13"
                                Style="{StaticResource MutedActionButtonStyle}" Background="#1E293B" ToolTip="Zoom"/>
                        <Button Width="30" Height="26" Margin="0,0,4,0" Content="🖈" FontSize="13"
                                Style="{StaticResource MutedActionButtonStyle}" Background="#1E293B" ToolTip="Select"/>
                        <Button Width="30" Height="26" Margin="0,0,4,0" Content="✋" FontSize="13"
                                Style="{StaticResource MutedActionButtonStyle}" Background="#1E293B" ToolTip="Pan"/>
                        <Button Width="30" Height="26" Content="╱" FontSize="13"
                                Style="{StaticResource MutedActionButtonStyle}" Background="#1E293B" ToolTip="Line"/>

                        <!-- Live View 토글 -->
                        <Button Width="72" Height="26" Margin="12,0,0,0" Command="{Binding ToggleLiveViewCommand}"
                                ToolTip="Live View 토글 (연속 캡쳐)">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MutedActionButtonStyle}">
                                    <Setter Property="Background" Value="#0E7490"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLiveView}" Value="True">
                                            <Setter Property="Background" Value="#B91C1C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="{Binding LiveViewLabel}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                        </Button>
                    </StackPanel>

                    <!-- 이미지 열기 버튼 (우측 정렬) — Glass/NJI 화면과 동일한 모양.
                         Live 중에는 연속 캡쳐가 화면을 덮어써서 의미가 없으므로 비활성(커맨드 CanExecute). -->
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Command="{Binding OpenImageCommand}"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" ToolTip="저장된 이미지 파일 열기">
                        <Border CornerRadius="6" Padding="10,5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#334155"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver,
                                            RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                            <Setter Property="Background" Value="#475569"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEnabled,
                                            RelativeSource={RelativeSource AncestorType=Button}}" Value="False">
                                            <Setter Property="Background" Value="#1E293B"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📂" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="이미지 열기" Foreground="#94A3B8"
                                           FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Button>
                    </Grid>
                </Border>

                <!-- 이미지 영역 -->
                <Border Grid.Row="2" Background="#0D1117" Margin="2,0">
                    <Grid>
                        <!-- 플레이스홀더 (이미지 없을 때) -->
                        <Grid Visibility="{Binding HasNoImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="💧" FontSize="52" HorizontalAlignment="Center" Opacity="0.15"/>
                                <TextBlock Text="DROP WATCHER" Foreground="#1E3A5F"
                                           FontSize="13" FontWeight="Bold" FontFamily="Consolas"
                                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                <TextBlock Text="MEASURE VELOCITY 또는 TIME INTERVAL MEASURE 를 누르세요"
                                           Foreground="#1E293B" FontSize="11"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- 캡처 이미지 -->
                        <Image Source="{Binding CurrentFrame}"
                               Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <!-- 처리 중 오버레이 -->
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="#CC1C1A00" CornerRadius="10" Padding="24,12"
                                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="⏳  측정 중..." Foreground="#FCD34D"
                                       FontSize="14" FontWeight="Bold"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- 하단 상태바: 위(분석 결과) / 아래(오버레이 범례).
                     결과 문자열이 길어(노즐/직경/부피/속도/편차) 범례와 한 줄에 두면 잘리므로
                     행을 나눠 결과가 항상 전체 폭을 쓰게 한다. -->
                <Border Grid.Row="3" Background="#1E293B" CornerRadius="0,0,12,12" Padding="16,7">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" VerticalAlignment="Center"
                                   FontSize="11" FontFamily="Consolas"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   ToolTip="{Binding LastResultText}">
                            <Run Text="LAST : " Foreground="#475569"/>
                            <Run Text="{Binding CaptureTimeText, Mode=OneWay}" Foreground="#94A3B8" FontWeight="Bold"/>
                            <Run Text="  ▶  " Foreground="#475569"/>
                            <Run Text="{Binding LastResultText, Mode=OneWay}" Foreground="#FCD34D" FontWeight="Bold"/>
                        </TextBlock>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="Green = Velocity" Foreground="#22C55E" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="  Cyan = Measure Area" Foreground="#22D3EE" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="  Magenta = Column" Foreground="#E879F9" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ══ 중앙: 파라미터 / 제어 패널 ═══════════════════════════════════ -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ModernScrollBarStyle}"/>
            </ScrollViewer.Resources>

            <StackPanel>

                <!-- ── Drop Watcher Parameter ───────────────────────────────── -->
                <Border Background="#111827" CornerRadius="12" Padding="16" Margin="0,0,0,10"
                        BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="DROP WATCHER PARAMETER" Style="{StaticResource DwSectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Frequency -->
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Frequency" Style="{StaticResource DwFieldLabel}"/>
                                <Border Background="#0F172A" CornerRadius="6" Height="32" BorderBrush="#334155" BorderThickness="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="Hz" Style="{StaticResource DwUnit}"/>
                                        <TextBox Text="{Binding FrequencyHz, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DwTextBox}"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>

                            <!-- Delay Time -->
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Delay Time" Style="{StaticResource DwFieldLabel}"/>
                                <Border Background="#0F172A" CornerRadius="6" Height="32" BorderBrush="#334155" BorderThickness="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="us" Style="{StaticResource DwUnit}"/>
                                        <TextBox Text="{Binding DelayTimeUs, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DwTextBox}"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>

                            <!-- Duration -->
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="Duration" Style="{StaticResource DwFieldLabel}"/>
                                <Border Background="#0F172A" CornerRadius="6" Height="32" BorderBrush="#334155" BorderThickness="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="Sec" Style="{StaticResource DwUnit}"/>
                                        <TextBox Text="{Binding DurationSec, StringFormat={}{0:F0}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DwTextBox}"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>

                            <!-- 적용된 Delay (읽기 전용) -->
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="Applied Delay" Style="{StaticResource DwFieldLabel}"/>
                                <Border Background="#0B1220" CornerRadius="6" Height="32" BorderBrush="#1F2937" BorderThickness="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="us" Style="{StaticResource DwUnit}"/>
                                        <TextBlock Text="{Binding AppliedDelayUs, StringFormat={}{0:F1}}" Style="{StaticResource DwReadonlyBox}"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Delay Set (Delay 1 / Delay 2) ────────────────────────── -->
                <Border Background="#111827" CornerRadius="12" Padding="16" Margin="0,0,0,10"
                        BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="DELAY SET" Style="{StaticResource DwSectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Delay 1 -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Delay 1" Style="{StaticResource DwFieldLabel}"/>
                                <Border Background="#0B1220" CornerRadius="6" Height="32" BorderBrush="#1F2937" BorderThickness="1" Margin="0,0,0,8">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="us" Style="{StaticResource DwUnit}"/>
                                        <TextBlock Text="{Binding Delay1Us, StringFormat={}{0:F1}}" Style="{StaticResource DwReadonlyBox}"/>
                                    </DockPanel>
                                </Border>
                                <Button Height="40" Command="{Binding SetDelay1Command}"
                                        Style="{StaticResource MutedActionButtonStyle}" Background="#1E3A8A">
                                    <TextBlock Text="Set Delay Time" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                </Button>
                            </StackPanel>

                            <!-- Delay 2 -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Delay 2" Style="{StaticResource DwFieldLabel}"/>
                                <Border Background="#0B1220" CornerRadius="6" Height="32" BorderBrush="#1F2937" BorderThickness="1" Margin="0,0,0,8">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="us" Style="{StaticResource DwUnit}"/>
                                        <TextBlock Text="{Binding Delay2Us, StringFormat={}{0:F1}}" Style="{StaticResource DwReadonlyBox}"/>
                                    </DockPanel>
                                </Border>
                                <Button Height="40" Command="{Binding SetDelay2Command}"
                                        Style="{StaticResource MutedActionButtonStyle}" Background="#1E3A8A">
                                    <TextBlock Text="Set Delay Time" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Measure Parameter ────────────────────────────────────── -->
                <Border Background="#111827" CornerRadius="12" Padding="16" Margin="0,0,0,10"
                        BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="MEASURE PARAMETER" Style="{StaticResource DwSectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Measure Start Position -->
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Measure Start Position" Style="{StaticResource DwFieldLabel}"/>
                                <Border Background="#0F172A" CornerRadius="6" Height="32" BorderBrush="#334155" BorderThickness="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="um" Style="{StaticResource DwUnit}"/>
                                        <TextBox Text="{Binding MeasureStartUm, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DwTextBox}"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>

                            <!-- Measure END Position -->
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Measure END Position" Style="{StaticResource DwFieldLabel}"/>
                                <Border Background="#0F172A" CornerRadius="6" Height="32" BorderBrush="#334155" BorderThickness="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="um" Style="{StaticResource DwUnit}"/>
                                        <TextBox Text="{Binding MeasureEndUm, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DwTextBox}"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>

                            <!-- Time interval -->
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="Time interval" Style="{StaticResource DwFieldLabel}"/>
                                <Border Background="#0F172A" CornerRadius="6" Height="32" BorderBrush="#334155" BorderThickness="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="us" Style="{StaticResource DwUnit}"/>
                                        <TextBox Text="{Binding TimeIntervalUs, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DwTextBox}"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>

                            <!-- Measure Area X -->
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="Measure Area X" Style="{StaticResource DwFieldLabel}"/>
                                <Border Background="#0F172A" CornerRadius="6" Height="32" BorderBrush="#334155" BorderThickness="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="um" Style="{StaticResource DwUnit}"/>
                                        <TextBox Text="{Binding MeasureAreaXUm, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DwTextBox}"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Calibration (µm/px, 노즐면 Y) ─────────────────────────────
                     부피/직경/속도/낙하위치의 절대값이 µm/px 에 비례하므로 실장에서 반드시 교정한다.
                     교정법: 실제 노즐 피치(µm)를 입력 → [µm/px 교정]이 검출 액적 평균 픽셀 피치로 산출.
                     [교정값 저장]으로 DropWatcherConfig.json 에 남겨 다음 실행에도 유지. -->
                <Border Background="#111827" CornerRadius="12" Padding="16" Margin="0,0,0,10"
                        BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="CALIBRATION" Style="{StaticResource DwSectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 노즐 피치(입력) -->
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Nozzle Pitch (실측 입력)" Style="{StaticResource DwFieldLabel}"/>
                                <Border Background="#0F172A" CornerRadius="6" Height="32" BorderBrush="#334155" BorderThickness="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="um" Style="{StaticResource DwUnit}"/>
                                        <TextBox Text="{Binding NozzlePitchUm, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DwTextBox}"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>

                            <!-- µm/px (교정 결과 / 직접 입력) -->
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Scale (µm/px)" Style="{StaticResource DwFieldLabel}"/>
                                <Border Background="#0F172A" CornerRadius="6" Height="32" BorderBrush="#334155" BorderThickness="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="µm/px" Style="{StaticResource DwUnit}"/>
                                        <TextBox Text="{Binding MicronsPerPixel, StringFormat={}{0:F3}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DwTextBox}"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>

                            <!-- 노즐면 Y(입력) -->
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="Nozzle Face Y" Style="{StaticResource DwFieldLabel}"/>
                                <Border Background="#0F172A" CornerRadius="6" Height="32" BorderBrush="#334155" BorderThickness="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="px" Style="{StaticResource DwUnit}"/>
                                        <TextBox Text="{Binding NozzleYPixel, StringFormat={}{0:F0}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DwTextBox}"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- 교정 / 저장 버튼 -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Height="40" Command="{Binding CalibrateScaleCommand}"
                                    Style="{StaticResource MutedActionButtonStyle}" Background="#1E3A8A"
                                    ToolTip="현재 화면 이미지의 검출 액적 평균 피치로 µm/px 를 자동 산출">
                                <TextBlock Text="µm/px 교정" Foreground="White" FontSize="12" FontWeight="Bold"/>
                            </Button>
                            <Button Grid.Column="2" Height="40" Command="{Binding SaveCalibrationCommand}"
                                    Style="{StaticResource MutedActionButtonStyle}" Background="#334155"
                                    ToolTip="현재 캘리브레이션을 DropWatcherConfig.json 에 저장">
                                <TextBlock Text="교정값 저장" Foreground="White" FontSize="12" FontWeight="Bold"/>
                            </Button>
                        </Grid>

                        <!-- 초점 기준 — 이후 측정의 초점 이탈 판정 기준이 된다. -->
                        <Button Height="40" Margin="0,8,0,0" Command="{Binding CaptureFocusReferenceCommand}"
                                Style="{StaticResource MutedActionButtonStyle}" Background="#1E3A8A"
                                ToolTip="초점이 맞은 상태에서 눌러 현재 이미지의 선명도를 기준으로 저장합니다. 이후 측정은 이 기준 대비 비율로 초점 이탈을 판정합니다.">
                            <TextBlock Foreground="White" FontSize="12" FontWeight="Bold">
                                <Run Text="초점 기준 저장"/>
                                <Run Text="{Binding ReferenceSharpness, StringFormat=' ({0:F0})', Mode=OneWay}"
                                     Foreground="#93C5FD"/>
                            </TextBlock>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ── 동작 버튼 ────────────────────────────────────────────── -->
                <Border Background="#111827" CornerRadius="12" Padding="16"
                        BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <Button Height="46" Margin="0,0,0,8" Click="NozzleSelect_Click"
                                Style="{StaticResource MutedActionButtonStyle}" Background="#1E293B">
                            <TextBlock Text="Nozzle Select" Foreground="White" FontSize="13" FontWeight="Bold"/>
                        </Button>
                        <!-- Spit DW — 선택 노즐을 Frequency 로 연속 토출(토글). 측정의 전제 조건. -->
                        <Button Height="46" Margin="0,0,0,8" Command="{Binding ToggleSpitCommand}"
                                ToolTip="Nozzle Select 로 지정한 노즐을 Frequency 로 연속 토출합니다. Duration 이 설정돼 있으면 그 시간 뒤 자동 정지합니다.">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MutedActionButtonStyle}">
                                    <Setter Property="Background" Value="#7C2D12"/>
                                    <Style.Triggers>
                                        <!-- 토출 중에는 눈에 띄게 — 헤드가 잉크를 뿜고 있는 상태다. -->
                                        <DataTrigger Binding="{Binding IsSpitting}" Value="True">
                                            <Setter Property="Background" Value="#EA580C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="{Binding SpitLabel}" Foreground="White" FontSize="13" FontWeight="Bold"/>
                        </Button>
                        <Button Height="46" Margin="0,0,0,8" Command="{Binding AbortCommand}"
                                Style="{StaticResource MutedActionButtonStyle}" Background="#3B4A63"
                                ToolTip="진행 중인 측정·라이브·토출을 모두 중단합니다. 소프트웨어 중단이며 비상정지가 아닙니다.">
                            <TextBlock Text="Abort" Foreground="White" FontSize="13" FontWeight="Bold"/>
                        </Button>
                        <Button Height="46" Margin="0,0,0,8" Command="{Binding MeasureVelocityCommand}"
                                Style="{StaticResource MutedActionButtonStyle}" Background="#1D4ED8">
                            <TextBlock Text="Measure Velocity" Foreground="White" FontSize="13" FontWeight="Bold"/>
                        </Button>
                        <Button Height="46" Command="{Binding TimeIntervalMeasureCommand}"
                                Style="{StaticResource MutedActionButtonStyle}" Background="#166534">
                            <TextBlock Text="Time Interval Measure" Foreground="White" FontSize="13" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ══ 우측: 측정 그래프 3개 (노즐별 Velocity / Drop Position / Volume) ══ -->
        <Grid Grid.Column="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Velocity — 시리즈가 하나뿐이라 범례는 숨긴다(Y축 이름이 이미 무슨 값인지 말해줌).
                 예전 Drop 1~5 다중 시리즈 시절의 잔재였다. -->
            <Border Grid.Row="0" Background="#111827" CornerRadius="12" Padding="8"
                    BorderBrush="#334155" BorderThickness="1">
                <lvc:CartesianChart Series="{Binding VelocitySeries}"
                                    XAxes="{Binding VelocityXAxes}"
                                    YAxes="{Binding VelocityYAxes}"
                                    LegendPosition="Hidden"
                                    Background="Transparent"/>
            </Border>

            <!-- Drop Position -->
            <Border Grid.Row="2" Background="#111827" CornerRadius="12" Padding="8"
                    BorderBrush="#334155" BorderThickness="1">
                <lvc:CartesianChart Series="{Binding PositionSeries}"
                                    XAxes="{Binding PositionXAxes}"
                                    YAxes="{Binding PositionYAxes}"
                                    LegendPosition="Hidden"
                                    Background="Transparent"/>
            </Border>

            <!-- Volume (pL) -->
            <Border Grid.Row="4" Background="#111827" CornerRadius="12" Padding="8"
                    BorderBrush="#334155" BorderThickness="1">
                <lvc:CartesianChart Series="{Binding SpitRateSeries}"
                                    XAxes="{Binding SpitRateXAxes}"
                                    YAxes="{Binding SpitRateYAxes}"
                                    LegendPosition="Hidden"
                                    Background="Transparent"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
