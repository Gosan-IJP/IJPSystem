<UserControl x:Class="IJPSystem.Platform.HMI.Views.DropWatcherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cvts="clr-namespace:IJPSystem.Platform.HMI.Common.Converters"
             xmlns:vis="clr-namespace:IJPSystem.Platform.HMI.Vision"
             xmlns:cmn="clr-namespace:IJPSystem.Platform.HMI.Common"
             mc:Ignorable="d" d:DesignHeight="780" d:DesignWidth="1400"
             Background="#0B0F1A">

    <UserControl.Resources>

        <!-- 파라미터 입력 박스 (라벨 + 단위) 공통 스타일 -->
        <Style x:Key="DwFieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>
        <Style x:Key="DwTextBox" TargetType="TextBox">
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="Foreground"               Value="White"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="FontFamily"               Value="Consolas"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding"                  Value="6,0"/>
            <Setter Property="CaretBrush"               Value="White"/>
        </Style>
        <Style x:Key="DwReadonlyBox" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="#94A3B8"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="FontFamily"   Value="Consolas"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment"  Value="Center"/>
            <Setter Property="Padding"      Value="6,0"/>
        </Style>
        <Style x:Key="DwUnit" TargetType="TextBlock">
            <Setter Property="Foreground"        Value="#64748B"/>
            <Setter Property="FontSize"          Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="6,0,8,0"/>
        </Style>
        <Style x:Key="DwSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="#3B82F6"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="Margin"      Value="0,0,0,12"/>
        </Style>

        <!-- ── 아이콘: 벡터 Path (이모지 대신) ─────────────────────────────────
             이모지는 OS/제어PC 글꼴에 따라 굵기·크기·컬러가 제각각으로 렌더된다.
             Geometry 로 그리면 어디서든 동일하고 Foreground 로 색을 맞출 수 있다. -->
        <Geometry x:Key="IcoDroplet">M 8,0 C 8,0 15,8.4 15,12 A 7,7 0 0 1 1,12 C 1,8.4 8,0 8,0 Z</Geometry>
        <Geometry x:Key="IcoFolder">M 1,3 A 1,1 0 0 1 2,2 H 6 L 8,4 H 14 A 1,1 0 0 1 15,5 V 13 A 1,1 0 0 1 14,14 H 2 A 1,1 0 0 1 1,13 Z</Geometry>
        <Geometry x:Key="IcoBulb">M 8,1 A 5,5 0 0 1 11,10 V 12 H 5 V 10 A 5,5 0 0 1 8,1 Z M 6,13.5 H 10 V 15 H 6 Z</Geometry>

        <!-- 결과 카드의 한 칸(값 + 단위 + 라벨) -->
        <Style x:Key="DwMetricValue" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="FontSize"    Value="17"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="FontFamily"  Value="Consolas"/>
            <Style.Triggers>
                <!-- 측정 전/실패면 "-" 이 흰색으로 또렷하게 보여 값처럼 읽힌다 → 죽은 색으로 -->
                <DataTrigger Binding="{Binding HasResult}" Value="False">
                    <Setter Property="Foreground" Value="#334155"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DwMetricUnit" TargetType="TextBlock">
            <Setter Property="Foreground"        Value="#64748B"/>
            <Setter Property="FontSize"          Value="10"/>
            <Setter Property="Margin"            Value="3,0,0,2"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
        <Style x:Key="DwMetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="#64748B"/>
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="Margin"      Value="0,2,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <!-- 이미지 폭이 곧 영상 크기다(세로는 비율 때문에 남는다) → 좌측 컬럼에 폭을 몰아준다.
             차트(마지막 컬럼)는 세로로 쌓인 형태라 폭에 덜 민감하다. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ 좌측: 카메라 이미지 패널 ════════════════════════════════════ -->
        <Border Grid.Column="0" Background="#111827" CornerRadius="12"
                BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <!-- 이미지 행이 Auto 인 이유: ImageScaleRuler 가 주어진 폭에서 이미지가 실제로
                     차지하는 높이만 요구하므로(MeasureOverride), 가로로 넓은 DW 이미지 아래에
                     빈 검은 공간이 남지 않는다. 남는 세로는 결과 카드 행(*)이 가져간다. -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- 헤더 -->
                    <RowDefinition Height="Auto"/>   <!-- 툴바 -->
                    <RowDefinition Height="Auto"/>   <!-- 이미지 -->
                    <RowDefinition Height="*"/>      <!-- 결과 카드 -->
                    <RowDefinition Height="Auto"/>   <!-- 상태바 -->
                </Grid.RowDefinitions>

                <!-- 헤더 -->
                <Border Grid.Row="0" Background="#1E293B" CornerRadius="12,12,0,0" Padding="16,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IcoDroplet}" Fill="#38BDF8" Width="14" Height="15"
                              Stretch="Uniform" Margin="0,0,9,0" VerticalAlignment="Center"/>
                        <TextBlock Text="DROP WATCHER  —  CAM_DW" Foreground="White"
                                   FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        <Border Margin="12,0,0,0" CornerRadius="6" Padding="8,3">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#450A0A"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CamStatus.IsConnected}" Value="True">
                                            <Setter Property="Background" Value="#14532D"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="11" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text"       Value="● DISCONNECTED"/>
                                        <Setter Property="Foreground" Value="#EF4444"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CamStatus.IsConnected}" Value="True">
                                                <Setter Property="Text"       Value="● CONNECTED"/>
                                                <Setter Property="Foreground" Value="#22C55E"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <!-- 드라이버 모드 칩 — 가상 드라이버인데 초록 CONNECTED 만 보여 실장으로 오해하는 것을 막는다. -->
                        <Border Margin="6,0,0,0" CornerRadius="6" Padding="7,3"
                                Background="#0B1220" BorderBrush="#334155" BorderThickness="1">
                            <TextBlock Text="{Binding DriverModeText}" Foreground="#64748B"
                                       FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 툴바.
                     확대/포인터/이동/선 4개 버튼은 Command 가 없는 장식이라 눌러도 아무 일이 없었다
                     (고장으로 오해할 소지) → 제거. 확대·이동이 필요하면 Visual Monitor 의 툴 로직을
                     가져와 실제로 연결할 것. 여기 남은 것은 전부 실동작하는 버튼이다. -->
                <Border Grid.Row="1" Background="#0F172A" Padding="8,5" BorderBrush="#1F2937" BorderThickness="0,0,0,1">
                    <Grid>
                    <StackPanel Orientation="Horizontal">
                        <!-- Live View 토글 -->
                        <Button Width="72" Height="26" Command="{Binding ToggleLiveViewCommand}"
                                ToolTip="Live View 토글 (연속 캡쳐)">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MutedActionButtonStyle}">
                                    <Setter Property="Background" Value="#0E7490"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLiveView}" Value="True">
                                            <Setter Property="Background" Value="#B91C1C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="{Binding LiveViewLabel}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                        </Button>

                        <!-- 스트로브 조명 수동 토글 — 커미셔닝용 (발광 여부를 라이브 배경 밝기로 확인) -->
                        <Button Width="72" Height="26" Margin="8,0,0,0" Command="{Binding ToggleStrobeCommand}"
                                ToolTip="스트로브 조명 ON/OFF (StrobeConfig 의 EnableRegister 설정 시 실동작)">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MutedActionButtonStyle}">
                                    <Setter Property="Background" Value="#1E293B"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStrobeOn}" Value="True">
                                            <Setter Property="Background" Value="#B45309"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource IcoBulb}" Fill="White" Width="11" Height="13"
                                      Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StrobeLabel}" FontSize="11" FontWeight="Bold"
                                           Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 이미지 열기 버튼 (우측 정렬) — Glass/NJI 화면과 동일한 모양.
                         Live 중에는 연속 캡쳐가 화면을 덮어써서 의미가 없으므로 비활성(커맨드 CanExecute). -->
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Command="{Binding OpenImageCommand}"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" ToolTip="저장된 이미지 파일 열기">
                        <Border CornerRadius="6" Padding="10,5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#334155"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver,
                                            RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                            <Setter Property="Background" Value="#475569"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEnabled,
                                            RelativeSource={RelativeSource AncestorType=Button}}" Value="False">
                                            <Setter Property="Background" Value="#1E293B"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IcoFolder}" Fill="#94A3B8" Width="14" Height="13"
                                      Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="이미지 열기" Foreground="#94A3B8"
                                           FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Button>
                    </Grid>
                </Border>

                <!-- 이미지 영역 — 높이는 이미지가 실제로 차지하는 만큼(Auto). 이미지가 없으면 0. -->
                <Border Grid.Row="2" Background="#0D1117" Margin="2,0"
                        Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <!-- 캡처 이미지 + µm 눈금자 — 한 요소가 같은 사각형으로 그려 항상 정렬된다.
                             이미지는 좌상단 고정(가운데 정렬 안 함) → 이미지가 바뀌어도 원점(0,0)이 안 움직인다. -->
                        <!-- 노즐 가이드라인 — 분홍 측정창은 항상, 초록 결과는 측정했을 때만.
                             값은 이미지 픽셀이라 µm/px 교정 상태와 무관하게 같은 자리에 선다. -->
                        <vis:ImageScaleRuler Source="{Binding CurrentFrame}"
                                             MicronsPerPixel="{Binding MicronsPerPixel}"
                                             MicronsPerPixelY="{Binding MicronsPerPixelY}"
                                             NozzlePitchPx="{Binding GuidePitchPx}"
                                             NozzleOriginXPx="{Binding GuideOriginPx}"
                                             NozzleWindowWidthPx="{Binding GuideWindowPx}"
                                             BandTopPx="{Binding GuideTopPx}"
                                             BandBottomPx="{Binding GuideBottomPx}"
                                             Marks="{Binding MeasureMarks}"
                                             IsHitTestVisible="False"/>

                        <!-- 처리 중 오버레이 -->
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="#CC1C1A00" CornerRadius="10" Padding="24,12"
                                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IcoDroplet}" Fill="#FCD34D" Width="13" Height="14"
                                      Stretch="Uniform" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                <TextBlock Text="측정 중..." Foreground="#FCD34D"
                                           FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 이미지 아래 남는 세로 공간 — 빈 검은 칸으로 두지 않고 결과 지표를 채운다.
                     이미지가 없을 때는 이 자리 전체가 플레이스홀더가 된다. -->
                <Border Grid.Row="3" Background="#0D1117" Margin="2,0">
                    <Grid>
                        <!-- 플레이스홀더 (이미지 없을 때) -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding HasNoImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Path Data="{StaticResource IcoDroplet}" Fill="#3B82F6" Opacity="0.15"
                                  Width="46" Height="50" Stretch="Uniform" HorizontalAlignment="Center"/>
                            <TextBlock Text="DROP WATCHER" Foreground="#1E3A5F"
                                       FontSize="13" FontWeight="Bold" FontFamily="Consolas"
                                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock Text="MEASURE VELOCITY 또는 TIME INTERVAL MEASURE 를 누르세요"
                                       Foreground="#1E293B" FontSize="11"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- 결과 지표 카드 — 측정 전에는 "-" 로 자리를 지킨다(빈 칸 방지). -->
                        <UniformGrid Columns="5" VerticalAlignment="Center" Margin="14,10"
                                     Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ResultNozzles}" Style="{StaticResource DwMetricValue}"/>
                                    <TextBlock Text="개" Style="{StaticResource DwMetricUnit}"/>
                                </StackPanel>
                                <TextBlock Text="검출 노즐" Style="{StaticResource DwMetricLabel}"/>
                            </StackPanel>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ResultDiameter}" Style="{StaticResource DwMetricValue}"/>
                                    <TextBlock Text="µm" Style="{StaticResource DwMetricUnit}"/>
                                </StackPanel>
                                <TextBlock Text="평균 직경" Style="{StaticResource DwMetricLabel}"/>
                            </StackPanel>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ResultVolume}" Style="{StaticResource DwMetricValue}"/>
                                    <TextBlock Text="pL" Style="{StaticResource DwMetricUnit}"/>
                                </StackPanel>
                                <TextBlock Text="평균 부피" Style="{StaticResource DwMetricLabel}"/>
                            </StackPanel>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ResultVelocity}" Style="{StaticResource DwMetricValue}"/>
                                    <TextBlock Text="m/s" Style="{StaticResource DwMetricUnit}"/>
                                </StackPanel>
                                <TextBlock Text="평균 속도" Style="{StaticResource DwMetricLabel}"/>
                            </StackPanel>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ResultSpread}" Style="{StaticResource DwMetricValue}"/>
                                    <TextBlock Text="m/s" Style="{StaticResource DwMetricUnit}"/>
                                </StackPanel>
                                <TextBlock Text="속도 편차" Style="{StaticResource DwMetricLabel}"/>
                            </StackPanel>
                        </UniformGrid>
                    </Grid>
                </Border>

                <!-- 하단 상태바: 위(분석 결과) / 아래(오버레이 범례).
                     결과 문자열이 길어(노즐/직경/부피/속도/편차) 범례와 한 줄에 두면 잘리므로
                     행을 나눠 결과가 항상 전체 폭을 쓰게 한다. -->
                <Border Grid.Row="4" Background="#1E293B" CornerRadius="0,0,12,12" Padding="16,7">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" VerticalAlignment="Center"
                                   FontSize="11" FontFamily="Consolas"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   ToolTip="{Binding LastResultText}">
                            <Run Text="LAST : " Foreground="#475569"/>
                            <Run Text="{Binding CaptureTimeText, Mode=OneWay}" Foreground="#94A3B8" FontWeight="Bold"/>
                            <Run Text="  ▶  " Foreground="#475569"/>
                            <!-- "측정 전"·실패 문구까지 노란 강조로 두면 아무 일도 없는 상태가 경고처럼 보인다.
                                 실제 측정 결과가 있을 때만 강조색을 쓴다. -->
                            <Run Text="{Binding LastResultText, Mode=OneWay}" FontWeight="Bold">
                                <Run.Style>
                                    <Style TargetType="Run">
                                        <Setter Property="Foreground" Value="#64748B"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasResult}" Value="True">
                                                <Setter Property="Foreground" Value="#FCD34D"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Run.Style>
                            </Run>
                        </TextBlock>

                        <!-- 오버레이 범례 — 오버레이가 그려진 뒤에만 의미가 있으므로 결과가 있을 때만 표시.
                             원색 텍스트 대신 작은 점 + 회색 라벨로 낮춘다. -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0"
                                    Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Ellipse Width="6" Height="6" Fill="#22C55E" VerticalAlignment="Center"/>
                            <TextBlock Text="Velocity" Foreground="#64748B" FontSize="10" Margin="5,0,14,0"/>
                            <Ellipse Width="6" Height="6" Fill="#22D3EE" VerticalAlignment="Center"/>
                            <TextBlock Text="Measure Area" Foreground="#64748B" FontSize="10" Margin="5,0,14,0"/>
                            <Ellipse Width="6" Height="6" Fill="#E879F9" VerticalAlignment="Center"/>
                            <TextBlock Text="Column" Foreground="#64748B" FontSize="10" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ══ 중앙: 파라미터 / 제어 패널 ═══════════════════════════════════ -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ModernScrollBarStyle}"/>
            </ScrollViewer.Resources>

            <StackPanel>

                <!-- ── Drop Watcher Parameter ───────────────────────────────── -->
                <Border Background="#111827" CornerRadius="12" Padding="16" Margin="0,0,0,10"
                        BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="DROP WATCHER PARAMETER" Style="{StaticResource DwSectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Frequency -->
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Frequency" Style="{StaticResource DwFieldLabel}"/>
                                <Border Background="#0F172A" CornerRadius="6" Height="32" BorderBrush="#334155" BorderThickness="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="Hz" Style="{StaticResource DwUnit}"/>
                                        <TextBox Text="{Binding FrequencyHz, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DwTextBox}"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>

                            <!-- Delay Time -->
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Delay Time" Style="{StaticResource DwFieldLabel}"/>
                                <Border Background="#0F172A" CornerRadius="6" Height="32" BorderBrush="#334155" BorderThickness="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="us" Style="{StaticResource DwUnit}"/>
                                        <TextBox Text="{Binding DelayTimeUs, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DwTextBox}"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>

                            <!-- Duration -->
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="Duration" Style="{StaticResource DwFieldLabel}"/>
                                <Border Background="#0F172A" CornerRadius="6" Height="32" BorderBrush="#334155" BorderThickness="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="Sec" Style="{StaticResource DwUnit}"/>
                                        <TextBox Text="{Binding DurationSec, StringFormat={}{0:F0}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DwTextBox}"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>

                            <!-- 적용된 Delay (읽기 전용) -->
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="Applied Delay" Style="{StaticResource DwFieldLabel}"/>
                                <Border Background="#0B1220" CornerRadius="6" Height="32" BorderBrush="#1F2937" BorderThickness="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="us" Style="{StaticResource DwUnit}"/>
                                        <TextBlock Text="{Binding AppliedDelayUs, StringFormat={}{0:F1}}" Style="{StaticResource DwReadonlyBox}"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Delay Set (Delay 1 / Delay 2) ────────────────────────── -->
                <Border Background="#111827" CornerRadius="12" Padding="16" Margin="0,0,0,10"
                        BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="DELAY SET" Style="{StaticResource DwSectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Delay 1 -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Delay 1" Style="{StaticResource DwFieldLabel}"/>
                                <Border Background="#0B1220" CornerRadius="6" Height="32" BorderBrush="#1F2937" BorderThickness="1" Margin="0,0,0,8">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="us" Style="{StaticResource DwUnit}"/>
                                        <TextBlock Text="{Binding Delay1Us, StringFormat={}{0:F1}}" Style="{StaticResource DwReadonlyBox}"/>
                                    </DockPanel>
                                </Border>
                                <Button Height="40" Command="{Binding SetDelay1Command}"
                                        Style="{StaticResource MutedActionButtonStyle}" Background="#1E3A8A">
                                    <TextBlock Text="Set Delay Time" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                </Button>
                            </StackPanel>

                            <!-- Delay 2 -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Delay 2" Style="{StaticResource DwFieldLabel}"/>
                                <Border Background="#0B1220" CornerRadius="6" Height="32" BorderBrush="#1F2937" BorderThickness="1" Margin="0,0,0,8">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="us" Style="{StaticResource DwUnit}"/>
                                        <TextBlock Text="{Binding Delay2Us, StringFormat={}{0:F1}}" Style="{StaticResource DwReadonlyBox}"/>
                                    </DockPanel>
                                </Border>
                                <Button Height="40" Command="{Binding SetDelay2Command}"
                                        Style="{StaticResource MutedActionButtonStyle}" Background="#1E3A8A">
                                    <TextBlock Text="Set Delay Time" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Measure Parameter ────────────────────────────────────── -->
                <Border Background="#111827" CornerRadius="12" Padding="16" Margin="0,0,0,10"
                        BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="MEASURE PARAMETER" Style="{StaticResource DwSectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Measure Start Position -->
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Measure Start Position" Style="{StaticResource DwFieldLabel}"/>
                                <Border Background="#0F172A" CornerRadius="6" Height="32" BorderBrush="#334155" BorderThickness="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="um" Style="{StaticResource DwUnit}"/>
                                        <TextBox Text="{Binding MeasureStartUm, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DwTextBox}"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>

                            <!-- Measure END Position -->
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Measure END Position" Style="{StaticResource DwFieldLabel}"/>
                                <Border Background="#0F172A" CornerRadius="6" Height="32" BorderBrush="#334155" BorderThickness="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="um" Style="{StaticResource DwUnit}"/>
                                        <TextBox Text="{Binding MeasureEndUm, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DwTextBox}"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>

                            <!-- Time interval -->
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="Time interval" Style="{StaticResource DwFieldLabel}"/>
                                <Border Background="#0F172A" CornerRadius="6" Height="32" BorderBrush="#334155" BorderThickness="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="us" Style="{StaticResource DwUnit}"/>
                                        <TextBox Text="{Binding TimeIntervalUs, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DwTextBox}"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>

                            <!-- Measure Area X -->
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="Measure Area X" Style="{StaticResource DwFieldLabel}"/>
                                <Border Background="#0F172A" CornerRadius="6" Height="32" BorderBrush="#334155" BorderThickness="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="um" Style="{StaticResource DwUnit}"/>
                                        <TextBox Text="{Binding MeasureAreaXUm, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DwTextBox}"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Calibration (µm/px, 노즐면 Y) ─────────────────────────────
                     부피/직경/속도/낙하위치의 절대값이 µm/px 에 비례하므로 실장에서 반드시 교정한다.
                     교정법: 실제 노즐 피치(µm)를 입력 → [µm/px 교정]이 검출 액적 평균 픽셀 피치로 산출.
                     [교정값 저장]으로 DropWatcherConfig.json 에 남겨 다음 실행에도 유지. -->
                <Border Background="#111827" CornerRadius="12" Padding="16" Margin="0,0,0,10"
                        BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="CALIBRATION" Style="{StaticResource DwSectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 노즐 피치(입력) -->
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Nozzle Pitch (실측 입력)" Style="{StaticResource DwFieldLabel}"/>
                                <Border Background="#0F172A" CornerRadius="6" Height="32" BorderBrush="#334155" BorderThickness="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="um" Style="{StaticResource DwUnit}"/>
                                        <TextBox Text="{Binding NozzlePitchUm, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DwTextBox}"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>

                            <!-- µm/px (교정 결과 / 직접 입력) -->
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Scale (µm/px)" Style="{StaticResource DwFieldLabel}"/>
                                <Border Background="#0F172A" CornerRadius="6" Height="32" BorderBrush="#334155" BorderThickness="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="µm/px" Style="{StaticResource DwUnit}"/>
                                        <TextBox Text="{Binding MicronsPerPixel, StringFormat={}{0:F3}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DwTextBox}"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>

                            <!-- 노즐면 Y(입력) -->
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="Nozzle Face Y" Style="{StaticResource DwFieldLabel}"/>
                                <Border Background="#0F172A" CornerRadius="6" Height="32" BorderBrush="#334155" BorderThickness="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="px" Style="{StaticResource DwUnit}"/>
                                        <TextBox Text="{Binding NozzleYPixel, StringFormat={}{0:F0}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DwTextBox}"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- ── 가이드 격자 (픽셀) ──────────────────────────────────
                             분홍 가이드라인의 자리. µm 가 아니라 픽셀로 잡는 이유는, µm 로 두면
                             피치와 µm/px 가 <b>둘 다</b> 맞아야 라인이 제자리에 서기 때문이다
                             (실장 2026-08-06: 371px 로 잡혀 실제 113px 와 3배 어긋남).
                             0 이면 마지막 측정에서 실측한 격자를 쓴다. -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="가이드 간격" Style="{StaticResource DwFieldLabel}"/>
                                <Border Background="#0F172A" CornerRadius="6" Height="32" BorderBrush="#334155" BorderThickness="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="px" Style="{StaticResource DwUnit}"/>
                                        <TextBox Text="{Binding NozzlePitchPx, StringFormat={}{0:F1}, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource DwTextBox}"
                                                 ToolTip="측정창 간격[px]. 0 이면 마지막 측정에서 실측한 간격을 씁니다."/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="1번 창 X" Style="{StaticResource DwFieldLabel}"/>
                                <Border Background="#0F172A" CornerRadius="6" Height="32" BorderBrush="#334155" BorderThickness="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="px" Style="{StaticResource DwUnit}"/>
                                        <TextBox Text="{Binding NozzleOriginXPx, StringFormat={}{0:F1}, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource DwTextBox}"
                                                 ToolTip="맨 왼쪽 측정창의 중심 X[px]."/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- ── ROI 미세 이동 ──────────────────────────────────────
                             라이브로 토출을 보면서 액적이 창 한가운데 오도록 맞추는 자리.
                             값을 계산해 입력하는 대신 화면을 보며 바로 옮길 수 있어야 쓸모가 있다. -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="72"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="ROI 이동" Style="{StaticResource DwFieldLabel}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <StackPanel.Resources>
                                    <Style x:Key="NudgeBtn" TargetType="Button" BasedOn="{StaticResource MutedActionButtonStyle}">
                                        <Setter Property="Width"      Value="34"/>
                                        <Setter Property="Height"     Value="32"/>
                                        <Setter Property="Margin"     Value="0,0,4,0"/>
                                        <Setter Property="Background" Value="#1E293B"/>
                                    </Style>
                                </StackPanel.Resources>
                                <Button Style="{StaticResource NudgeBtn}" Command="{Binding NudgeGuideCommand}"
                                        CommandParameter="L" ToolTip="ROI 를 왼쪽으로">
                                    <TextBlock Text="←" Foreground="#EC4099" FontSize="15" FontWeight="Bold"/>
                                </Button>
                                <Button Style="{StaticResource NudgeBtn}" Command="{Binding NudgeGuideCommand}"
                                        CommandParameter="R" ToolTip="ROI 를 오른쪽으로">
                                    <TextBlock Text="→" Foreground="#EC4099" FontSize="15" FontWeight="Bold"/>
                                </Button>
                                <Button Style="{StaticResource NudgeBtn}" Command="{Binding NudgeGuideCommand}"
                                        CommandParameter="U" Margin="10,0,4,0" ToolTip="측정 구간을 위로">
                                    <TextBlock Text="↑" Foreground="#EC4099" FontSize="15" FontWeight="Bold"/>
                                </Button>
                                <Button Style="{StaticResource NudgeBtn}" Command="{Binding NudgeGuideCommand}"
                                        CommandParameter="D" ToolTip="측정 구간을 아래로">
                                    <TextBlock Text="↓" Foreground="#EC4099" FontSize="15" FontWeight="Bold"/>
                                </Button>
                            </StackPanel>

                            <Border Grid.Column="2" Background="#0F172A" CornerRadius="6" Height="32"
                                    BorderBrush="#334155" BorderThickness="1">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="px" Style="{StaticResource DwUnit}"/>
                                    <TextBox Text="{Binding GuideStepPx, StringFormat={}{0:F0}, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource DwTextBox}" ToolTip="한 번에 옮길 픽셀 수"/>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- 지금 화면에 서 있는 ROI 요약 — 설정값과 실측 간격이 크게 다르면
                             피치나 스케일이 틀렸다는 뜻이라, 자동 맞춤을 누를지 여기서 판단한다. -->
                        <TextBlock Text="{Binding GuideSummary}" Foreground="#64748B" FontSize="10"
                                   FontFamily="Consolas" TextWrapping="Wrap" Margin="0,8,0,0"/>

                        <Button Height="40" Margin="0,8,0,0" Command="{Binding AutoFitGridCommand}"
                                Style="{StaticResource MutedActionButtonStyle}" Background="#1E3A8A"
                                ToolTip="지금 화면의 액적에서 간격과 시작 위치를 읽어 가이드라인을 그 자리에 맞춥니다. 유지하려면 [교정값 저장]을 누르세요.">
                            <TextBlock Text="격자 자동 맞춤" Foreground="White" FontSize="12" FontWeight="Bold"/>
                        </Button>

                        <!-- 교정 / 저장 버튼 -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Height="40" Command="{Binding CalibrateScaleCommand}"
                                    Style="{StaticResource MutedActionButtonStyle}" Background="#1E3A8A"
                                    ToolTip="현재 화면 이미지의 검출 액적 평균 피치로 µm/px 를 자동 산출">
                                <TextBlock Text="µm/px 교정" Foreground="White" FontSize="12" FontWeight="Bold"/>
                            </Button>
                            <Button Grid.Column="2" Height="40" Command="{Binding SaveCalibrationCommand}"
                                    Style="{StaticResource MutedActionButtonStyle}" Background="#334155"
                                    ToolTip="현재 캘리브레이션을 DropWatcherConfig.json 에 저장">
                                <TextBlock Text="교정값 저장" Foreground="White" FontSize="12" FontWeight="Bold"/>
                            </Button>
                        </Grid>

                        <!-- 초점 기준 — 이후 측정의 초점 이탈 판정 기준이 된다. -->
                        <Button Height="40" Margin="0,8,0,0" Command="{Binding CaptureFocusReferenceCommand}"
                                Style="{StaticResource MutedActionButtonStyle}" Background="#1E3A8A"
                                ToolTip="초점이 맞은 상태에서 눌러 현재 이미지의 선명도를 기준으로 저장합니다. 이후 측정은 이 기준 대비 비율로 초점 이탈을 판정합니다.">
                            <TextBlock Foreground="White" FontSize="12" FontWeight="Bold">
                                <Run Text="초점 기준 저장"/>
                                <Run Text="{Binding ReferenceSharpness, StringFormat=' ({0:F0})', Mode=OneWay}"
                                     Foreground="#93C5FD"/>
                            </TextBlock>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ── 트리거 상태 ──────────────────────────────────────────────
                     Spit 버튼 바로 위에 둔다 — 누르고 나서 눈이 가는 자리다.
                     램프 하나로 "트리거 OK/NG" 만 띄우면 NG 일 때 어디가 끊겼는지 모르므로
                     구간을 갈라 보여준다(체인 / 조명 / 프레임). 숫자를 같이 띄우는 것도 중요한데,
                     램프만 있으면 "느리게 도는 중"과 "정상"이 똑같은 초록불이 된다. -->
                <Border Background="#111827" CornerRadius="12" Padding="16" Margin="0,0,0,10"
                        BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="TRIGGER" Style="{StaticResource DwSectionTitle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="62"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                            </Grid.RowDefinitions>

                            <!-- 체인 — DAQmx 가 설정을 받아들여 카운터가 돌기 시작했는가 -->
                            <Ellipse Grid.Row="0" Grid.Column="0" Width="9" Height="9" Margin="0,0,8,0"
                                     VerticalAlignment="Center"
                                     Fill="{Binding ChainLamp, Converter={StaticResource TriggerLampToBrushConverter}}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="체인"
                                       Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding ChainText}"
                                       Foreground="#E2E8F0" FontSize="11" FontFamily="Consolas"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                            <!-- 조명 — 명령이 아니라 iCore 레지스터 리드백이다 -->
                            <Ellipse Grid.Row="1" Grid.Column="0" Width="9" Height="9" Margin="0,0,8,0"
                                     VerticalAlignment="Center"
                                     Fill="{Binding LightLamp, Converter={StaticResource TriggerLampToBrushConverter}}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="조명"
                                       Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"
                                       ToolTip="iCore 컨트롤러에서 직접 읽은 운전 모드입니다. 켜라고 명령했는지가 아니라 실제로 켜져 있는지를 보여줍니다."/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding LightText}"
                                       Foreground="#E2E8F0" FontSize="11" FontFamily="Consolas"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                            <!-- 프레임 — 체인 전체가 카메라까지 도달했다는 유일한 증거 -->
                            <Ellipse Grid.Row="2" Grid.Column="0" Width="9" Height="9" Margin="0,0,8,0"
                                     VerticalAlignment="Center"
                                     Fill="{Binding FrameLamp, Converter={StaticResource TriggerLampToBrushConverter}}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="프레임"
                                       Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"
                                       ToolTip="라이브 뷰나 측정이 돌고 있을 때만 셀 수 있습니다. 둘 다 꺼져 있으면 프레임이 안 오는 것이 정상이라 회색입니다."/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding FrameText}"
                                       Foreground="#E2E8F0" FontSize="11" FontFamily="Consolas"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>

                        <!-- 램프 조합이 가리키는 "볼 곳". 이게 없으면 램프 세 개를 보고도
                             매번 같은 추론을 다시 해야 한다. -->
                        <Border Background="#1E293B" CornerRadius="6" Padding="8,6" Margin="0,10,0,0"
                                Visibility="{Binding HasTriggerDiagnosis, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding TriggerDiagnosis}" Foreground="#FCD34D"
                                       FontSize="11" TextWrapping="Wrap"/>
                        </Border>

                        <!-- 기동 시 경고(마진·공유 펄스 폭) — 로그는 흘러가서 못 본다. -->
                        <Border Background="#1E293B" CornerRadius="6" Padding="8,6" Margin="0,6,0,0"
                                Visibility="{Binding HasTriggerWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding TriggerWarning}" Foreground="#F59E0B"
                                       FontSize="11" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ── 동작 버튼 ────────────────────────────────────────────── -->
                <Border Background="#111827" CornerRadius="12" Padding="16"
                        BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <Button Height="46" Margin="0,0,0,8" Click="NozzleSelect_Click"
                                Style="{StaticResource MutedActionButtonStyle}" Background="#1E293B">
                            <TextBlock Text="Nozzle Select" Foreground="White" FontSize="13" FontWeight="Bold"/>
                        </Button>
                        <!-- Spit DW — 선택 노즐을 Frequency 로 연속 토출(토글). 측정의 전제 조건. -->
                        <Button Height="46" Margin="0,0,0,8" Command="{Binding ToggleSpitCommand}"
                                ToolTip="Nozzle Select 로 지정한 노즐을 Frequency 로 연속 토출합니다. Duration 이 설정돼 있으면 그 시간 뒤 자동 정지합니다.">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MutedActionButtonStyle}">
                                    <Setter Property="Background" Value="#7C2D12"/>
                                    <Style.Triggers>
                                        <!-- 토출 중에는 눈에 띄게 — 헤드가 잉크를 뿜고 있는 상태다. -->
                                        <DataTrigger Binding="{Binding IsSpitting}" Value="True">
                                            <Setter Property="Background" Value="#EA580C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="{Binding SpitLabel}" Foreground="White" FontSize="13" FontWeight="Bold"/>
                        </Button>
                        <Button Height="46" Margin="0,0,0,8" Command="{Binding AbortCommand}"
                                Style="{StaticResource MutedActionButtonStyle}" Background="#3B4A63"
                                ToolTip="진행 중인 측정·라이브·토출을 모두 중단합니다. 소프트웨어 중단이며 비상정지가 아닙니다.">
                            <TextBlock Text="Abort" Foreground="White" FontSize="13" FontWeight="Bold"/>
                        </Button>
                        <Button Height="46" Margin="0,0,0,8" Command="{Binding MeasureVelocityCommand}"
                                Style="{StaticResource MutedActionButtonStyle}" Background="#1D4ED8">
                            <TextBlock Text="Measure Velocity" Foreground="White" FontSize="13" FontWeight="Bold"/>
                        </Button>
                        <Button Height="46" Command="{Binding TimeIntervalMeasureCommand}"
                                Style="{StaticResource MutedActionButtonStyle}" Background="#166534">
                            <TextBlock Text="Time Interval Measure" Foreground="White" FontSize="13" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ══ 우측: 측정 그래프 3개 (노즐별 Velocity / Drop Position / Volume) ══ -->
        <Grid Grid.Column="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 시리즈가 하나뿐이라 범례는 숨기고, 대신 각 차트 위에 색상 점 + 제목 헤더를 단다.
                 (LiveCharts 축 이름만으로는 무슨 그래프인지 안 보인다는 실장 피드백 반영) -->

            <!-- Velocity -->
            <Border Grid.Row="0" Background="#111827" CornerRadius="12" Padding="8"
                    BorderBrush="#334155" BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,4">
                        <Ellipse Width="9" Height="9" Fill="#32CD32" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding VelocityChartTitle}" Foreground="#CBD5E1"
                                   FontSize="12" FontWeight="Bold" Margin="6,0,0,0"/>
                    </StackPanel>
                    <cmn:CategoryLineChart Values="{Binding VelocityValues}"
                                           Labels="{Binding ChartLabels}"
                                           LineBrush="#32CD32"
                                           YAxisTitle="Velocity (m/s)" XAxisTitle="Nozzle #"/>
                </DockPanel>
            </Border>

            <!-- Drop Position (단일프레임: 낙하 위치 / 2점 측정: Δt 낙하거리 — 제목이 바뀐다) -->
            <Border Grid.Row="2" Background="#111827" CornerRadius="12" Padding="8"
                    BorderBrush="#334155" BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,4">
                        <Ellipse Width="9" Height="9" Fill="#1E90FF" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PositionChartTitle}" Foreground="#CBD5E1"
                                   FontSize="12" FontWeight="Bold" Margin="6,0,0,0"/>
                    </StackPanel>
                    <cmn:CategoryLineChart Values="{Binding PositionValues}"
                                           Labels="{Binding ChartLabels}"
                                           LineBrush="#1E90FF"
                                           YAxisTitle="{Binding PositionYAxisTitle}" XAxisTitle="Nozzle #"/>
                </DockPanel>
            </Border>

            <!-- Volume (pL) -->
            <Border Grid.Row="4" Background="#111827" CornerRadius="12" Padding="8"
                    BorderBrush="#334155" BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,4">
                        <Ellipse Width="9" Height="9" Fill="#FFA500" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding VolumeChartTitle}" Foreground="#CBD5E1"
                                   FontSize="12" FontWeight="Bold" Margin="6,0,0,0"/>
                    </StackPanel>
                    <cmn:CategoryLineChart Values="{Binding VolumeValues}"
                                           Labels="{Binding ChartLabels}"
                                           LineBrush="#FFA500"
                                           YAxisTitle="Volume (pL)" XAxisTitle="Nozzle #"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
