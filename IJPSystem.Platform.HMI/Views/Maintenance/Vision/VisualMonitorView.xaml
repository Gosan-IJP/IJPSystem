<UserControl x:Class="IJPSystem.Platform.HMI.Views.VisualMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="780" d:DesignWidth="1200"
             Background="#0B0F1A">

    <UserControl.Resources>
        <Style x:Key="VmToolButton" TargetType="Button" BasedOn="{StaticResource MutedActionButtonStyle}">
            <Setter Property="Height"     Value="28"/>
            <Setter Property="Padding"    Value="10,0"/>
            <Setter Property="Margin"     Value="0,0,6,0"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize"   Value="12"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ 툴바 ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#111827" CornerRadius="10" Padding="12,8" Margin="0,0,0,10"
                BorderBrush="#334155" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="💠  VISUAL MONITOR" Foreground="#3B82F6" FontWeight="Bold" FontSize="13"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>

                <TextBlock Text="SOURCE" Foreground="#94A3B8" FontSize="11" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Width="180" Height="28" VerticalContentAlignment="Center"
                          ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"/>

                <Border Width="1" Background="#334155" Margin="14,2"/>

                <!-- 뷰 툴 -->
                <Button Style="{StaticResource VmToolButton}" Command="{Binding SetToolCommand}" CommandParameter="Zoom"   ToolTip="확대 (클릭/휠)">
                    <TextBlock Text="🔍 Zoom" Foreground="White"/></Button>
                <Button Style="{StaticResource VmToolButton}" Command="{Binding SetToolCommand}" CommandParameter="Select" ToolTip="십자선 이동">
                    <TextBlock Text="➤ Select" Foreground="White"/></Button>
                <Button Style="{StaticResource VmToolButton}" Command="{Binding SetToolCommand}" CommandParameter="Pan"    ToolTip="화면 이동">
                    <TextBlock Text="✋ Pan" Foreground="White"/></Button>

                <Border Width="1" Background="#334155" Margin="14,2"/>

                <Button Style="{StaticResource VmToolButton}" Command="{Binding ToggleCrossLineCommand}" ToolTip="크로스라인 표시/숨김">
                    <TextBlock Text="✛ Cross" Foreground="White"/></Button>
                <Button Style="{StaticResource VmToolButton}" Command="{Binding CenterCrossCommand}" ToolTip="크로스라인 중앙 정렬">
                    <TextBlock Text="⊹ Center" Foreground="White"/></Button>

                <Border Width="1" Background="#334155" Margin="14,2"/>

                <TextBlock Text="Zoom" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding Zoom, StringFormat={}{0:P0}}" Foreground="White" FontSize="12" FontWeight="Bold"
                           FontFamily="Consolas" VerticalAlignment="Center" MinWidth="44"/>
            </StackPanel>
        </Border>

        <!-- ══ 뷰 영역 ════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="#111827" CornerRadius="10" BorderBrush="#334155" BorderThickness="1"
                ClipToBounds="True">
            <ScrollViewer x:Name="Scroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="ViewHost" Background="#0D1117" MinWidth="200" MinHeight="200"
                      MouseDown="Host_Down" MouseMove="Host_Move" MouseUp="Host_Up" MouseWheel="Host_Wheel">
                    <!-- 프레임 이미지(줌 = LayoutTransform) -->
                    <Image Source="{Binding Frame}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.LayoutTransform>
                            <ScaleTransform x:Name="ZoomT" ScaleX="1" ScaleY="1"/>
                        </Image.LayoutTransform>
                    </Image>

                    <!-- 크로스라인 오버레이(줌 무관, SW 그림) -->
                    <Canvas x:Name="CrossOverlay" IsHitTestVisible="False" SizeChanged="Host_SizeChanged">
                        <Line x:Name="CrossV" Stroke="#FF3B30" StrokeThickness="1"/>
                        <Line x:Name="CrossH" Stroke="#FF3B30" StrokeThickness="1"/>
                    </Canvas>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
