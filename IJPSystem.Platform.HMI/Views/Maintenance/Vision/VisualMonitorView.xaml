<UserControl x:Class="IJPSystem.Platform.HMI.Views.VisualMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="780" d:DesignWidth="1200"
             Background="#0B0F1A">

    <UserControl.Resources>
        <Style x:Key="VmToolButton" TargetType="Button" BasedOn="{StaticResource MutedActionButtonStyle}">
            <Setter Property="Height"     Value="28"/>
            <Setter Property="Padding"    Value="10,0"/>
            <Setter Property="Margin"     Value="0,0,6,0"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize"   Value="12"/>
        </Style>
    </UserControl.Resources>

    <!-- ShowToolbar=False 로 두면 내장 툴바를 숨기고 뷰 영역만 제공한다.
         (패턴인쇄 화면처럼 화면 고유 툴바를 이미 갖고 있는 곳에 끼워넣기 위함 — 로직은 여기 하나만 유지) -->
    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Margin" Value="12"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ShowToolbar, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                        <Setter Property="Margin" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ 툴바 ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#111827" CornerRadius="10" Padding="12,8" Margin="0,0,0,10"
                BorderBrush="#334155" BorderThickness="1"
                Visibility="{Binding ShowToolbar, RelativeSource={RelativeSource AncestorType=UserControl},
                                     Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="💠  VISUAL MONITOR" Foreground="#3B82F6" FontWeight="Bold" FontSize="13"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>

                <TextBlock Text="SOURCE" Foreground="#94A3B8" FontSize="11" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Width="180" Height="28" VerticalContentAlignment="Center"
                          ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"/>

                <Border Width="1" Background="#334155" Margin="14,2"/>

                <!-- 뷰 툴 -->
                <Button Style="{StaticResource VmToolButton}" Command="{Binding SetToolCommand}" CommandParameter="Zoom"   ToolTip="확대 (클릭/휠)">
                    <TextBlock Text="🔍 Zoom" Foreground="White"/></Button>
                <Button Style="{StaticResource VmToolButton}" Command="{Binding SetToolCommand}" CommandParameter="Select" ToolTip="십자선 이동">
                    <TextBlock Text="➤ Select" Foreground="White"/></Button>
                <Button Style="{StaticResource VmToolButton}" Command="{Binding SetToolCommand}" CommandParameter="Pan"    ToolTip="화면 이동">
                    <TextBlock Text="✋ Pan" Foreground="White"/></Button>
                <Button Style="{StaticResource VmToolButton}" Command="{Binding FitCommand}" ToolTip="화면 맞춤 (이미지 전체 보기)">
                    <TextBlock Text="⤢ Fit" Foreground="White"/></Button>

                <Border Width="1" Background="#334155" Margin="14,2"/>

                <Button Style="{StaticResource VmToolButton}" Command="{Binding ToggleCrossLineCommand}" ToolTip="크로스라인 표시/숨김">
                    <TextBlock Text="✛ Cross" Foreground="White"/></Button>
                <Button Style="{StaticResource VmToolButton}" Command="{Binding CenterCrossCommand}" ToolTip="크로스라인 중앙 정렬">
                    <TextBlock Text="⊹ Center" Foreground="White"/></Button>

                <Border Width="1" Background="#334155" Margin="14,2"/>

                <TextBlock Text="Zoom" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding Zoom, StringFormat={}{0:P0}}" Foreground="White" FontSize="12" FontWeight="Bold"
                           FontFamily="Consolas" VerticalAlignment="Center" MinWidth="44"/>
            </StackPanel>
        </Border>

        <!-- ══ 뷰 영역 ════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="#111827" CornerRadius="10" BorderBrush="#334155" BorderThickness="1"
                ClipToBounds="True">
            <!-- ScrollViewer 없이 패널에 이미지를 맞춘다.
                 · Stretch=Uniform → 비율 유지 + 전체가 보이도록 맞춤. 넓은 패널에서는 좌우 여백(레터박스)이
                   생기지만 화면 밖으로 잘리는 픽셀이 없다. 액적/노즐이 프레임 가장자리에 있을 수 있어
                   크롭(UniformToFill)은 측정 대상 자체를 가릴 수 있으므로 쓰지 않는다.
                   GlassView·NJIView 도 동일하게 Uniform — 비전 화면 전체가 같은 규칙을 따른다.
                 · 확대/이동은 RenderTransform(Scale+Translate) 으로만 처리 → 레이아웃에 영향 없음 -->
            <Grid x:Name="ViewHost" Background="#0D1117" ClipToBounds="True"
                  MouseDown="Host_Down" MouseMove="Host_Move" MouseUp="Host_Up" MouseWheel="Host_Wheel"
                  SizeChanged="Host_SizeChanged">
                <Image x:Name="Img" Source="{Binding Frame}" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ZoomT" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="PanT" X="0" Y="0"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>

                <!-- 크로스라인 오버레이(줌 무관, SW 그림) -->
                <Canvas x:Name="CrossOverlay" IsHitTestVisible="False">
                    <Line x:Name="CrossV" Stroke="#FF3B30" StrokeThickness="1"/>
                    <Line x:Name="CrossH" Stroke="#FF3B30" StrokeThickness="1"/>
                </Canvas>
            </Grid>
        </Border>
    </Grid>
</UserControl>
