<UserControl x:Class="IJPSystem.Platform.HMI.Views.GlassView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cvts="clr-namespace:IJPSystem.Platform.HMI.Common.Converters"
             xmlns:vis="clr-namespace:IJPSystem.Platform.HMI.Vision"
             mc:Ignorable="d" d:DesignHeight="780" d:DesignWidth="1200"
             Background="#0B0F1A">

    <UserControl.Resources>
        <!-- 조그 D-패드 버튼 (패턴인쇄 JogBtn 과 동일 룩: 파란 테두리 사각) -->
        <Style x:Key="GlassJogBtn" TargetType="Button">
            <Setter Property="Width"           Value="50"/>
            <Setter Property="Height"          Value="42"/>
            <Setter Property="Margin"          Value="3"/>
            <Setter Property="Background"      Value="#1E293B"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="16"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#334155"/></Trigger>
                            <Trigger Property="IsEnabled"   Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 헤더 툴 버튼 (크로스라인 등) — 패턴인쇄 화면의 툴 버튼과 같은 크기·색 -->
        <Style x:Key="GlassToolBtn" TargetType="Button" BasedOn="{StaticResource MutedActionButtonStyle}">
            <Setter Property="Height"     Value="28"/>
            <Setter Property="Padding"    Value="10,0"/>
            <Setter Property="Margin"     Value="0,0,6,0"/>
            <Setter Property="MinWidth"   Value="72"/>
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Cursor"     Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ 좌측: 카메라 이미지 패널 ════════════════════════════════════ -->
        <Border Grid.Column="0" Background="#111827" CornerRadius="12"
                BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 헤더 -->
                <Border Grid.Row="0" Background="#1E293B" CornerRadius="12,12,0,0" Padding="16,10">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔭" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <!-- ID 를 박아두면 config 와 어긋났을 때 화면이 거짓말을 한다 →
                                 실제로 붙잡은 카메라의 ID 를 그대로 보여준다(CAM_GV / 옛 CAM_02). -->
                            <TextBlock Foreground="White" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"
                                       Text="{Binding CamStatus.CameraId, StringFormat=GLASS VIEW  —  {0}, FallbackValue=GLASS VIEW}"/>
                            <Border Margin="12,0,0,0" CornerRadius="6" Padding="8,3">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#450A0A"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CamStatus.IsConnected}" Value="True">
                                                <Setter Property="Background" Value="#14532D"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="11" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text"       Value="● DISCONNECTED"/>
                                            <Setter Property="Foreground" Value="#EF4444"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CamStatus.IsConnected}" Value="True">
                                                    <Setter Property="Text"       Value="● CONNECTED"/>
                                                    <Setter Property="Foreground" Value="#22C55E"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <!-- LIVE 뱃지 -->
                            <Border Margin="12,0,0,0" CornerRadius="6" Padding="8,3"
                                    Visibility="{Binding IsLiveMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#7F1D1D"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLiveMode}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="1.0" To="0.3" Duration="0:0:0.6"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="#EF4444"
                                             Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="LIVE" Foreground="#FCA5A5"
                                               FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 우측 툴 — 자주 쓰는 것을 전부 위로 올렸다(2026-08-21).
                             조명·캡쳐·Live 가 오른쪽 열에 흩어져 있어 눈이 화면을 왕복했다.
                             오른쪽 열은 정렬(패턴) 작업에 내준다. -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">

                            <!-- 조명 — 켜짐/꺼짐이 색으로 보이는 토글 하나. 버튼 두 개를
                                 나눠 두면 지금 켜져 있는지 화면에서 알 수 없다. -->
                            <Button Margin="0,0,10,0" Width="92" Height="34"
                                    Command="{Binding ToggleLightCommand}"
                                    ToolTip="글라스뷰 조명 켜기/끄기">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MutedActionButtonStyle}">
                                        <Setter Property="Background" Value="#1E293B"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLightOn}" Value="True">
                                                <Setter Property="Background" Value="#A16207"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💡" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="조명" Foreground="White" FontSize="12"
                                               FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Margin="0,0,8,0" Width="76" Height="34"
                                    Command="{Binding CaptureCommand}" Content="캡쳐"
                                    Style="{StaticResource MutedActionButtonStyle}"
                                    Background="#1E3A5F" Foreground="White"
                                    FontSize="12" FontWeight="Bold"
                                    ToolTip="한 장 캡쳐"/>

                            <!-- 라이브는 상태가 곧 동작이라 토글 하나로 둔다 -->
                            <Button Margin="0,0,12,0" Width="76" Height="34"
                                    Command="{Binding ToggleLiveCommand}"
                                    Foreground="White" FontSize="12" FontWeight="Bold">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MutedActionButtonStyle}">
                                        <Setter Property="Background" Value="#1E293B"/>
                                        <Setter Property="Content"    Value="Live"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLiveMode}" Value="True">
                                                <Setter Property="Background" Value="#B91C1C"/>
                                                <Setter Property="Content"    Value="Live 정지"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- 크로스라인 표시/숨김 — 켜져 있으면 색으로 상태를 알 수 있게 한다
                                 (패턴인쇄 화면의 Toggle Cross line 과 같은 규약). -->
                            <Button Command="{Binding ToggleCrossLineCommand}"
                                    Content="✛ Cross" ToolTip="크로스라인 표시/숨김 (드래그로 이동)">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GlassToolBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CrossLineVisible}" Value="True">
                                                <Setter Property="Background" Value="#B91C1C"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Style="{StaticResource GlassToolBtn}" Margin="0,0,12,0"
                                    Command="{Binding CenterCrossCommand}"
                                    IsEnabled="{Binding CrossLineVisible}"
                                    Content="⊹ Center" ToolTip="크로스라인 중앙 정렬"/>

                            <!-- 이미지 열기 버튼 -->
                            <Button VerticalAlignment="Center"
                                    Command="{Binding OpenImageCommand}"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" ToolTip="저장된 이미지 파일 열기">
                                <Border CornerRadius="6" Padding="10,5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#334155"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver,
                                                    RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                    <Setter Property="Background" Value="#475569"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📂" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="이미지 열기" Foreground="#94A3B8"
                                                   FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 이미지 영역 -->
                <Border Grid.Row="1" Background="#0D1117" Margin="2,0">
                    <Grid>

                        <!-- ① 플레이스홀더 (이미지 없을 때) -->
                        <Grid Visibility="{Binding HasNoImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Line X1="0" Y1="0.5" X2="1" Y2="0.5" Stretch="Fill"
                                  Stroke="#161D2A" StrokeThickness="1"/>
                            <Line X1="0.5" Y1="0" X2="0.5" Y2="1" Stretch="Fill"
                                  Stroke="#161D2A" StrokeThickness="1"/>
                            <Border Width="260" Height="200"
                                    BorderBrush="#1E3A5F" BorderThickness="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect Color="#3B82F6" BlurRadius="8" Opacity="0.3" ShadowDepth="0"/>
                                </Border.Effect>
                            </Border>
                            <Canvas Width="260" Height="200"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Line Canvas.Left="0"   Canvas.Top="0"   X1="0"  Y1="0"  X2="0"  Y2="22" Stroke="#3B82F6" StrokeThickness="2"/>
                                <Line Canvas.Left="0"   Canvas.Top="0"   X1="0"  Y1="0"  X2="22" Y2="0"  Stroke="#3B82F6" StrokeThickness="2"/>
                                <Line Canvas.Left="238" Canvas.Top="0"   X1="0"  Y1="0"  X2="22" Y2="0"  Stroke="#3B82F6" StrokeThickness="2"/>
                                <Line Canvas.Left="260" Canvas.Top="0"   X1="0"  Y1="0"  X2="0"  Y2="22" Stroke="#3B82F6" StrokeThickness="2"/>
                                <Line Canvas.Left="0"   Canvas.Top="178" X1="0"  Y1="0"  X2="0"  Y2="22" Stroke="#3B82F6" StrokeThickness="2"/>
                                <Line Canvas.Left="0"   Canvas.Top="200" X1="0"  Y1="0"  X2="22" Y2="0"  Stroke="#3B82F6" StrokeThickness="2"/>
                                <Line Canvas.Left="238" Canvas.Top="200" X1="0"  Y1="0"  X2="22" Y2="0"  Stroke="#3B82F6" StrokeThickness="2"/>
                                <Line Canvas.Left="260" Canvas.Top="178" X1="0"  Y1="0"  X2="0"  Y2="22" Stroke="#3B82F6" StrokeThickness="2"/>
                            </Canvas>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🔭" FontSize="52" HorizontalAlignment="Center" Opacity="0.15"/>
                                <TextBlock Text="VIRTUAL MODE" Foreground="#1E3A5F"
                                           FontSize="13" FontWeight="Bold" FontFamily="Consolas"
                                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                <TextBlock Text="라이브 또는 캡쳐 버튼을 누르세요" Foreground="#1E293B"
                                           FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- ② 캡처 이미지 (이미지 있을 때) -->
                        <!-- ScalingMode 는 LowQuality(=쌍선형, GPU) 여야 한다. HighQuality(Fant)는 CPU
                             소프트웨어 경로라, 프레임이 바뀔 때가 아니라 매 렌더 패스(60Hz)마다 1280×1024
                             를 다시 리샘플링한다 → 렌더 스레드가 밀려 창 전체가 깜빡이고 화면이 찢어진다
                             (실장 확인 2026-08-05). 어차피 축소 표시라 화질 차이는 눈에 띄지 않는다. -->
                        <Image Source="{Binding CurrentFrame}"
                               Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality"
                               Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <!-- ③ 크로스라인 — 라이브·정지·이미지 없음 어느 상태에서도 같은 자리에 선다.
                             글라스 모서리를 이 선에 맞춰 조그하는 용도라, 프레임이 바뀌었다고
                             기준선이 움직이면 안 된다. 드래그로 이동, ⊹ Center 로 중앙 복귀.
                             Source 를 주는 이유: 위치를 패널이 아니라 <b>이미지</b> 기준으로 잡아
                             레터박스가 생겨도 좌표가 어긋나지 않고, 픽셀 좌표를 읽어줄 수 있다.
                             숨김 상태에서는 마우스도 받지 않는다. -->
                        <vis:CrossLineOverlay ShowCross="{Binding CrossLineVisible}"
                                              Source="{Binding CurrentFrame}"
                                              XRatio="{Binding CrossXRatio, Mode=TwoWay}"
                                              YRatio="{Binding CrossYRatio, Mode=TwoWay}"/>

                        <!-- ④ 패턴 ROI / 찾은 자리 — 크로스라인 위에 얹는다.
                             등록 중일 때만 마우스를 받으므로 평소에는 크로스라인 드래그가 그대로 된다. -->
                        <vis:PatternRoiOverlay Source="{Binding CurrentFrame}"
                                               IsEditing="{Binding Align.IsRegistering}"
                                               RoiX="{Binding Align.RoiX, Mode=TwoWay}"
                                               RoiY="{Binding Align.RoiY, Mode=TwoWay}"
                                               RoiW="{Binding Align.RoiW, Mode=TwoWay}"
                                               RoiH="{Binding Align.RoiH, Mode=TwoWay}"
                                               ShowResult="{Binding Align.HasResult}"
                                               ResultFailed="{Binding Align.ResultFailed}"
                                               ResultX="{Binding Align.ResultX}"
                                               ResultY="{Binding Align.ResultY}"
                                               ResultW="{Binding Align.ResultW}"
                                               ResultH="{Binding Align.ResultH}"
                                               ResultLabel="{Binding Align.ResultLabel}"/>

                        <!-- ⑤ 이미지 경로 표시 (좌상단 오버레이) -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                Background="#CC0D1117" CornerRadius="0,0,6,0" Padding="8,4"
                                Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding CurrentImagePath}" Foreground="#64748B"
                                       FontSize="9" FontFamily="Consolas"
                                       TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                        </Border>

                        <!-- ⑤ 라이브 FPS 오버레이 (우상단, 라이브 중일 때) -->
                        <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                                Background="#CC0D1117" CornerRadius="0,0,0,6" Padding="8,4"
                                Visibility="{Binding IsLiveMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding FpsText}" Foreground="#FCA5A5"
                                           FontSize="9" FontFamily="Consolas" FontWeight="Bold"/>
                                <TextBlock Text="  #" Foreground="#475569" FontSize="9" FontFamily="Consolas"/>
                                <TextBlock Text="{Binding CaptureCount}" Foreground="#94A3B8"
                                           FontSize="9" FontFamily="Consolas"/>
                            </StackPanel>
                        </Border>

                    </Grid>
                </Border>

                <!-- 하단 정보 바 -->
                <Border Grid.Row="2" Background="#1E293B" CornerRadius="0,0,12,12" Padding="16,9">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="LAST CAPTURE : " Foreground="#475569"
                                   FontSize="11" FontFamily="Consolas"/>
                        <TextBlock Text="{Binding CaptureTimeText}" Foreground="#94A3B8"
                                   FontSize="11" FontFamily="Consolas" FontWeight="Bold"/>
                        <TextBlock Text="        CAPTURE COUNT : " Foreground="#475569"
                                   FontSize="11" FontFamily="Consolas"/>
                        <TextBlock Text="{Binding CaptureCount}" Foreground="#94A3B8"
                                   FontSize="11" FontFamily="Consolas" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!-- ══ 우측: 제어 패널 ═══════════════════════════════════════════ -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ModernScrollBarStyle}"/>
            </ScrollViewer.Resources>

            <StackPanel>

                <!-- ── 등록 이미지 (정렬 패턴) ───────────────────────────────
                     [패턴등록시작] → 이미지 위에서 마크를 감싸도록 드래그 → [패턴저장].
                     저장은 Config\Patterns\ 에 png + json 두 벌로 남는다 —
                     현장에서 "무엇을 등록해 뒀는지" 그림판으로 열어 볼 수 있어야 한다. -->
                <Border Background="#111827" CornerRadius="12" Padding="16" Margin="0,0,0,10"
                        BorderBrush="#334155" BorderThickness="1"
                        DataContext="{Binding Align}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="등록 이미지" Foreground="#3B82F6"
                                       FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ReferenceText}" Foreground="#475569"
                                       FontSize="10" FontFamily="Consolas"
                                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 미리보기 -->
                            <Border Grid.Column="0" Background="#0B0F1A" CornerRadius="8"
                                    BorderBrush="#334155" BorderThickness="1" Height="150">
                                <Grid>
                                    <Image Source="{Binding Preview}" Stretch="Uniform" Margin="6"
                                           RenderOptions.BitmapScalingMode="LowQuality"/>
                                    <TextBlock Text="등록된 패턴 없음" Foreground="#334155"
                                               FontSize="11" HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Preview}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="2" Width="128" VerticalAlignment="Center">
                                <Button Command="{Binding StartRegisterCommand}"
                                        Content="{Binding RegisterButtonText}"
                                        Height="52" Margin="0,0,0,10"
                                        Style="{StaticResource MutedActionButtonStyle}"
                                        Background="#0E7490" Foreground="White"
                                        FontSize="13" FontWeight="Bold"/>
                                <Button Command="{Binding SaveCommand}" Content="패턴저장"
                                        Height="52"
                                        Style="{StaticResource MutedActionButtonStyle}"
                                        Background="#0E7490" Foreground="White"
                                        FontSize="13" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>

                        <!-- 등록 중 안내 · 고른 영역 크기 -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding HintText}" Foreground="#64748B"
                                       FontSize="10" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="1" Text="{Binding RoiSizeText}" Foreground="#94A3B8"
                                       FontSize="10" FontFamily="Consolas" VerticalAlignment="Top"
                                       Margin="8,0,0,0"/>
                        </Grid>

                        <!-- 이름 · 저장된 패턴 고르기 -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="이름" Foreground="#64748B"
                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Border Grid.Column="1" Background="#0B0F1A" CornerRadius="6"
                                    BorderBrush="#334155" BorderThickness="1">
                                <TextBox Text="{Binding PatternName, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" Foreground="#E2E8F0" CaretBrush="#E2E8F0"
                                         BorderThickness="0" Padding="8,5"
                                         FontSize="11" FontFamily="Consolas"/>
                            </Border>
                            <ComboBox Grid.Column="3" ItemsSource="{Binding Patterns}"
                                      SelectedItem="{Binding SelectedPattern, Mode=TwoWay}"
                                      Style="{StaticResource ModernComboBoxStyle}" Height="28" Width="170"
                                      ToolTip="저장된 패턴 불러오기"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── 패턴 찾기 · 자동 동작 ─────────────────────────────────
                     찾기 카드는 반 칸만 쓴다. 값이 몇 줄뿐이라 폭을 다 쓸 이유가 없고,
                     남은 반 칸에 자동 동작을 둔다. -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 패턴 찾기 — 여기서 하는 것은 "얼마나 벗어났나"까지다. 스테이지는 움직이지 않는다:
                         매칭이 엉뚱한 곳을 잡았을 때 그대로 모터가 나가면 안 되고,
                         픽셀을 mm 로 바꿀 교정값(µm/px)이 아직 없다. -->
                    <Border Grid.Column="0"
                            Background="#111827" CornerRadius="12" Padding="16"
                            BorderBrush="#334155" BorderThickness="1"
                            DataContext="{Binding Align}">
                        <StackPanel>
                            <TextBlock Text="PATTERN FIND" Foreground="#3B82F6"
                                       FontSize="11" FontWeight="Bold" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Command="{Binding FindCommand}" Content="패턴 찾기"
                                        Height="38"
                                        Style="{StaticResource MutedActionButtonStyle}"
                                        Background="#1E3A5F" Foreground="White"
                                        FontSize="12" FontWeight="Bold"/>
                                <Button Grid.Column="2" Command="{Binding ClearCommand}" Content="지우기"
                                        Width="64" Height="38"
                                        Style="{StaticResource MutedActionButtonStyle}"
                                        Background="#1E293B" Foreground="#94A3B8"
                                        FontSize="12" FontWeight="Bold"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>   <!-- 0 점수 -->
                                    <RowDefinition Height="Auto"/>   <!-- 1 위치 -->
                                    <RowDefinition Height="Auto"/>   <!-- 2 벗어난 양 -->
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="점수" Foreground="#64748B"
                                           FontSize="11" Margin="0,0,8,6"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ScoreText}"
                                           FontSize="12" FontFamily="Consolas" Margin="0,0,0,6">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#E2E8F0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ResultFailed}" Value="True">
                                                    <Setter Property="Foreground" Value="#F87171"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="위치" Foreground="#64748B"
                                           FontSize="11" Margin="0,0,8,6"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PosText}"
                                           Foreground="#E2E8F0" FontSize="12" FontFamily="Consolas"
                                           Margin="0,0,0,6"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="벗어난 양" Foreground="#64748B"
                                           FontSize="11" Margin="0,0,8,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OffsetText}"
                                           Foreground="#60A5FA" FontSize="12" FontFamily="Consolas"
                                           FontWeight="Bold"
                                           ToolTip="등록할 때 있던 자리 기준. 교정(µm/px)이 서면 이 값이 mm 로 바뀝니다."/>
                            </Grid>

                            <!-- 합격 점수 — 보여 주기만 한다. 값의 주인은 레시피(글라스 정보 → 정렬 합격 점수)다.
                                 여기서 고치게 두면 어느 값으로 찾았는지가 레시피에 남지 않는다. -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Score" Foreground="#64748B"
                                           FontSize="11" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="#0B0F1A" CornerRadius="6"
                                        BorderBrush="#1E293B" BorderThickness="1" Width="66" Padding="8,4">
                                    <TextBlock Text="{Binding MinScore, StringFormat={}{0:F2}}"
                                               Foreground="#94A3B8" FontSize="12" FontFamily="Consolas"
                                               TextAlignment="Right"
                                               ToolTip="레시피 값입니다. 바꾸려면 레시피 화면 → 글라스 정보 → 정렬 합격 점수."/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="레시피 값" Foreground="#475569"
                                           FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>

                            <!-- 해상도가 조금 달라 오차가 섞였을 때만 나타난다. 막지는 않고 숫자로 알린다. -->
                            <TextBlock Text="{Binding SceneWarning}" Foreground="#FBBF24" FontSize="10"
                                       TextWrapping="Wrap" Margin="0,10,0,0"
                                       Visibility="{Binding HasSceneWarning, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <TextBlock Text="※ 스테이지는 움직이지 않습니다. 벗어난 양만 알려 줍니다."
                                       Foreground="#475569" FontSize="10" TextWrapping="Wrap"
                                       Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 자동 동작 — 시퀀스 화면의 GLASS ALIGN 과 같은 동작이다.
                         단계 정의(GlassAlignSequence)를 그대로 가져다 돌린다: 여기서 순서를
                         다시 쓰면 두 곳이 갈라지고, 갈라진 쪽이 실제로 도는 쪽일 때가 온다. -->
                    <Border Grid.Column="2"
                            Background="#111827" CornerRadius="12" Padding="16"
                            BorderBrush="#334155" BorderThickness="1"
                            VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="자동 동작" Foreground="#3B82F6"
                                       FontSize="11" FontWeight="Bold" Margin="0,0,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Command="{Binding AutoAlignCommand}"
                                        Content="자동 정렬" Height="38"
                                        Style="{StaticResource MutedActionButtonStyle}"
                                        Background="#1E3A5F" Foreground="White"
                                        FontSize="12" FontWeight="Bold"
                                        ToolTip="마크1 찾기 → 마크2 찾기 → T 보정 → X·Y 보정 → 검증을 한 번에 수행합니다."/>

                                <!-- 스테이지가 도는 동안 세울 자리가 있어야 한다. -->
                                <Button Grid.Column="2" Command="{Binding StopAutoAlignCommand}"
                                        Content="중지" Width="64" Height="38"
                                        Style="{StaticResource MutedActionButtonStyle}"
                                        Background="#1E293B" Foreground="#94A3B8"
                                        FontSize="12" FontWeight="Bold"/>
                            </Grid>

                            <!-- 13단계가 한참 걸린다 — 어디까지 갔는지 보이지 않으면 멈춘 줄 안다. -->
                            <TextBlock Text="{Binding AutoAlignStatus}" Foreground="#60A5FA"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>

                            <TextBlock Text="※ 마크 두 개로 T 를 맞춘 뒤 X·Y 를 맞춥니다. 레시피의 허용 오차 안에 들면 끝납니다."
                                       Foreground="#475569" FontSize="10" TextWrapping="Wrap"
                                       Margin="0,10,0,0"/>
                            <TextBlock Text="※ 실측 교정이 없으면 사양 분해능(VisionConfig)으로 돕니다 — 배율에 렌즈 공차만큼 오차가 남습니다."
                                       Foreground="#475569" FontSize="10" TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── 조그 (이미지 레이아웃: D-패드 + Continuous + Z/T + Motion State) ──
                     모터 제어 화면과 같은 축(SharedAxisList)을 조작. CanJog=false 면 버튼 자동 비활성.
                     Z 는 +방향이 아래쪽(헤드 하강): 아래 버튼 = +Z(JogForward), 위 버튼 = -Z. -->
                <Border Background="#111827" CornerRadius="12" Padding="16" Margin="0,10,0,0"
                        BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Jog Control" Foreground="#3B82F6"
                                   FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>   <!-- 조그 패드 -->
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>       <!-- Motion State -->
                            </Grid.ColumnDefinitions>

                            <!-- 조그 패드: X/Y D-패드 + (Continuous + Z/T) -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Grid VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource GlassJogBtn}" Content="↑" Tag="Y"
                                            PreviewMouseDown="JogForward_MouseDown" PreviewMouseUp="JogStop_MouseUp"
                                            IsEnabled="{Binding AxisY.CanJog, FallbackValue=False}"/>
                                    <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource GlassJogBtn}" Content="←" Tag="X"
                                            PreviewMouseDown="JogBackward_MouseDown" PreviewMouseUp="JogStop_MouseUp"
                                            IsEnabled="{Binding AxisX.CanJog, FallbackValue=False}"/>
                                    <Border Grid.Row="1" Grid.Column="1" Width="50" Height="42" Margin="3"
                                            Background="#0D1520" BorderBrush="#334155" BorderThickness="1" CornerRadius="6">
                                        <TextBlock Text="X, Y" Foreground="#94A3B8" FontSize="12" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource GlassJogBtn}" Content="→" Tag="X"
                                            PreviewMouseDown="JogForward_MouseDown" PreviewMouseUp="JogStop_MouseUp"
                                            IsEnabled="{Binding AxisX.CanJog, FallbackValue=False}"/>
                                    <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource GlassJogBtn}" Content="↓" Tag="Y"
                                            PreviewMouseDown="JogBackward_MouseDown" PreviewMouseUp="JogStop_MouseUp"
                                            IsEnabled="{Binding AxisY.CanJog, FallbackValue=False}"/>
                                </Grid>

                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <ComboBox Width="130" Height="26" Margin="3,0,0,8" HorizontalAlignment="Left"
                                              VerticalContentAlignment="Center" SelectedIndex="{Binding JogUnitIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="Continuous"/>
                                        <ComboBoxItem Content="10µm / 0.01°"/>
                                        <ComboBoxItem Content="100µm / 0.1°"/>
                                        <ComboBoxItem Content="1000µm / 1°"/>
                                    </ComboBox>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Z: 아래 버튼 = +Z(하강) -->
                                        <StackPanel>
                                            <Button Style="{StaticResource GlassJogBtn}" Content="↑" Tag="Z"
                                                    PreviewMouseDown="JogBackward_MouseDown" PreviewMouseUp="JogStop_MouseUp"
                                                    IsEnabled="{Binding AxisZ.CanJog, FallbackValue=False}"/>
                                            <TextBlock Text="Z" Foreground="#F59E0B" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                            <Button Style="{StaticResource GlassJogBtn}" Content="↓" Tag="Z"
                                                    PreviewMouseDown="JogForward_MouseDown" PreviewMouseUp="JogStop_MouseUp"
                                                    IsEnabled="{Binding AxisZ.CanJog, FallbackValue=False}"/>
                                        </StackPanel>
                                        <!-- T -->
                                        <StackPanel Margin="6,0,0,0">
                                            <Button Style="{StaticResource GlassJogBtn}" Content="↻" Tag="T"
                                                    PreviewMouseDown="JogForward_MouseDown" PreviewMouseUp="JogStop_MouseUp"
                                                    IsEnabled="{Binding AxisT.CanJog, FallbackValue=False}"/>
                                            <TextBlock Text="T" Foreground="#C084FC" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                            <Button Style="{StaticResource GlassJogBtn}" Content="↺" Tag="T"
                                                    PreviewMouseDown="JogBackward_MouseDown" PreviewMouseUp="JogStop_MouseUp"
                                                    IsEnabled="{Binding AxisT.CanJog, FallbackValue=False}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- Motion State: Axis X/Y/Z/T -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="Motion State" Foreground="#3B82F6" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Axis X" Foreground="#CBD5E1" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="#0D1520" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="8,5">
                                        <TextBlock Text="{Binding AxisX.CurrentPos, StringFormat={}{0:F3} mm, FallbackValue=-- mm}"
                                                   Foreground="#E2E8F0" FontFamily="Consolas" FontSize="14" FontWeight="Bold" TextAlignment="Right"/>
                                    </Border>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Axis Y" Foreground="#CBD5E1" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="#0D1520" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="8,5">
                                        <TextBlock Text="{Binding AxisY.CurrentPos, StringFormat={}{0:F3} mm, FallbackValue=-- mm}"
                                                   Foreground="#E2E8F0" FontFamily="Consolas" FontSize="14" FontWeight="Bold" TextAlignment="Right"/>
                                    </Border>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Axis Z" Foreground="#CBD5E1" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="#0D1520" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="8,5">
                                        <TextBlock Text="{Binding AxisZ.CurrentPos, StringFormat={}{0:F3} mm, FallbackValue=-- mm}"
                                                   Foreground="#E2E8F0" FontFamily="Consolas" FontSize="14" FontWeight="Bold" TextAlignment="Right"/>
                                    </Border>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Axis T" Foreground="#CBD5E1" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="#0D1520" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="8,5">
                                        <TextBlock Text="{Binding AxisT.CurrentPos, StringFormat={}{0:F3} deg, FallbackValue=-- deg}"
                                                   Foreground="#E2E8F0" FontFamily="Consolas" FontSize="14" FontWeight="Bold" TextAlignment="Right"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="※ 서보 ON·알람 해제 상태에서만 동작합니다"
                                   Foreground="#475569" FontSize="10" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
