<UserControl x:Class="IJPSystem.Platform.HMI.Views.GlassView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cvts="clr-namespace:IJPSystem.Platform.HMI.Common.Converters"
             mc:Ignorable="d" d:DesignHeight="780" d:DesignWidth="1200"
             Background="#0B0F1A">

    <UserControl.Resources>
        <!-- 조그 D-패드 버튼 (패턴인쇄 JogBtn 과 동일 룩: 파란 테두리 사각) -->
        <Style x:Key="GlassJogBtn" TargetType="Button">
            <Setter Property="Width"           Value="50"/>
            <Setter Property="Height"          Value="42"/>
            <Setter Property="Margin"          Value="3"/>
            <Setter Property="Background"      Value="#1E293B"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="16"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#334155"/></Trigger>
                            <Trigger Property="IsEnabled"   Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ 좌측: 카메라 이미지 패널 ════════════════════════════════════ -->
        <Border Grid.Column="0" Background="#111827" CornerRadius="12"
                BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 헤더 -->
                <Border Grid.Row="0" Background="#1E293B" CornerRadius="12,12,0,0" Padding="16,10">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔭" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <!-- ID 를 박아두면 config 와 어긋났을 때 화면이 거짓말을 한다 →
                                 실제로 붙잡은 카메라의 ID 를 그대로 보여준다(CAM_GV / 옛 CAM_02). -->
                            <TextBlock Foreground="White" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"
                                       Text="{Binding CamStatus.CameraId, StringFormat=GLASS VIEW  —  {0}, FallbackValue=GLASS VIEW}"/>
                            <Border Margin="12,0,0,0" CornerRadius="6" Padding="8,3">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#450A0A"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CamStatus.IsConnected}" Value="True">
                                                <Setter Property="Background" Value="#14532D"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="11" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text"       Value="● DISCONNECTED"/>
                                            <Setter Property="Foreground" Value="#EF4444"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CamStatus.IsConnected}" Value="True">
                                                    <Setter Property="Text"       Value="● CONNECTED"/>
                                                    <Setter Property="Foreground" Value="#22C55E"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <!-- LIVE 뱃지 -->
                            <Border Margin="12,0,0,0" CornerRadius="6" Padding="8,3"
                                    Visibility="{Binding IsLiveMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#7F1D1D"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLiveMode}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="1.0" To="0.3" Duration="0:0:0.6"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="#EF4444"
                                             Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="LIVE" Foreground="#FCA5A5"
                                               FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 이미지 열기 버튼 (우측 정렬) -->
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{Binding OpenImageCommand}"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand" ToolTip="저장된 이미지 파일 열기">
                            <Border CornerRadius="6" Padding="10,5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#334155"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver,
                                                RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                <Setter Property="Background" Value="#475569"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📂" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="이미지 열기" Foreground="#94A3B8"
                                               FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Button>
                    </Grid>
                </Border>

                <!-- 이미지 영역 -->
                <Border Grid.Row="1" Background="#0D1117" Margin="2,0">
                    <Grid>

                        <!-- ① 플레이스홀더 (이미지 없을 때) -->
                        <Grid Visibility="{Binding HasNoImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Line X1="0" Y1="0.5" X2="1" Y2="0.5" Stretch="Fill"
                                  Stroke="#161D2A" StrokeThickness="1"/>
                            <Line X1="0.5" Y1="0" X2="0.5" Y2="1" Stretch="Fill"
                                  Stroke="#161D2A" StrokeThickness="1"/>
                            <Border Width="260" Height="200"
                                    BorderBrush="#1E3A5F" BorderThickness="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect Color="#3B82F6" BlurRadius="8" Opacity="0.3" ShadowDepth="0"/>
                                </Border.Effect>
                            </Border>
                            <Canvas Width="260" Height="200"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Line Canvas.Left="0"   Canvas.Top="0"   X1="0"  Y1="0"  X2="0"  Y2="22" Stroke="#3B82F6" StrokeThickness="2"/>
                                <Line Canvas.Left="0"   Canvas.Top="0"   X1="0"  Y1="0"  X2="22" Y2="0"  Stroke="#3B82F6" StrokeThickness="2"/>
                                <Line Canvas.Left="238" Canvas.Top="0"   X1="0"  Y1="0"  X2="22" Y2="0"  Stroke="#3B82F6" StrokeThickness="2"/>
                                <Line Canvas.Left="260" Canvas.Top="0"   X1="0"  Y1="0"  X2="0"  Y2="22" Stroke="#3B82F6" StrokeThickness="2"/>
                                <Line Canvas.Left="0"   Canvas.Top="178" X1="0"  Y1="0"  X2="0"  Y2="22" Stroke="#3B82F6" StrokeThickness="2"/>
                                <Line Canvas.Left="0"   Canvas.Top="200" X1="0"  Y1="0"  X2="22" Y2="0"  Stroke="#3B82F6" StrokeThickness="2"/>
                                <Line Canvas.Left="238" Canvas.Top="200" X1="0"  Y1="0"  X2="22" Y2="0"  Stroke="#3B82F6" StrokeThickness="2"/>
                                <Line Canvas.Left="260" Canvas.Top="178" X1="0"  Y1="0"  X2="0"  Y2="22" Stroke="#3B82F6" StrokeThickness="2"/>
                            </Canvas>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🔭" FontSize="52" HorizontalAlignment="Center" Opacity="0.15"/>
                                <TextBlock Text="VIRTUAL MODE" Foreground="#1E3A5F"
                                           FontSize="13" FontWeight="Bold" FontFamily="Consolas"
                                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                <TextBlock Text="라이브 또는 캡쳐 버튼을 누르세요" Foreground="#1E293B"
                                           FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- ② 캡처 이미지 (이미지 있을 때) -->
                        <Image Source="{Binding CurrentFrame}"
                               Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <!-- ③ 이미지 경로 표시 (좌상단 오버레이) -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                Background="#CC0D1117" CornerRadius="0,0,6,0" Padding="8,4"
                                Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding CurrentImagePath}" Foreground="#64748B"
                                       FontSize="9" FontFamily="Consolas"
                                       TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                        </Border>

                        <!-- ④ 라이브 FPS 오버레이 (우상단, 라이브 중일 때) -->
                        <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                                Background="#CC0D1117" CornerRadius="0,0,0,6" Padding="8,4"
                                Visibility="{Binding IsLiveMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding FpsText}" Foreground="#FCA5A5"
                                           FontSize="9" FontFamily="Consolas" FontWeight="Bold"/>
                                <TextBlock Text="  #" Foreground="#475569" FontSize="9" FontFamily="Consolas"/>
                                <TextBlock Text="{Binding CaptureCount}" Foreground="#94A3B8"
                                           FontSize="9" FontFamily="Consolas"/>
                            </StackPanel>
                        </Border>

                    </Grid>
                </Border>

                <!-- 하단 정보 바 -->
                <Border Grid.Row="2" Background="#1E293B" CornerRadius="0,0,12,12" Padding="16,9">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="LAST CAPTURE : " Foreground="#475569"
                                   FontSize="11" FontFamily="Consolas"/>
                        <TextBlock Text="{Binding CaptureTimeText}" Foreground="#94A3B8"
                                   FontSize="11" FontFamily="Consolas" FontWeight="Bold"/>
                        <TextBlock Text="        CAPTURE COUNT : " Foreground="#475569"
                                   FontSize="11" FontFamily="Consolas"/>
                        <TextBlock Text="{Binding CaptureCount}" Foreground="#94A3B8"
                                   FontSize="11" FontFamily="Consolas" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!-- ══ 우측: 제어 패널 ═══════════════════════════════════════════ -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ModernScrollBarStyle}"/>
            </ScrollViewer.Resources>

            <StackPanel>

                <!-- ── 조명 제어 ───────────────────────────────────────────
                     Pulse 장비에는 글라스뷰 조명 하드웨어가 없음(실장 확인 2026-07-23)
                     → 기능은 유지하되 화면에서 숨김 (삭제하지 않음 — NJI/P&ID 와 동일 패턴) -->
                <Border Background="#111827" CornerRadius="12" Padding="16" Margin="0,0,0,10"
                        BorderBrush="#334155" BorderThickness="1"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="LIGHT CONTROL" Foreground="#3B82F6"
                                   FontSize="11" FontWeight="Bold" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Height="42"
                                    Command="{Binding LightOnCommand}"
                                    Style="{StaticResource MutedActionButtonStyle}"
                                    Background="#166534">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💡" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="ON" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Height="42"
                                    Command="{Binding LightOffCommand}"
                                    Style="{StaticResource MutedActionButtonStyle}"
                                    Background="#374151">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🌑" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="OFF" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Ellipse Width="8" Height="8" Margin="0,0,7,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#374151"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CamStatus.IsLightOn}" Value="True">
                                                <Setter Property="Fill" Value="#FCD34D"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontSize="11" FontFamily="Consolas">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text"       Value="LIGHT OFF"/>
                                        <Setter Property="Foreground" Value="#475569"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CamStatus.IsLightOn}" Value="True">
                                                <Setter Property="Text"       Value="LIGHT ON"/>
                                                <Setter Property="Foreground" Value="#FCD34D"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="강도" Foreground="#64748B"
                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="255"
                                    Value="{Binding LightIntensity, Mode=TwoWay}"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding LightIntensity}"
                                       Foreground="#FCD34D" FontSize="12" FontWeight="Bold"
                                       FontFamily="Consolas" VerticalAlignment="Center"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── 카메라 파라미터 ────────────────────────────────────── -->
                <Border Background="#111827" CornerRadius="12" Padding="16" Margin="0,0,0,10"
                        BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="CAMERA PARAMS" Foreground="#3B82F6"
                                   FontSize="11" FontWeight="Bold" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#0F172A" CornerRadius="8" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="EXPOSURE" Foreground="#475569"
                                               FontSize="9" FontWeight="Bold"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding CamStatus.ExposureMs, StringFormat='{}{0:F1}'}"
                                                   Foreground="White" FontSize="20" FontWeight="Bold"
                                                   FontFamily="Consolas"/>
                                        <TextBlock Text=" ms" Foreground="#64748B" FontSize="11"
                                                   VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#0F172A" CornerRadius="8" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="GAIN" Foreground="#475569"
                                               FontSize="9" FontWeight="Bold"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding CamStatus.Gain, StringFormat='{}{0:F1}'}"
                                                   Foreground="White" FontSize="20" FontWeight="Bold"
                                                   FontFamily="Consolas"/>
                                        <TextBlock Text=" x" Foreground="#64748B" FontSize="11"
                                                   VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── 수동 제어 ─────────────────────────────────────────── -->
                <Border Background="#111827" CornerRadius="12" Padding="16" Margin="0,0,0,10"
                        BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="MANUAL CONTROL" Foreground="#3B82F6"
                                   FontSize="11" FontWeight="Bold" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 단일 캡쳐 -->
                            <Button Grid.Column="0" Height="58"
                                    Command="{Binding CaptureCommand}"
                                    Style="{StaticResource MutedActionButtonStyle}"
                                    Background="#1D4ED8">
                                <StackPanel>
                                    <TextBlock Text="📷" FontSize="18" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Btn_Capture}" Foreground="White"
                                               FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- 라이브 토글 -->
                            <Button Grid.Column="2" Height="58"
                                    Command="{Binding ToggleLiveCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MutedActionButtonStyle}">
                                        <Setter Property="Background" Value="#166534"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLiveMode}" Value="True">
                                                <Setter Property="Background" Value="#7F1D1D"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel>
                                    <TextBlock FontSize="18" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="▶"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLiveMode}" Value="True">
                                                        <Setter Property="Text" Value="■"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Foreground="White" FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center" Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="LIVE START"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLiveMode}" Value="True">
                                                        <Setter Property="Text" Value="LIVE STOP"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 처리 중 표시 -->
                        <Border Background="#1C1A00" CornerRadius="6" Padding="8,6" Margin="0,10,0,0"
                                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="⏳  처리 중..." Foreground="#FCD34D"
                                       FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ── 라이브 설정 ─────────────────────────────────────────── -->
                <Border Background="#111827" CornerRadius="12" Padding="16" Margin="0,0,0,10"
                        BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="LIVE SETTINGS" Foreground="#3B82F6"
                                   FontSize="11" FontWeight="Bold" Margin="0,0,0,12"/>

                        <!-- 캡쳐 주기 -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="주기" Foreground="#64748B"
                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Slider Grid.Column="1" Minimum="50" Maximum="2000"
                                    Value="{Binding LiveIntervalMs, Mode=TwoWay}"
                                    TickFrequency="50" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Foreground="#38BDF8" FontSize="12" FontWeight="Bold"
                                           FontFamily="Consolas" HorizontalAlignment="Right">
                                    <Run Text="{Binding LiveIntervalMs, Mode=OneWay}"/>
                                    <Run Text="ms"/>
                                </TextBlock>
                                <TextBlock Text="{Binding FpsText}" Foreground="#475569"
                                           FontSize="10" FontFamily="Consolas"
                                           HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── 캡쳐 통계 ──────────────────────────────────────────── -->
                <Border Background="#111827" CornerRadius="12" Padding="16"
                        BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="STATISTICS" Foreground="#3B82F6"
                                   FontSize="11" FontWeight="Bold" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#0F172A" CornerRadius="8" Padding="8,10">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="CAPTURE" Foreground="#475569"
                                               FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding CaptureCount}" Foreground="White"
                                               FontSize="22" FontWeight="Bold" FontFamily="Consolas"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#0F172A" CornerRadius="8" Padding="8,10">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="CAM TOTAL" Foreground="#475569"
                                               FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding CamStatus.TotalCaptureCount, FallbackValue='0'}"
                                               Foreground="#38BDF8"
                                               FontSize="22" FontWeight="Bold" FontFamily="Consolas"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── 조그 (이미지 레이아웃: D-패드 + Continuous + Z/T + Motion State) ──
                     모터 제어 화면과 같은 축(SharedAxisList)을 조작. CanJog=false 면 버튼 자동 비활성.
                     Z 는 +방향이 아래쪽(헤드 하강): 아래 버튼 = +Z(JogForward), 위 버튼 = -Z. -->
                <Border Background="#111827" CornerRadius="12" Padding="16" Margin="0,10,0,0"
                        BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Jog Control" Foreground="#3B82F6"
                                   FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>   <!-- 조그 패드 -->
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>       <!-- Motion State -->
                            </Grid.ColumnDefinitions>

                            <!-- 조그 패드: X/Y D-패드 + (Continuous + Z/T) -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Grid VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource GlassJogBtn}" Content="↑" Tag="Y"
                                            PreviewMouseDown="JogForward_MouseDown" PreviewMouseUp="JogStop_MouseUp"
                                            IsEnabled="{Binding AxisY.CanJog, FallbackValue=False}"/>
                                    <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource GlassJogBtn}" Content="←" Tag="X"
                                            PreviewMouseDown="JogBackward_MouseDown" PreviewMouseUp="JogStop_MouseUp"
                                            IsEnabled="{Binding AxisX.CanJog, FallbackValue=False}"/>
                                    <Border Grid.Row="1" Grid.Column="1" Width="50" Height="42" Margin="3"
                                            Background="#0D1520" BorderBrush="#334155" BorderThickness="1" CornerRadius="6">
                                        <TextBlock Text="X, Y" Foreground="#94A3B8" FontSize="12" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource GlassJogBtn}" Content="→" Tag="X"
                                            PreviewMouseDown="JogForward_MouseDown" PreviewMouseUp="JogStop_MouseUp"
                                            IsEnabled="{Binding AxisX.CanJog, FallbackValue=False}"/>
                                    <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource GlassJogBtn}" Content="↓" Tag="Y"
                                            PreviewMouseDown="JogBackward_MouseDown" PreviewMouseUp="JogStop_MouseUp"
                                            IsEnabled="{Binding AxisY.CanJog, FallbackValue=False}"/>
                                </Grid>

                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <ComboBox Width="112" Height="26" Margin="3,0,0,8" HorizontalAlignment="Left"
                                              VerticalContentAlignment="Center" SelectedIndex="{Binding JogUnitIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="Continuous"/>
                                        <ComboBoxItem Content="10µm"/>
                                        <ComboBoxItem Content="100µm"/>
                                    </ComboBox>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Z: 아래 버튼 = +Z(하강) -->
                                        <StackPanel>
                                            <Button Style="{StaticResource GlassJogBtn}" Content="↑" Tag="Z"
                                                    PreviewMouseDown="JogBackward_MouseDown" PreviewMouseUp="JogStop_MouseUp"
                                                    IsEnabled="{Binding AxisZ.CanJog, FallbackValue=False}"/>
                                            <TextBlock Text="Z" Foreground="#F59E0B" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                            <Button Style="{StaticResource GlassJogBtn}" Content="↓" Tag="Z"
                                                    PreviewMouseDown="JogForward_MouseDown" PreviewMouseUp="JogStop_MouseUp"
                                                    IsEnabled="{Binding AxisZ.CanJog, FallbackValue=False}"/>
                                        </StackPanel>
                                        <!-- T -->
                                        <StackPanel Margin="6,0,0,0">
                                            <Button Style="{StaticResource GlassJogBtn}" Content="↑" Tag="T"
                                                    PreviewMouseDown="JogForward_MouseDown" PreviewMouseUp="JogStop_MouseUp"
                                                    IsEnabled="{Binding AxisT.CanJog, FallbackValue=False}"/>
                                            <TextBlock Text="T" Foreground="#C084FC" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                            <Button Style="{StaticResource GlassJogBtn}" Content="↓" Tag="T"
                                                    PreviewMouseDown="JogBackward_MouseDown" PreviewMouseUp="JogStop_MouseUp"
                                                    IsEnabled="{Binding AxisT.CanJog, FallbackValue=False}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- Motion State: Axis X/Y/Z/T -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="Motion State" Foreground="#3B82F6" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Axis X" Foreground="#CBD5E1" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="#0D1520" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="8,5">
                                        <TextBlock Text="{Binding AxisX.CurrentPos, StringFormat={}{0:F3} mm, FallbackValue=-- mm}"
                                                   Foreground="#E2E8F0" FontFamily="Consolas" FontSize="14" FontWeight="Bold" TextAlignment="Right"/>
                                    </Border>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Axis Y" Foreground="#CBD5E1" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="#0D1520" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="8,5">
                                        <TextBlock Text="{Binding AxisY.CurrentPos, StringFormat={}{0:F3} mm, FallbackValue=-- mm}"
                                                   Foreground="#E2E8F0" FontFamily="Consolas" FontSize="14" FontWeight="Bold" TextAlignment="Right"/>
                                    </Border>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Axis Z" Foreground="#CBD5E1" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="#0D1520" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="8,5">
                                        <TextBlock Text="{Binding AxisZ.CurrentPos, StringFormat={}{0:F3} mm, FallbackValue=-- mm}"
                                                   Foreground="#E2E8F0" FontFamily="Consolas" FontSize="14" FontWeight="Bold" TextAlignment="Right"/>
                                    </Border>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Axis T" Foreground="#CBD5E1" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="#0D1520" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="8,5">
                                        <TextBlock Text="{Binding AxisT.CurrentPos, StringFormat={}{0:F3} mm, FallbackValue=-- mm}"
                                                   Foreground="#E2E8F0" FontFamily="Consolas" FontSize="14" FontWeight="Bold" TextAlignment="Right"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="※ 서보 ON·알람 해제 상태에서만 동작합니다"
                                   Foreground="#475569" FontSize="10" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
