<UserControl x:Class="IJPSystem.Platform.HMI.Views.MotorControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:cvts="clr-namespace:IJPSystem.Platform.HMI.Common.Converters" 
             mc:Ignorable="d" d:DesignHeight="750" d:DesignWidth="1200"
             Background="#0F172A">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1E293B" CornerRadius="6" Padding="12,5" Margin="0,0,0,10" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚙️" Foreground="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="MOTOR CONTROL CENTER" Foreground="White" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Total Axes: " Foreground="#94A3B8" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="{Binding AxisList.Count}" Foreground="#3B82F6" FontSize="12" FontWeight="ExtraBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <!-- 좌(축 리스트)는 좁히고 우(조작부)를 넓힌다 — 조그 패드에 DW 축이 붙어 폭이 더 필요하다. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="560"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1E293B" CornerRadius="10" BorderBrush="#334155" BorderThickness="1" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- AXIS SELECT & MOTION 패널 상단에 추가 -->
                    <Border Background="#0F172A" CornerRadius="6" Padding="10,6" 
                            Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CURRENT POS" Foreground="#64748B" FontSize="9"/>
                                <TextBlock Text="{Binding SelectedAxis.Status.CurrentPos, StringFormat={}{0:F3}}"
                                            Foreground="#22C55E" FontWeight="Bold" FontFamily="Consolas" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="SERVO" Foreground="#64748B" FontSize="9" HorizontalAlignment="Center"/>
                                <Ellipse Width="10" Height="10" HorizontalAlignment="Center"
                                         Fill="{Binding SelectedAxis.Status.IsServoOn, 
                                                Converter={StaticResource SignalToColorConverter}}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <TextBlock Text="IN POSITION" Foreground="#64748B" FontSize="9" HorizontalAlignment="Right"/>
                                <Ellipse Width="10" Height="10" HorizontalAlignment="Right"
                                         Fill="{Binding SelectedAxis.Status.IsInPosition, 
                                                Converter={StaticResource SignalToColorConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="0" Background="#243146" CornerRadius="10,10,0,0">
                        <Grid Margin="10,0">
                            <Grid.ColumnDefinitions>
                                <!-- 버튼 열(JOG/ACTION)은 내용이 고정 크기라 폭을 고정하고, 정보 열만 남는 폭을 나눈다.
                                     6열 균등(*)으로 두면 점 세 개뿐인 STATUS 도 ACTION 과 같은 폭을 받아
                                     버튼 열만 모자라 '리셋'이 잘렸다. 창을 좁혀도 버튼은 살아남아야 한다.
                                       JOG    = 60×2 + 여백 16 = 136 → 160
                                       ACTION = 60×3 + 여백 24 = 204 → 220 -->
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <!-- AXIS 열 삭제 — MOTOR NAME 이 "X AXIS" 라 축 이름이 두 번 나온다.
                                 JOG 은 ACTION 에서 분리했다 — 누르고 있는 조작(조그)과 한 번 누르는
                                 명령(서보/원점/리셋)은 성격이 달라, 붙여두면 손이 미끄러진다. -->
                            <TextBlock Grid.Column="0" Text="MOTOR NAME" Foreground="#94A3B8" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11"/>

                            <TextBlock Grid.Column="1"
                                       Foreground="#94A3B8" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Run Text="STATUS " FontSize="11"/>
                                <Run Text="(Servo/Orgin/InPos)" FontSize="9"/>
                            </TextBlock>
                            <TextBlock Grid.Column="2" Text="MOTOR SENSOR" Foreground="#94A3B8" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Column="3" Text="POSITION(mm,deg)" Foreground="#94A3B8" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Column="4" Text="JOG" Foreground="#94A3B8" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Column="5" Text="ACTION" Foreground="#94A3B8" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11"/>
                        </Grid>

                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding AxisList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="50">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"       Value="Transparent"/>
                                                <Setter Property="BorderBrush"      Value="#334155"/>
                                                <Setter Property="BorderThickness"  Value="0,0,0,1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status.IsMoving}" Value="True">
                                                        <Setter Property="Background" Value="#06204A"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status.IsAlarm}" Value="True">
                                                        <Setter Property="Background"      Value="#2D0A0A"/>
                                                        <Setter Property="BorderBrush"     Value="#EF4444"/>
                                                        <Setter Property="BorderThickness" Value="2,1,2,1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid Margin="10,0">
                                            <Grid.ColumnDefinitions>
                                                <!-- 헤더와 같은 구성 — 두 곳이 어긋나면 제목과 내용이 안 맞는다 -->
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="220"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Info.Name}" Foreground="#CBD5E1" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0" FontSize="12"/>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Ellipse Width="10" Height="10" Margin="4,0" Fill="{Binding Status.IsServoOn, Converter={StaticResource SignalToColorConverter}}" ToolTip="Servo On"/>
                                                <Ellipse Width="10" Height="10" Margin="4,0" Fill="{Binding Status.IsHomeDone, Converter={StaticResource SignalToColorConverter}}" ToolTip="Home Done"/>
                                                <Ellipse Width="10" Height="10" Margin="4,0" Fill="{Binding Status.IsInPosition, Converter={StaticResource SignalToColorConverter}}" ToolTip="In Position"/>
                                            </StackPanel>

                                            <!-- 리미트 표기를 CW/CCW 로 — 회전축(T)에는 상한/하한이 말이 안 되고,
                                                 드라이브/코미조아 문서도 CW(+EL) / CCW(−EL) 로 부른다. -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Width="34" Height="16" CornerRadius="4" Margin="3,0" Background="{Binding Status.UpperLimit, Converter={StaticResource SensorToBgConverter}}" ToolTip="CW 리미트(+EL) — 플러스 방향 끝">
                                                    <TextBlock Text="CW" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Width="34" Height="16" CornerRadius="4" Margin="3,0" Background="{Binding Status.LowerLimit, Converter={StaticResource SensorToBgConverter}}" ToolTip="CCW 리미트(−EL) — 마이너스 방향 끝">
                                                    <TextBlock Text="CCW" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Width="38" Height="16" CornerRadius="4" Margin="3,0" Background="{Binding Status.HomeSensor, Converter={StaticResource SensorToBgConverter}}" ToolTip="Home Sensor">
                                                    <TextBlock Text="HOME" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- 열이 균등(*)이라 그대로 두면 좌표 박스가 열 폭만큼 늘어난다 → 폭 고정 후 가운데 -->
                                            <Border Grid.Column="3" Background="#0F172A" CornerRadius="4" Height="28" Width="140"
                                                    HorizontalAlignment="Center" BorderBrush="#334155" BorderThickness="1">
                                                <TextBlock Text="{Binding Status.CurrentPos, StringFormat={}{0:F3}}"
                                               Foreground="#22C55E" FontWeight="Bold" FontFamily="Consolas" 
                                               VerticalAlignment="Center" HorizontalAlignment="Right" 
                                               Margin="8,0" FontSize="13"/>
                                            </Border>

                                            <!-- ── JOG ── 누르고 있는 동안 이동. DataContext(행 축) 기반이라 축 개수 무관.
                                                 오른쪽 조그 패드를 없앤 뒤 이 화면의 유일한 조그라 크게 뒀다
                                                 (행 높이 50 이라 Height 38 이 상한).
                                                 ACTION 과 열을 나눈 이유 — 누르고 있는 조작과 한 번 누르는 명령을
                                                 붙여두면 손이 미끄러져 원점·리셋이 잘못 눌린다. -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="◀" Width="60" Height="40" Margin="4,2" FontSize="18" FontWeight="Bold"
                                                        PreviewMouseDown="JogBackward_MouseDown" PreviewMouseUp="JogStop_MouseUp"
                                                        IsEnabled="{Binding CanJog, FallbackValue=False}"
                                                        Style="{StaticResource ModernActionButton}" Background="#334155"
                                                        ToolTip="조그 (−) — 누르는 동안 이동 (단위·속도는 오른쪽 JOG CONTROL)"/>
                                                <Button Content="▶" Width="60" Height="40" Margin="4,2" FontSize="18" FontWeight="Bold"
                                                        PreviewMouseDown="JogForward_MouseDown" PreviewMouseUp="JogStop_MouseUp"
                                                        IsEnabled="{Binding CanJog, FallbackValue=False}"
                                                        Style="{StaticResource ModernActionButton}" Background="#334155"
                                                        ToolTip="조그 (+) — 누르는 동안 이동 (단위·속도는 오른쪽 JOG CONTROL)"/>
                                            </StackPanel>

                                            <!-- ── ACTION ── 한 번 누르는 명령. 크기는 JOG(60×40)과 동일 -->
                                            <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="{DynamicResource Btn_Servo}" Command="{Binding ServoCommand}" Width="60" Height="40" Margin="4,2" FontSize="13">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource ModernActionButton}">
                                                            <Setter Property="Background" Value="#475569"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status.IsServoOn}" Value="true">
                                                                    <Setter Property="Background" Value="#22C55E"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="{DynamicResource Btn_Home}" Command="{Binding HomeCommand}" Style="{StaticResource ModernActionButton}" Background="#475569" Width="60" Height="40" Margin="4,2" FontSize="13"/>
                                                <Button Content="{DynamicResource Btn_Reset}" Command="{Binding ResetCommand}" Style="{StaticResource ModernActionButton}" Background="#EF4444" Width="60" Height="40" Margin="4,2" FontSize="13"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 스크롤뷰어 제거 — JOG CONTROL 이 남는 높이를 먹고 늘어나야 좌/우 아래끝이 맞는다.
                 (스크롤뷰어 안에서는 높이가 무한대로 측정돼 * 행이 Auto 처럼 동작한다) -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1E293B" CornerRadius="10" Padding="15,15,15,10" Margin="0,0,0,5" BorderBrush="#334155" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="MASTER CONTROL" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>

                            <Button Grid.Row="1" Grid.Column="0" Command="{Binding AllServoOnCommand}"
                                Background="#1E293B" BorderBrush="#10B981" BorderThickness="1.5"
                                Height="55" Margin="0,0,4,0" Style="{StaticResource ModernActionButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡" FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Servo ON" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Row="1" Grid.Column="1" Command="{Binding AllServoOffCommand}"
                                Background="#1E293B" BorderBrush="#64748B" BorderThickness="1.5"
                                Height="55" Margin="0,0,4,0" Style="{StaticResource ModernActionButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡" FontSize="15" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Servo OFF" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Row="1" Grid.Column="2" Command="{Binding AllStopCommand}"
                                Background="#1E293B" BorderBrush="#EF4444" BorderThickness="1.5"
                                Height="55" Style="{StaticResource ModernActionButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛑" FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="All STOP" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Foreground="#EF4444"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Background="#1E293B" CornerRadius="10" Padding="15,15,15,0" Margin="0,0,0,5" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="AXIS SELECT &amp; MOTION" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,5"/>
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Select Axis" Foreground="#94A3B8" VerticalAlignment="Center" FontSize="11"/>
                                <ComboBox Style="{StaticResource ModernComboBoxStyle}"
                                          ItemsSource="{Binding AxisList}"
                                          SelectedItem="{Binding SelectedAxis}"
                                          Height="35" FontSize="14" FontWeight="Bold" Foreground="Black">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Info.Name}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <Separator Background="#334155" Margin="1,5"/>
                            <StackPanel>
                                    <!-- 이동 조건(ABS/INC · 목표값)은 왼쪽에 쌓고, 실행 버튼은 그 오른쪽에 세로로 붙인다.
                                         조건을 훑고 바로 옆에서 실행하는 흐름이고, 아래로 내려 두면 폭이 남아 글자가 잘렸다.
                                         버튼은 상황에 따라 이동/정지가 바뀐다 — 정지는 이동 중에만 의미가 있고,
                                         멈춰 있을 때 떠 있으면 눌러도 아무 일이 없어 오해를 준다.
                                         ※ 비상정지는 위 MASTER CONTROL 의 All STOP 이 담당한다 — 이 버튼과 무관하게 항상 있다. -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,12,10">
                                            <TextBlock Text="Moving Method" Foreground="#94A3B8" VerticalAlignment="Center" FontSize="11"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <RadioButton Content="ABS"
                                                             IsChecked="{Binding SelectedAxis.IsAbsMode, Mode=TwoWay}"
                                                             GroupName="MoveMethod"
                                                             Style="{StaticResource ModernModeButtonStyle}"/>
                                                <RadioButton Content="INC"
                                                             IsChecked="{Binding SelectedAxis.IsIncMode, Mode=TwoWay}"
                                                             Margin="5,0,0,0"
                                                             GroupName="MoveMethod"
                                                             Style="{StaticResource ModernModeButtonStyle}"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Target Position" Foreground="#94A3B8" VerticalAlignment="Center" FontSize="11"/>
                                            <Border Background="#0F172A" CornerRadius="4" BorderBrush="#334155" BorderThickness="1" HorizontalAlignment="Right" Width="120" Height="28">
                                                <TextBox Text= "{Binding SelectedAxis.TargetPosition, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="Transparent" Foreground="White" BorderThickness="0"
                                                         VerticalContentAlignment="Center" HorizontalContentAlignment="Right" Padding="5"/>
                                            </Border>
                                        </Grid>

                                        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="150">
                                        <Button Height="66" Command="{Binding SelectedAxis.MoveAbsCommand}"
                                                Background="#10B981" BorderBrush="#10B981">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ModernActionButton}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedAxis.IsMoveActive}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <!-- Btn_Move/Btn_Stop 문자열에 이미 ▶/■ 기호가 들어 있다(언어 리소스).
                                                 대상 축은 바로 위 Select Axis 콤보에 있으므로 버튼에 또 적지 않는다. -->
                                            <TextBlock Text="{DynamicResource Btn_Move}" FontSize="14" FontWeight="Bold"/>
                                        </Button>

                                        <!-- 이동 중에만 나타나는 정지 -->
                                        <Button Height="66" Command="{Binding SelectedAxis.StopCommand}"
                                                Background="#F87171" BorderBrush="#EF4444"
                                                Style="{StaticResource ModernActionButton}"
                                                Visibility="{Binding SelectedAxis.IsMoveActive,
                                                             Converter={StaticResource BooleanToVisibilityConverter},
                                                             FallbackValue=Collapsed}">
                                            <!-- 남은 거리는 아래 DISTANCE TO GO 패널이 이미 보여준다. -->
                                            <TextBlock Text="{DynamicResource Btn_Stop}" FontSize="14" FontWeight="Bold"/>
                                        </Button>
                                        </Grid>
                                    </Grid>

                                    <!-- Move 진행률 / 남은거리 (이동 중에만 표시) -->
                                    <Grid Margin="0,12,0,0"
                                          Visibility="{Binding SelectedAxis.IsMoveActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                            <TextBlock Text="DISTANCE TO GO" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding SelectedAxis.DistanceToGo, StringFormat={}{0:+0.000;-0.000;0.000}}"
                                                           Foreground="#FCD34D" FontFamily="Consolas" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding SelectedAxis.PosUnit, FallbackValue=mm}" Foreground="#64748B" FontSize="10" Margin="3,0,0,0" VerticalAlignment="Bottom"/>
                                            </StackPanel>
                                        </Grid>
                                        <ProgressBar Grid.Row="1" Height="8" Minimum="0" Maximum="100"
                                                     Value="{Binding SelectedAxis.MoveProgress, Mode=OneWay}"
                                                     Background="#0F172A" Foreground="#22C55E" BorderThickness="0"/>
                                    </Grid>
                                </StackPanel>
                            <!-- 선택 축 JOG −/+ 버튼 제거(2026-08-04).
                                 아래 JOG CONTROL 이 축별 버튼을 전부 갖게 되어 중복이고,
                                 '지금 선택된 축이 뭔지' 를 확인해야 눌러볼 수 있어 오조작 여지가 있었다. -->
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Background="#1E293B" CornerRadius="10" Padding="12" BorderBrush="#334155" BorderThickness="1" MinHeight="240">
                    <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="JOG CONTROL" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
                            <!-- Jog 단위 -->
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6" HorizontalAlignment="Right">
                                <!-- 스텝은 '선택 축'이 아니라 화면이 들고 있다(JogStepFor). 한 버튼이 직선축·회전축
                                     값을 함께 뜻하고, 누른 축의 단위에 맞는 쪽이 적용된다.
                                     ※ ModernModeButtonStyle 은 Width=65 고정이라 글자가 잘린다 →
                                       Width=Auto + Content 를 TextBlock 으로 줘 여백을 만든다
                                       (템플릿 Border 가 Padding 을 쓰지 않아 Padding 만으로는 안 된다). -->
                                <TextBlock Text="UNIT" Foreground="#64748B" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <RadioButton IsChecked="{Binding IsJogContinuity, Mode=TwoWay}" GroupName="JogMode" Style="{StaticResource ModernModeButtonStyle}"
                                             Width="Auto" Height="30" ToolTip="누르고 있는 동안 연속 이동">
                                    <TextBlock Text="Cont." Margin="14,0"/>
                                </RadioButton>
                                <RadioButton IsChecked="{Binding IsStepFine, Mode=TwoWay}" GroupName="JogMode" Style="{StaticResource ModernModeButtonStyle}" Margin="4,0,0,0"
                                             Width="Auto" Height="30" ToolTip="직선축 0.01mm · 회전축(T) 0.01도씩 이동">
                                    <TextBlock Text="10µm / 0.01°" Margin="14,0"/>
                                </RadioButton>
                                <RadioButton IsChecked="{Binding IsStepCoarse, Mode=TwoWay}" GroupName="JogMode" Style="{StaticResource ModernModeButtonStyle}" Margin="4,0,0,0"
                                             Width="Auto" Height="30" ToolTip="직선축 0.1mm · 회전축(T) 0.1도씩 이동">
                                    <TextBlock Text="100µm / 0.1°" Margin="14,0"/>
                                </RadioButton>
                                <RadioButton IsChecked="{Binding IsStepExtra, Mode=TwoWay}" GroupName="JogMode" Style="{StaticResource ModernModeButtonStyle}" Margin="4,0,0,0"
                                             Width="Auto" Height="30" ToolTip="직선축 1mm · 회전축(T) 1도씩 이동">
                                    <TextBlock Text="1000µm / 1°" Margin="14,0"/>
                                </RadioButton>
                            </StackPanel>
                            <!-- 속도 배율 -->
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                <TextBlock Text="SPEED" Foreground="#64748B" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <RadioButton Content="×0.25" IsChecked="{Binding IsJogSpeedSlow,   Mode=TwoWay}" GroupName="JogSpeed" Style="{StaticResource ModernModeButtonStyle}"/>
                                <RadioButton Content="×1.0"  IsChecked="{Binding IsJogSpeedNormal, Mode=TwoWay}" GroupName="JogSpeed" Style="{StaticResource ModernModeButtonStyle}" Margin="4,0"/>
                                <RadioButton Content="×2.0"  IsChecked="{Binding IsJogSpeedFast,   Mode=TwoWay}" GroupName="JogSpeed" Style="{StaticResource ModernModeButtonStyle}"/>
                            </StackPanel>
                            <!-- ── 티칭 위치 이동 ──────────────────────────────────────
                                 예전엔 이 자리에 X/Y D-패드 + 축별 조그 열이 있었으나, 왼쪽 표의 행마다
                                 이미 축별 조그(◀ ▶)가 있어 중복이었다 → 제거하고 티칭 위치로 대체(2026-08-06).
                                 위 UNIT/SPEED 토글은 그대로 왼쪽 표의 조그에 적용된다(같은 핸들러).

                                 버튼은 PointNames.All 을 그대로 돌린다 — 포인트가 늘거나 줄면 화면이 따라오고,
                                 티칭 화면과 같은 목록을 쓰므로 둘이 어긋나지 않는다. -->
                            <TextBlock DockPanel.Dock="Top" Text="TEACHING POSITION"
                                       Style="{StaticResource SectionTitleStyle}" Margin="0,10,0,8"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding TeachPoints}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- DataContext 가 문자열(포인트 이름)이라 Command 는 화면 VM 을 거슬러 찾는다 -->
                                            <Button Height="46" Margin="3"
                                                    Style="{StaticResource ModernActionButton}" Background="#334155"
                                                    Command="{Binding DataContext.MovePointCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="티칭된 좌표로 이동 (원점복귀·레시피 적용 후 가능)">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="◎" FontSize="13" Foreground="#60A5FA"
                                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding}" FontSize="12" FontWeight="Bold"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>