<Window x:Class="IJPSystem.Platform.HMI.Views.LogWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IJPSystem.Platform.HMI.Views"
        mc:Ignorable="d"
        Title="System Log Viewer"
        Height="800" Width="1200"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── 헤더 + 필터 바 ───────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.Resources>
                <!-- 카테고리(Quick-Filter) 토글 버튼 — 활성 카테고리만 색이 들어온다 -->
                <Style x:Key="CategoryToggleButton" TargetType="Button" BasedOn="{StaticResource ModernActionButton}">
                    <Setter Property="Width"       Value="104"/>
                    <Setter Property="Height"      Value="34"/>
                    <Setter Property="Margin"      Value="0,3,6,3"/>
                    <Setter Property="FontSize"    Value="12"/>
                    <Setter Property="Background"  Value="#0F172A"/>
                    <Setter Property="BorderBrush" Value="#334155"/>
                    <Setter Property="Foreground"  Value="#94A3B8"/>
                </Style>
            </Grid.Resources>

            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#3B82F6" Width="4" Height="24" CornerRadius="2" Margin="0,0,15,0"/>
                    <TextBlock Text="SYSTEM LOG VIEWER" Foreground="White"
                               FontSize="22" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Records:" Foreground="#94A3B8"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding RecordCount}" Foreground="#3B82F6"
                               FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Background="#1E293B" CornerRadius="10" Padding="14,10"
                    BorderBrush="#334155" BorderThickness="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <TextBlock Text="FROM" Foreground="#94A3B8" FontSize="12" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker SelectedDate="{Binding FilterStartDate, Mode=TwoWay}"
                                Width="130" Height="32" FontSize="13" FontWeight="Bold"
                                Background="#0F172A" Foreground="Black"
                                BorderBrush="#475569" SelectedDateFormat="Short"
                                VerticalContentAlignment="Center"/>

                    <TextBlock Text="TO" Foreground="#94A3B8" FontSize="12" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="12,0,8,0"/>
                    <DatePicker SelectedDate="{Binding FilterEndDate, Mode=TwoWay}"
                                Width="130" Height="32" FontSize="13" FontWeight="Bold"
                                Background="#0F172A" Foreground="Black"
                                BorderBrush="#475569" SelectedDateFormat="Short"
                                VerticalContentAlignment="Center"/>

                    <TextBlock Text="LEVEL" Foreground="#94A3B8" FontSize="12" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="12,0,8,0"/>
                    <ComboBox ItemsSource="{Binding LevelOptions}"
                              SelectedItem="{Binding FilterLevel, Mode=TwoWay}"
                              Width="100" Height="32" FontSize="13" FontWeight="Bold"
                              Background="#0F172A" Foreground="Black"
                              BorderBrush="#475569" VerticalContentAlignment="Center"/>

                    <Border Background="#0F172A" BorderBrush="#475569" BorderThickness="1"
                            CornerRadius="6" Height="32" Margin="16,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" Foreground="#64748B" FontSize="13"
                                       VerticalAlignment="Center" Margin="8,0,4,0"/>
                            <TextBox Text="{Binding FilterKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" Foreground="White" FontSize="13"
                                     BorderThickness="0" VerticalContentAlignment="Center"
                                     Width="220" Padding="4,0" CaretBrush="White">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </StackPanel>
                    </Border>

                    <Button Content="SEARCH" Command="{Binding SearchCommand}"
                            Width="90" Height="32" Margin="12,0,0,0"
                            Style="{StaticResource ModernActionButton}"
                            Background="#1D4ED8" BorderBrush="#3B82F6"/>
                    <Button Content="RESET" Command="{Binding ResetFilterCommand}"
                            Width="80" Height="32" Margin="8,0,0,0"
                            Style="{StaticResource ModernActionButton}"
                            Background="#334155" BorderBrush="#475569"/>
                    <Button Content="REFRESH" Command="{Binding RefreshCommand}"
                            Width="90" Height="32" Margin="8,0,0,0"
                            Style="{StaticResource ModernActionButton}"
                            Background="#0F766E" BorderBrush="#14B8A6"/>
                </StackPanel>
            </Border>

            <!-- ── 카테고리 Quick-Filter ─────────────────────────────────────
                 로그 prefix([MOTION]/[IO]/…)를 그대로 매칭하는 필터 버튼.
                 폭이 좁아지면 WrapPanel 이 두 줄로 접는다. -->
            <Border Grid.Row="4" Background="#1E293B" CornerRadius="10" Padding="12,7"
                    BorderBrush="#334155" BorderThickness="1">
                <WrapPanel Orientation="Horizontal">

                    <Button Content="ALL"
                            Command="{Binding SetCategoryCommand}" CommandParameter="ALL"
                            ToolTip="전체 로그">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CategoryToggleButton}">
                                <Setter Property="Width" Value="72"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveCategory}" Value="ALL">
                                        <Setter Property="Background"  Value="#0F766E"/>
                                        <Setter Property="BorderBrush" Value="#14B8A6"/>
                                        <Setter Property="Foreground"  Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="LOGIN/NAV"
                            Command="{Binding SetCategoryCommand}" CommandParameter="LOGIN_NAV"
                            ToolTip="로그인/권한/화면 전환 — [AUTH] [NAV]">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CategoryToggleButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveCategory}" Value="LOGIN_NAV">
                                        <Setter Property="Background"  Value="#1D4ED8"/>
                                        <Setter Property="BorderBrush" Value="#3B82F6"/>
                                        <Setter Property="Foreground"  Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="SEQUENCE"
                            Command="{Binding SetCategoryCommand}" CommandParameter="SEQ"
                            ToolTip="시퀀스 실행 — [SEQ] [INITIALIZE] [PRINT]&#x0a;스텝 시작/완료/실패 추적">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CategoryToggleButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveCategory}" Value="SEQ">
                                        <Setter Property="Background"  Value="#7C3AED"/>
                                        <Setter Property="BorderBrush" Value="#A78BFA"/>
                                        <Setter Property="Foreground"  Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="MOTION"
                            Command="{Binding SetCategoryCommand}" CommandParameter="MOTION"
                            ToolTip="모터 — [MOTION]&#x0a;조그/티칭/포인트 이동, 도달 오차·InPos 미달">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CategoryToggleButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveCategory}" Value="MOTION">
                                        <Setter Property="Background"  Value="#B45309"/>
                                        <Setter Property="BorderBrush" Value="#F59E0B"/>
                                        <Setter Property="Foreground"  Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="IO / 유체"
                            Command="{Binding SetCategoryCommand}" CommandParameter="IO"
                            ToolTip="IO·유체 계통 — [IO] [PNID] [VALVE] [PRESSURE] [MENISCUS] [VV]&#x0a;DI/DO 신호 변화, 밸브 조작, 압력/메니스커스">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CategoryToggleButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveCategory}" Value="IO">
                                        <Setter Property="Background"  Value="#0E7490"/>
                                        <Setter Property="BorderBrush" Value="#22D3EE"/>
                                        <Setter Property="Foreground"  Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="VISION"
                            Command="{Binding SetCategoryCommand}" CommandParameter="VISION"
                            ToolTip="비전 — [VISION] [DW]&#x0a;카메라 조작, 드랍와처 측정">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CategoryToggleButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveCategory}" Value="VISION">
                                        <Setter Property="Background"  Value="#4D7C0F"/>
                                        <Setter Property="BorderBrush" Value="#A3E635"/>
                                        <Setter Property="Foreground"  Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="RECIPE"
                            Command="{Binding SetCategoryCommand}" CommandParameter="RECIPE"
                            ToolTip="인쇄 조건 변경 — [RECIPE] [WAVEFORM] [PATTERN]">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CategoryToggleButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveCategory}" Value="RECIPE">
                                        <Setter Property="Background"  Value="#BE185D"/>
                                        <Setter Property="BorderBrush" Value="#F472B6"/>
                                        <Setter Property="Foreground"  Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="ALARM"
                            Command="{Binding SetCategoryCommand}" CommandParameter="ALARM"
                            ToolTip="알람 발생/해제 — [ALARM]&#x0a;발생 시점의 장비 스냅샷 포함">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CategoryToggleButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveCategory}" Value="ALARM">
                                        <Setter Property="Background"  Value="#C2410C"/>
                                        <Setter Property="BorderBrush" Value="#FB923C"/>
                                        <Setter Property="Foreground"  Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="SYSTEM"
                            Command="{Binding SetCategoryCommand}" CommandParameter="SYSTEM"
                            ToolTip="시스템 — [BOOT] [CONFIG] [LOG] [LINK] [HEAD] [ComiEcat] [DASH]&#x0a;기동/설정 로드, 드라이버 링크 끊김·복구">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CategoryToggleButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveCategory}" Value="SYSTEM">
                                        <Setter Property="Background"  Value="#475569"/>
                                        <Setter Property="BorderBrush" Value="#94A3B8"/>
                                        <Setter Property="Foreground"  Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="ERROR"
                            Command="{Binding SetCategoryCommand}" CommandParameter="ERROR"
                            ToolTip="Error / Fatal 레벨만 표시 — 장애 빠른 진단&#x0a;(이때 LEVEL 콤보는 무시됨)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CategoryToggleButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveCategory}" Value="ERROR">
                                        <Setter Property="Background"  Value="#991B1B"/>
                                        <Setter Property="BorderBrush" Value="#EF4444"/>
                                        <Setter Property="Foreground"  Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </WrapPanel>
            </Border>
        </Grid>

        <!-- ── 데이터그리드 ───────────────────────────────────────────── -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="12" Padding="5"
                BorderBrush="#334155" BorderThickness="1">
            <DataGrid x:Name="LogDataGrid"
                      ItemsSource="{Binding Logs}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#334155"
                      Background="Transparent"
                      BorderThickness="0"
                      RowHeight="32"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      EnableRowVirtualization="True"
                      ColumnHeaderStyle="{StaticResource CommonColumnHeaderStyle}"
                      CellStyle="{StaticResource CommonCellStyle}">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="TIME"
                            Binding="{Binding Time, StringFormat={}{0:yyyy-MM-dd HH:mm:ss.fff}}"
                            Width="200">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#CBD5E1"/>
                                <Setter Property="FontFamily" Value="Consolas"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="LEVEL"
                            Binding="{Binding Level}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontFamily" Value="Consolas"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="Fatal">
                                        <Setter Property="Foreground" Value="#EF4444"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="Error">
                                        <Setter Property="Foreground" Value="#F97316"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="Warning">
                                        <Setter Property="Foreground" Value="#EAB308"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="Success">
                                        <Setter Property="Foreground" Value="#22C55E"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="Info">
                                        <Setter Property="Foreground" Value="#3B82F6"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="MESSAGE"
                            Binding="{Binding Message}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="10,0"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ── 하단 액션 버튼 ─────────────────────────────────────────── -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="EXPORT CSV" Command="{Binding ExportCsvCommand}"
                        Width="130" Height="38"
                        Style="{StaticResource ModernActionButton}"
                        Background="#334155" BorderBrush="#475569"
                        ToolTip="현재 필터로 조회된 로그를 CSV 로 저장"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="CLEAR ALL" Command="{Binding ClearAllCommand}"
                        Width="120" Height="38"
                        Style="{StaticResource ModernActionButton}"
                        Background="#991B1B" BorderBrush="#EF4444"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
