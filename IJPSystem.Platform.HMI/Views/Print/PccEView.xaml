<UserControl x:Class="IJPSystem.Platform.HMI.Views.PccEView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0B0F1A">

    <UserControl.Resources>

        <Style x:Key="PccSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#3B82F6"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin"     Value="0,0,0,10"/>
        </Style>

        <Style x:Key="PccLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Margin"     Value="0,0,12,7"/>
        </Style>

        <Style x:Key="PccValue" TargetType="TextBlock">
            <Setter Property="Foreground"       Value="#E2E8F0"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="FontFamily"       Value="Consolas"/>
            <Setter Property="Margin"           Value="0,0,0,7"/>
            <Setter Property="TextTrimming"     Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="PccNote" TargetType="TextBlock">
            <Setter Property="Foreground"    Value="#64748B"/>
            <Setter Property="FontSize"      Value="11"/>
            <Setter Property="TextWrapping"  Value="Wrap"/>
        </Style>

        <Style x:Key="PccCard" TargetType="Border">
            <Setter Property="Background"      Value="#1E293B"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="BorderBrush"     Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="16"/>
            <Setter Property="Margin"          Value="0,0,0,12"/>
        </Style>

        <!-- 상태 표 카드 — 가상일 때 테두리가 보라로 바뀐다. 표에 담긴 값만 가짜다
             (로그·cfg 는 가상 모드에서도 진짜 파일을 읽으므로 이 표시를 붙이지 않는다). -->
        <Style x:Key="PccSimCard" TargetType="Border" BasedOn="{StaticResource PccCard}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSimulated}" Value="True">
                    <Setter Property="BorderBrush" Value="#A78BFA"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 경고 상자 — 조용히 실패하는 것들을 눈에 보이게 -->
        <Style x:Key="PccWarnBox" TargetType="Border">
            <Setter Property="Background"      Value="#3F2D0F"/>
            <Setter Property="BorderBrush"     Value="#F59E0B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="10,7"/>
        </Style>

        <Style x:Key="PccWarnText" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="#FCD34D"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- 탭 버튼 — 선택된 것만 파랗게 -->
        <Style x:Key="PccTabButton" TargetType="Button">
            <Setter Property="Height"     Value="30"/>
            <Setter Property="MinWidth"   Value="86"/>
            <Setter Property="Margin"     Value="0,0,6,0"/>
            <Setter Property="Padding"    Value="14,0"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26364B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background"  Value="#111827"/>
            <Setter Property="BorderBrush" Value="#334155"/>
        </Style>

        <!-- cfg 에 등록된 파형 한 줄 -->
        <DataTemplate x:Key="PccWaveformRow">
            <Border Background="#0F172A" CornerRadius="6" BorderBrush="#1E293B" BorderThickness="1"
                    Padding="10,6" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Index}"
                               Foreground="#64748B" FontFamily="Consolas" FontSize="12"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" Foreground="#E2E8F0"
                                   FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Relative}" Foreground="#475569"
                                   FontSize="10" FontFamily="Consolas"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding FullPath}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 기본 파형 = WaveformFileIdx 가 가리키는 번호 -->
                        <Border Background="#1E3A5F" BorderBrush="#3B82F6" BorderThickness="1"
                                CornerRadius="4" Padding="6,2" Margin="0,0,6,0"
                                Visibility="{Binding IsDefault, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="기본" Foreground="#93C5FD" FontSize="10" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text="파일 없음" Foreground="#F59E0B" FontSize="10" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Exists}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 상태 표의 한 줄 — 이름 칸 · 값 칸. Meteor Monitor 의 표와 같은 모양이다. -->
        <DataTemplate x:Key="PccStatusRow">
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="132"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#0F172A" CornerRadius="3,0,0,3" Padding="7,3">
                    <TextBlock Text="{Binding Label}" Foreground="#94A3B8"
                               FontSize="11" FontFamily="Consolas"
                               TextTrimming="CharacterEllipsis"/>
                </Border>

                <Border Grid.Column="1" Background="#0B0F1A" CornerRadius="0,3,3,0" Padding="8,3">
                    <TextBlock Text="{Binding Value}" Foreground="#E2E8F0"
                               FontSize="11" FontFamily="Consolas"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Value}"/>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- 엔진 로그 한 줄. 오류는 빨강 — 엔진이 '***' 를 붙인 줄이다. -->
        <DataTemplate x:Key="PccLogRow">
            <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="11"
                       TextWrapping="NoWrap" Margin="0,0,0,1">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#94A3B8"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                <Setter Property="Foreground" Value="#FCD34D"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="Error">
                                <Setter Property="Foreground" Value="#F87171"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>

        <!-- 로그 상세 항목 체크박스 한 개 -->
        <DataTemplate x:Key="PccLogModuleRow">
            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                          VerticalAlignment="Center" Margin="0,0,10,0"/>

                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Label}" Foreground="#E2E8F0"
                                   FontSize="12" FontFamily="Consolas"/>
                        <!-- 가동 중에 켜면 데이터 공급이 늦어 인쇄가 깨질 수 있다 -->
                        <Border Background="#3F2D0F" BorderBrush="#F59E0B" BorderThickness="1"
                                CornerRadius="4" Padding="5,1" Margin="8,0,0,0"
                                Visibility="{Binding IsHeavy, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="무거움" Foreground="#FCD34D" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" Foreground="#64748B" FontSize="10"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 헤더 -->
            <RowDefinition Height="Auto"/>   <!-- 탭 -->
            <RowDefinition Height="*"/>      <!-- 본문 -->
        </Grid.RowDefinitions>

        <!-- ══ 헤더 ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#111827" CornerRadius="12,12,0,0"
                BorderBrush="#334155" BorderThickness="1,1,1,0" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="PCC-E Print Engine"
                                   Foreground="White" FontSize="14" FontWeight="Bold"/>

                        <!-- 실물이 아니라는 표시. 계속 보여야 한다 — 스크린샷만 보고
                             실물로 오해하는 것을 막는 유일한 장치다. -->
                        <Border Background="#3B2A63" BorderBrush="#A78BFA" BorderThickness="1"
                                CornerRadius="4" Padding="7,2" Margin="10,0,0,0"
                                Visibility="{Binding IsSimulated, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="가상 데이터" Foreground="#C4B5FD"
                                       FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="설정은 Meteor 설치가 관리합니다 — 여기서는 로그 항목만 바꿉니다"
                               Foreground="#64748B" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- 헤드 연결 — 상태바와 같은 값이다(폴링은 한 곳에서만 한다) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="28,0,0,0">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#475569"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Main.HeadConnected}" Value="True">
                                        <Setter Property="Fill" Value="#22C55E"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding Main.HeadStatusText}"
                               Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Meteor PrintEngine 시작. 엔진이 붙어 있으면 스스로 꺼진다(CanStartEngine).
                         노즐을 쏘는 명령이 아니라 엔진 프로세스를 올리고 cfg 를 읽히는 것뿐이라,
                         Head Power 처럼 시퀀스를 거치게 하지 않고 여기 둔다. -->
                    <Button Command="{Binding StartEngineCommand}"
                            Width="120" Height="32" Margin="0,0,8,0"
                            Style="{StaticResource MutedActionButtonStyle}"
                            Background="#1E3A5F"
                            ToolTip="Meteor PrintEngine 을 띄웁니다. 엔진이 떠야 PCC·헤드 상태를 읽을 수 있습니다.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▶" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center" Foreground="#60A5FA"/>
                            <TextBlock Text="엔진 시작" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RefreshCommand}"
                            Width="96" Height="32" Margin="0,0,8,0"
                            Style="{StaticResource MutedActionButtonStyle}"
                            Background="#1E293B">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↻" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center" Foreground="#3B82F6"/>
                            <TextBlock Text="새로고침" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenConfigFolderCommand}"
                            Width="116" Height="32"
                            Style="{StaticResource MutedActionButtonStyle}"
                            Background="#1E293B">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="□" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="폴더 열기" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ 탭 ════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="#0F172A" BorderBrush="#334155" BorderThickness="1,0,1,0"
                Padding="18,10,18,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="STATUS" Command="{Binding SelectTabCommand}" CommandParameter="STATUS">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PccTabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusTab}" Value="True">
                                    <Setter Property="Background"  Value="#1E3A5F"/>
                                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                                    <Setter Property="Foreground"  Value="#93C5FD"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="LOG" Command="{Binding SelectTabCommand}" CommandParameter="LOG">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PccTabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLogTab}" Value="True">
                                    <Setter Property="Background"  Value="#1E3A5F"/>
                                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                                    <Setter Property="Foreground"  Value="#93C5FD"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="SETUP" Command="{Binding SelectTabCommand}" CommandParameter="SETUP">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PccTabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSetupTab}" Value="True">
                                    <Setter Property="Background"  Value="#1E3A5F"/>
                                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                                    <Setter Property="Foreground"  Value="#93C5FD"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="CONFIG" Command="{Binding SelectTabCommand}" CommandParameter="CONFIG">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PccTabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConfigTab}" Value="True">
                                    <Setter Property="Background"  Value="#1E3A5F"/>
                                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                                    <Setter Property="Foreground"  Value="#93C5FD"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- ══ 본문 ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#0F172A" CornerRadius="0,0,12,12"
                BorderBrush="#334155" BorderThickness="1,0,1,1">
            <Grid Margin="18">

                <!-- ── STATUS ───────────────────────────────────────────
                     Meteor Status Monitor 의 Status 탭과 같은 배치:
                     왼쪽 표 세 개(Printer / PCC / HDC·Head) · 가운데 선택과 표시등 ·
                     오른쪽 데이터 경로. 같은 화면을 보던 사람이 같은 자리에서 찾게 한다. -->
                <Grid Visibility="{Binding IsStatusTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>   <!-- 표 3개 -->
                        <ColumnDefinition Width="300"/>   <!-- 선택 · 표시등 -->
                        <ColumnDefinition Width="*"/>     <!-- 데이터 경로 · 설정 -->
                    </Grid.ColumnDefinitions>

                    <!-- ① 표 세 개 -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Margin="0,0,14,0">
                        <ScrollViewer.Resources>
                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ModernScrollBarStyle}"/>
                        </ScrollViewer.Resources>
                        <StackPanel>
                            <Border Style="{StaticResource PccSimCard}" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="PRINTER" Style="{StaticResource PccSectionTitle}"/>
                                    <ItemsControl ItemsSource="{Binding PrinterRows}"
                                                  ItemTemplate="{StaticResource PccStatusRow}"/>
                                    <TextBlock Text="{Binding HeadDetailText}" Style="{StaticResource PccNote}"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PccSimCard}" Padding="12">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="PCC" Style="{StaticResource PccSectionTitle}" Margin="0"/>
                                        <TextBlock Text="{Binding SelectedPccNumber, StringFormat=#{0}}"
                                                   Foreground="#475569" FontSize="11" FontFamily="Consolas"
                                                   HorizontalAlignment="Right"/>
                                    </DockPanel>

                                    <ItemsControl ItemsSource="{Binding PccRows}"
                                                  ItemTemplate="{StaticResource PccStatusRow}"/>

                                    <TextBlock Text="PCC 상세를 읽지 못했습니다.">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource PccNote}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasPccDetail}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- 폴트는 숫자 대신 풀어서 -->
                                    <ItemsControl ItemsSource="{Binding SelectedPccFaults}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="#F87171" FontSize="11"
                                                           TextWrapping="Wrap" Margin="0,0,0,3"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- self-clearing 이라 폴링할 때마다 확인한다 -->
                                    <TextBlock Text="⚠ 데이터 전송 오류(self-clearing)" Foreground="#FCD34D"
                                               FontSize="11" Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedPccDataTransferError}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PccSimCard}" Padding="12" Margin="0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="HDC / HEAD" Style="{StaticResource PccSectionTitle}" Margin="0"/>
                                        <TextBlock Text="{Binding SelectedHeadNumber, StringFormat=#{0}}"
                                                   Foreground="#475569" FontSize="11" FontFamily="Consolas"
                                                   HorizontalAlignment="Right"/>
                                    </DockPanel>

                                    <ItemsControl ItemsSource="{Binding HdcRows}"
                                                  ItemTemplate="{StaticResource PccStatusRow}"/>

                                    <TextBlock Text="헤드 상세를 읽지 못했습니다. 헤드는 PCC 가 붙은 뒤에야 보입니다.">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource PccNote}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasHdcDetail}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ② 선택과 표시등 -->
                    <StackPanel Grid.Column="1" Margin="0,0,14,0">

                        <!-- 가상일 때만 나온다. 정상 상태만 보면 폴트 표시나
                             "주소 없음" 안내가 맞게 뜨는지 확인할 방법이 없다. -->
                        <Border Background="#3B2A63" BorderBrush="#A78BFA" BorderThickness="1"
                                CornerRadius="10" Padding="12" Margin="0,0,0,12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasScenarios}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="가상 상황" Foreground="#C4B5FD"
                                           FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                                <ComboBox ItemsSource="{Binding Scenarios}"
                                          SelectedItem="{Binding SelectedScenario, Mode=TwoWay}"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          Width="150" Height="30" HorizontalAlignment="Left"/>
                                <TextBlock Text="아래 값은 실물이 아닙니다. 카운터가 도는 것으로 화면 갱신을 확인합니다."
                                           Foreground="#8B7BB8" FontSize="10" TextWrapping="Wrap"
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PccCard}" Padding="12">
                            <StackPanel>
                                <TextBlock Text="PCC" Style="{StaticResource PccSectionTitle}"/>
                                <ComboBox ItemsSource="{Binding PccNumbers}"
                                          SelectedItem="{Binding SelectedPccNumber, Mode=TwoWay}"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          Width="88" Height="30" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PccCard}" Padding="12">
                            <StackPanel>
                                <TextBlock Text="HDC / HEAD" Style="{StaticResource PccSectionTitle}"/>

                                <ComboBox ItemsSource="{Binding HeadNumbers}"
                                          SelectedItem="{Binding SelectedHeadNumber, Mode=TwoWay}"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          Width="88" Height="30" HorizontalAlignment="Left"
                                          Margin="0,0,0,14"/>

                                <!-- 헤드 전원 표시등 — 색 판정은 VM 한 곳에서 한다 -->
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center"
                                             Stroke="#0F172A" StrokeThickness="2">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#475569"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HeadPowerLamp}" Value="Init">
                                                        <Setter Property="Fill" Value="#A78BFA"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HeadPowerLamp}" Value="On">
                                                        <Setter Property="Fill" Value="#22C55E"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HeadPowerLamp}" Value="Fault">
                                                        <Setter Property="Fill" Value="#EF4444"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="헤드 전원" Foreground="#94A3B8" FontSize="11"/>
                                        <TextBlock Text="{Binding HeadPowerLampText}" Foreground="#E2E8F0"
                                                   FontSize="13" FontWeight="Bold"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 헤드를 움직이는 버튼은 넣지 않았다 -->
                        <Border Style="{StaticResource PccCard}" Padding="12" Margin="0">
                            <TextBlock Style="{StaticResource PccNote}">
                                <Run Text="Head Power · Force PD · Aux PD · ReInit 는 이 화면에 없습니다."/>
                                <LineBreak/>
                                <Run Text="헤드를 실제로 움직이는 명령이라 이 장비의 시퀀스·안전 흐름을 거쳐야 합니다."/>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <!-- ③ 데이터 경로 · 엔진 설정 -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Resources>
                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ModernScrollBarStyle}"/>
                        </ScrollViewer.Resources>
                        <StackPanel>
                            <Border Style="{StaticResource PccCard}" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="DATAPATH" Style="{StaticResource PccSectionTitle}"/>
                                    <ItemsControl ItemsSource="{Binding DatapathRows}"
                                                  ItemTemplate="{StaticResource PccStatusRow}"/>
                                    <TextBlock Style="{StaticResource PccNote}" Margin="0,6,0,0"
                                               Text="보낸 문서 수는 느는데 인쇄 카운터가 그대로면, 데이터는 갔지만 찍히지 않고 있다는 뜻입니다."/>
                                </StackPanel>
                            </Border>

                            <!-- 엔진 설정 파일 -->
                            <Border Style="{StaticResource PccCard}">
                                <StackPanel>
                                    <TextBlock Text="ENGINE CONFIG" Style="{StaticResource PccSectionTitle}"/>

                                    <Border Background="#0F172A" CornerRadius="6" BorderBrush="#334155" BorderThickness="1"
                                            Padding="10,6" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding ConfigPath}" ToolTip="{Binding ConfigPath}"
                                                   Foreground="#60A5FA" FontSize="11" FontFamily="Consolas"
                                                   TextWrapping="Wrap"/>
                                    </Border>

                                    <TextBlock Text="{Binding ConfiguredValueText}"
                                               Style="{StaticResource PccNote}" Margin="0,0,0,10"/>

                                    <!-- 파일이 없으면 헤드가 조용히 안 뜬다 — 사유를 눈에 보이게 -->
                                    <Border Margin="0,0,0,10">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource PccWarnBox}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasConfigProblem}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding ConfigStateText}" Style="{StaticResource PccWarnText}"/>
                                    </Border>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="118"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>   <!-- 0 PCC 종류 -->
                                            <RowDefinition Height="Auto"/>   <!-- 1 헤드 -->
                                            <RowDefinition Height="Auto"/>   <!-- 2 계조 -->
                                            <RowDefinition Height="Auto"/>   <!-- 3 해상도 -->
                                            <RowDefinition Height="Auto"/>   <!-- 4 면 구성 -->
                                            <RowDefinition Height="Auto"/>   <!-- 5 인코더 -->
                                            <RowDefinition Height="Auto"/>   <!-- 6 네트워크 -->
                                            <RowDefinition Height="Auto"/>   <!-- 7 드라이버 모드 -->
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="PCC 종류" Style="{StaticResource PccLabel}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PccTypeText}" Style="{StaticResource PccValue}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="헤드" Style="{StaticResource PccLabel}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HeadTypeText}" Style="{StaticResource PccValue}"
                                                   ToolTip="이 이름의 섹션에 헤드 전용 설정이 들어 있습니다. 헤드를 바꾸면 섹션 이름도 바뀝니다."/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="계조" Style="{StaticResource PccLabel}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GreyLevelText}" Style="{StaticResource PccValue}"
                                                   ToolTip="파형 화면의 GL 배정표 칸 수와 같아야 합니다."/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="해상도(X)" Style="{StaticResource PccLabel}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding XdpiText}" Style="{StaticResource PccValue}"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="면 구성" Style="{StaticResource PccLabel}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PlaneText}" Style="{StaticResource PccValue}"
                                                   ToolTip="Plane1 = PCC:HDC(:Head) — 어느 헤드가 1번 면을 찍는지."/>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="인코더" Style="{StaticResource PccLabel}"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding EncoderText}" Style="{StaticResource PccValue}"
                                                   ToolTip="600dpi + 1µm 인코더면 3/127 이 정상값입니다."/>

                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="네트워크" Style="{StaticResource PccLabel}"/>
                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding AdapterText}" Style="{StaticResource PccValue}"
                                                   ToolTip="이 이름과 같은 네트워크 어댑터가 있어야 PCC 를 찾습니다."/>

                                        <TextBlock Grid.Row="7" Grid.Column="0" Text="드라이버 모드" Style="{StaticResource PccLabel}"/>
                                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding DriverModeText}" Style="{StaticResource PccValue}"
                                                   ToolTip="AppConfig.json 의 DriverMode.Head."/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 연결이 안 될 때 볼 것 -->
                            <Border Style="{StaticResource PccCard}">
                                <StackPanel>
                                    <TextBlock Text="CONNECTION" Style="{StaticResource PccSectionTitle}"/>

                                    <!-- [엔진 시작] 결과. 실패 사유는 로그로만 흘리면 묻힌다. -->
                                    <Border Background="#132033" BorderBrush="#1E3A5F" BorderThickness="1"
                                            CornerRadius="6" Padding="10,7" Margin="0,0,0,10">
                                        <Border.Style>
                                            <!-- 기본은 보이게 두고 '빈 문자열일 때만' 숨긴다 —
                                                 반대로 쓰면(기본 숨김 + 빈값 숨김) 영영 안 보인다. -->
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StartEngineResult}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StartEngineResult}" TextWrapping="Wrap"
                                                   Foreground="#93C5FD" FontSize="11"/>
                                    </Border>

                                    <TextBlock Style="{StaticResource PccNote}">
                                        <Run Text="엔진이 떠 있어야 아래가 의미가 있습니다 — 안 떠 있으면 위의 [엔진 시작] 을 먼저 누르세요."/>
                                        <LineBreak/>
                                        <Run Text="PCC 가 붙지 않으면 대개 하드웨어가 아니라 다음 셋 중 하나입니다."/>
                                        <LineBreak/>
                                        <Run Text="① DHCP 서버가 떠 있지 않다 — PCC-E 는 IP 를 받아야 나타납니다(PCC 표의 IP 가 '주소 없음')."/>
                                        <LineBreak/>
                                        <Run Text="② 네트워크 어댑터 이름이 위 [네트워크] 값과 다르다."/>
                                        <LineBreak/>
                                        <Run Text="③ 다른 프로그램(LabVIEW·MeteorConnect)이 프린터를 점유 중이다 — 한 프로세스만 소유할 수 있습니다."/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- cfg 에 등록된 파형 -->
                            <Border Style="{StaticResource PccCard}" Margin="0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="WAVEFORMS IN CONFIG" Style="{StaticResource PccSectionTitle}" Margin="0"/>
                                        <TextBlock Text="{Binding WaveformCountText}" Foreground="#64748B"
                                                   FontSize="11" HorizontalAlignment="Right"/>
                                    </DockPanel>

                                    <ItemsControl ItemsSource="{Binding Waveforms}"
                                                  ItemTemplate="{StaticResource PccWaveformRow}"/>

                                    <TextBlock Text="등록된 파형이 없습니다.">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource PccNote}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasWaveforms}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- 편집한 파형이 헤드까지 못 가는 상황 -->
                                    <Border Margin="0,10,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource PccWarnBox}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasWaveformGap}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding WaveformGapText}" Style="{StaticResource PccWarnText}"/>
                                    </Border>

                                    <TextBlock Text="{Binding OurWaveformRoot, StringFormat=파형 폴더 · {0}}"
                                               Style="{StaticResource PccNote}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ── LOG (Debug / Errors) ───────────────────────────── -->
                <Grid Visibility="{Binding IsLogTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 도구 줄 -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0" IsChecked="{Binding ErrorsOnly, Mode=TwoWay}"
                                  Content="오류만" Foreground="#94A3B8" FontSize="12"
                                  VerticalAlignment="Center"
                                  ToolTip="따로 모으는 게 아니라 같은 로그를 거른 것입니다. 엔진은 오류 줄 앞에 *** 를 붙입니다."/>

                        <TextBlock Grid.Column="1" Text="{Binding LogStateText}" Foreground="#64748B"
                                   FontSize="11" VerticalAlignment="Center" Margin="16,0,0,0"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Command="{Binding ReloadLogCommand}" Content="다시 읽기"
                                    Width="90" Height="30" Margin="0,0,6,0"
                                    Style="{StaticResource MutedActionButtonStyle}" Background="#1E293B"
                                    Foreground="White" FontSize="11" FontWeight="Bold"/>
                            <Button Command="{Binding ClearLogCommand}" Content="화면 지우기"
                                    Width="96" Height="30" Margin="0,0,6,0"
                                    Style="{StaticResource MutedActionButtonStyle}" Background="#1E293B"
                                    Foreground="White" FontSize="11" FontWeight="Bold"
                                    ToolTip="화면 버퍼만 비웁니다. 파일은 그대로입니다."/>
                            <Button Command="{Binding PurgeLogCommand}" Content="파일 비우기"
                                    Width="96" Height="30"
                                    Style="{StaticResource MutedActionButtonStyle}" Background="#3F2D0F"
                                    Foreground="#FCD34D" FontSize="11" FontWeight="Bold"
                                    ToolTip="디스크의 로그 내용을 비웁니다. 지난 오류 기록이 사라집니다."/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="{Binding LogPath}" Foreground="#475569"
                               FontSize="10" FontFamily="Consolas" Margin="0,0,0,8"
                               TextTrimming="CharacterEllipsis"/>

                    <Border Grid.Row="2" Background="#0B0F1A" CornerRadius="6"
                            BorderBrush="#334155" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto" Padding="10,8">
                            <ScrollViewer.Resources>
                                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ModernScrollBarStyle}"/>
                            </ScrollViewer.Resources>
                            <ItemsControl ItemsSource="{Binding LogLines}"
                                          ItemTemplate="{StaticResource PccLogRow}"/>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ── SETUP ──────────────────────────────────────────── -->
                <Grid Visibility="{Binding IsSetupTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="520"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PccCard}" Margin="0,0,18,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="PRINT ENGINE LOG MODULES" Style="{StaticResource PccSectionTitle}" Margin="0"/>
                                <TextBlock Text="{Binding LogModuleValueText}" Foreground="#60A5FA"
                                           FontSize="11" FontFamily="Consolas" HorizontalAlignment="Right"
                                           ToolTip="cfg 의 [Test] LogCtrlBits 값입니다."/>
                            </DockPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ScrollViewer.Resources>
                                    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ModernScrollBarStyle}"/>
                                </ScrollViewer.Resources>
                                <ItemsControl ItemsSource="{Binding LogModules}"
                                              ItemTemplate="{StaticResource PccLogModuleRow}"/>
                            </ScrollViewer>

                            <!-- 가동 중에 켜면 데이터 공급이 늦어 인쇄가 깨질 수 있다 -->
                            <Border Grid.Row="2" Margin="0,10,0,0">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource PccWarnBox}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasHeavyModule}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Style="{StaticResource PccWarnText}"
                                           Text="'무거움' 항목이 켜져 있습니다. 가동 중에 켜 두면 호스트 PC 부하로 데이터 공급이 늦어져 FIFO under-run 이 날 수 있습니다."/>
                            </Border>

                            <Button Grid.Row="3" Command="{Binding SaveLogModulesCommand}"
                                    Content="cfg 에 저장" Height="34" Margin="0,12,0,0"
                                    Style="{StaticResource MutedActionButtonStyle}" Background="#1E3A5F"
                                    Foreground="White" FontSize="12" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource PccCard}">
                            <StackPanel>
                                <TextBlock Text="저장 방식" Style="{StaticResource PccSectionTitle}"/>
                                <TextBlock Style="{StaticResource PccNote}">
                                    <Run Text="cfg 의 [Test] LogCtrlBits 한 줄만 갈아 끼웁니다. 손으로 넣은 주석과 줄 순서는 그대로 둡니다"/>
                                    <Run Text="— 이 파일은 현장에서 직접 편집하는 파일이라, 우리가 통째로 다시 쓰면 다음 사람이 무엇을 왜 바꿨는지 알 수 없게 됩니다."/>
                                    <LineBreak/><LineBreak/>
                                    <Run Text="임시 파일에 다 쓴 뒤 바꿔치기하므로, 쓰는 도중에 죽어도 기존 cfg 는 멀쩡합니다."/>
                                    <LineBreak/><LineBreak/>
                                    <Run Text="바뀐 값은 엔진이 다시 뜰 때 적용됩니다."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PccCard}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="비트 위치 확인 필요" Style="{StaticResource PccSectionTitle}"/>
                                <TextBlock Style="{StaticResource PccNote}">
                                    <Run Text="각 항목이 몇 번 비트인지는 매뉴얼에 없습니다. Meteor Monitor 화면의 나열 순서대로 0번부터 붙여 두었습니다."/>
                                    <LineBreak/><LineBreak/>
                                    <Run Text="확인하려면 항목을 하나씩 켜서 저장하고, LOG 탭에서"/>
                                    <Run Text="UpdateDebugSettings() LogCtrlBits:0x…" Foreground="#94A3B8" FontFamily="Consolas"/>
                                    <Run Text="값을 대조하면 됩니다. 어긋나 있어도 로그가 더/덜 나올 뿐 장비 동작에는 영향이 없습니다."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ── CONFIG 원문 ────────────────────────────────────── -->
                <Border Style="{StaticResource PccCard}" Margin="0"
                        Visibility="{Binding IsConfigTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="CONFIG FILE" Style="{StaticResource PccSectionTitle}" Margin="0"/>
                            <TextBlock Text="{Binding ConfigPath}" Foreground="#475569" FontSize="10"
                                       FontFamily="Consolas" HorizontalAlignment="Right"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>

                        <Border Grid.Row="1" Background="#0B0F1A" CornerRadius="6"
                                BorderBrush="#334155" BorderThickness="1">
                            <TextBox Text="{Binding RawText, Mode=OneWay}"
                                     IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                     Background="Transparent" Foreground="#94A3B8"
                                     BorderThickness="0" Padding="10"
                                     FontFamily="Consolas" FontSize="11"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
