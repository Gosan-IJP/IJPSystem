<UserControl x:Class="IJPSystem.Platform.HMI.Views.PatternPrintView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctl="clr-namespace:IJPSystem.Platform.HMI.Common.Controls"
             xmlns:views="clr-namespace:IJPSystem.Platform.HMI.Views"
             mc:Ignorable="d" d:DesignHeight="780" d:DesignWidth="1280"
             Background="#0B0F1A">

    <UserControl.Resources>
        <!-- 카드 컨테이너 -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background"      Value="#111827"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="BorderBrush"     Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- 섹션 타이틀 -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- 작은 라벨 -->
        <Style x:Key="MutedLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 툴바 아이콘 버튼 -->
        <Style x:Key="ToolbarBtn" TargetType="Button">
            <Setter Property="Width"  Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <!-- Background 는 Setter 로 두고 템플릿에서 TemplateBinding 으로 받는다.
                 (하드코딩하면 파생 스타일/트리거의 Background 변경이 조용히 무시됨) -->
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#334155" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 액션 버튼 -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Background"      Value="#1E293B"/>
            <Setter Property="BorderBrush"     Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 조그 D-패드 버튼 -->
        <!-- 작은 +/- 증감 버튼 (셋팅값 박스 옆) — 글리프가 잘 보이도록 전용 템플릿 -->
        <Style x:Key="StepBtn" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Background"      Value="#1E293B"/>
            <Setter Property="BorderBrush"     Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="FontSize"        Value="15"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <TextBlock Text="{TemplateBinding Content}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" LineHeight="15" Margin="0,-2,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="JogBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Width"  Value="62"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
        </Style>

        <!-- 위치 표시 박스 -->
        <Style x:Key="PosBox" TargetType="Border">
            <Setter Property="Background"      Value="#0D1520"/>
            <Setter Property="BorderBrush"     Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="4"/>
            <Setter Property="Padding"         Value="6,4"/>
        </Style>
        <Style x:Key="PosText" TargetType="TextBlock">
            <Setter Property="Foreground"    Value="#E2E8F0"/>
            <Setter Property="FontFamily"    Value="Consolas"/>
            <Setter Property="FontSize"      Value="13"/>
            <Setter Property="FontWeight"    Value="Bold"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <!-- ── 노즐 SPIT 스트림 애니메이션 (P&ID PnidView와 동일 구현) ──
             Tag(IsSpitting)=True 일 때 StrokeDashOffset 순환으로 잉크가 흘러내리는 점선 -->
        <Style x:Key="NozzleSpitStream" TargetType="Line">
            <Setter Property="Stroke"          Value="#FFFFFF"/>
            <Setter Property="StrokeThickness" Value="1.4"/>
            <Setter Property="StrokeDashArray" Value="1 1.5"/>
            <Setter Property="StrokeDashCap"   Value="Round"/>
            <Setter Property="X1" Value="0"/>
            <Setter Property="Y1" Value="0"/>
            <Setter Property="X2" Value="0"/>
            <Setter Property="Y2" Value="30"/>
            <Setter Property="Opacity" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="NozzleSpitStreamSb">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="StrokeDashOffset"
                                              From="2.5" To="0" Duration="0:0:0.14"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="NozzleSpitStreamSb"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- UNIT / SPEED 선택 토글 (라디오, 선택 시 파란 테두리) -->
        <Style x:Key="SelectorBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="Height"     Value="40"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#0D1520" BorderBrush="#334155"
                                BorderThickness="1.5" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════ 좌측 운전부 (1단계) ══════════ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>     <!-- Motion State (세로) -->
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>  <!-- Jog Control -->
            </Grid.RowDefinitions>

            <!-- ── Visual Monitor (기존 비전 화면 유지) ── -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 헤더 + 툴바 -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Visual Monitor"
                                   Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        <!-- 도구: 돋보기=확대(즉시), ⤢=화면 맞춤, 손=이동 모드 -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Style="{StaticResource ToolbarBtn}" Content="🔍" Margin="0,0,4,0"
                                    Command="{Binding Monitor.ZoomInCommand}"
                                    ToolTip="확대 (휠로 확대/축소도 가능)"/>
                            <Button Style="{StaticResource ToolbarBtn}" Content="⤢"  Margin="0,0,4,0"
                                    Command="{Binding Monitor.FitCommand}"
                                    ToolTip="화면 맞춤 (이미지 전체 보기)"/>
                            <Button Content="✋" Margin="0,0,0,0"
                                    Command="{Binding Monitor.SetToolCommand}" CommandParameter="Pan"
                                    ToolTip="이동 (드래그로 화면 이동)">
                                <Button.Style>
                                    <!-- 이동 모드일 때 활성 표시 -->
                                    <Style TargetType="Button" BasedOn="{StaticResource ToolbarBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Monitor.Tool}" Value="Pan">
                                                <Setter Property="Background" Value="#1D4ED8"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <!-- 우측: Toggle Cross line + 카메라 소스(기본 드랍와쳐) -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                            <Button Content="Toggle Cross line" Height="28" Margin="0,0,6,0"
                                    Command="{Binding Monitor.ToggleCrossLineCommand}"
                                    ToolTip="크로스라인 표시/숨김">
                                <Button.Style>
                                    <!-- 켜져 있으면 강조해 현재 상태를 알 수 있게 함 -->
                                    <Style TargetType="Button" BasedOn="{StaticResource ActionBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Monitor.CrossLineVisible}" Value="True">
                                                <Setter Property="Background" Value="#B91C1C"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <ComboBox Width="120" Height="28" Background="#0D1520" Foreground="Black"
                                      BorderBrush="#334155" VerticalContentAlignment="Center" FontWeight="Bold"
                                      ItemsSource="{Binding Monitor.Sources}"
                                      SelectedItem="{Binding Monitor.SelectedSource}"
                                      ToolTip="카메라 소스"/>
                        </StackPanel>
                    </Grid>

                    <!-- 카메라 이미지 영역 — 공용 VisualMonitorView 재사용(라이브 프레임/크로스라인/줌/팬).
                         ShowToolbar=False: 위 카드 툴바를 쓰므로 내장 툴바는 숨긴다. -->
                    <Border Grid.Row="2" Background="Black"
                            BorderBrush="#1E293B" BorderThickness="1" CornerRadius="2">
                        <views:VisualMonitorView DataContext="{Binding Monitor}" ShowToolbar="False"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ── 하단: Jog Control + Motion State (가로 배치) ── -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Jog Control" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <!-- X-Y D-패드 -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource JogBtn}" Content="↑"
                                        Tag="Y" IsEnabled="{Binding AxisY.CanJog, FallbackValue=False}"
                                        PreviewMouseDown="JogForward_MouseDown" PreviewMouseUp="JogStop_MouseUp"/>
                                <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource JogBtn}" Content="←"
                                        Tag="X" IsEnabled="{Binding AxisX.CanJog, FallbackValue=False}"
                                        PreviewMouseDown="JogBackward_MouseDown" PreviewMouseUp="JogStop_MouseUp"/>
                                <Border Grid.Row="1" Grid.Column="1" Width="62" Height="56"
                                        Background="#0D1520" BorderBrush="#334155" BorderThickness="1" CornerRadius="6">
                                    <TextBlock Text="X, Y" Foreground="#94A3B8" FontWeight="Bold" FontSize="13"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource JogBtn}" Content="→"
                                        Tag="X" IsEnabled="{Binding AxisX.CanJog, FallbackValue=False}"
                                        PreviewMouseDown="JogForward_MouseDown" PreviewMouseUp="JogStop_MouseUp"/>
                                <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource JogBtn}" Content="↓"
                                        Tag="Y" IsEnabled="{Binding AxisY.CanJog, FallbackValue=False}"
                                        PreviewMouseDown="JogBackward_MouseDown" PreviewMouseUp="JogStop_MouseUp"/>
                            </Grid>

                            <!-- Z + T (조그 단위 콤보박스를 두 축 가운데 위에 배치) -->
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <ComboBox Width="92" Height="26" Margin="0,0,0,8" HorizontalAlignment="Center"
                                          Background="#0D1520" Foreground="Black" BorderBrush="#334155"
                                          VerticalContentAlignment="Center" FontWeight="Bold"
                                          SelectedIndex="{Binding JogUnitIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Continuous"/>
                                    <ComboBoxItem Content="10µm"/>
                                    <ComboBoxItem Content="100µm"/>
                                    <ComboBoxItem Content="1000µm"/>
                                </ComboBox>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <!-- Z 축 -->
                                    <StackPanel>
                                        <Button Style="{StaticResource JogBtn}" Content="⤊"  Margin="0,0,0,6"
                                                Tag="Z" IsEnabled="{Binding AxisZ.CanJog, FallbackValue=False}"
                                                PreviewMouseDown="JogForward_MouseDown" PreviewMouseUp="JogStop_MouseUp"/>
                                        <TextBlock Text="Z" Foreground="#F59E0B" FontWeight="Bold" FontSize="13"
                                                   HorizontalAlignment="Center"/>
                                        <Button Style="{StaticResource JogBtn}" Content="⤋" Margin="0,6,0,0"
                                                Tag="Z" IsEnabled="{Binding AxisZ.CanJog, FallbackValue=False}"
                                                PreviewMouseDown="JogBackward_MouseDown" PreviewMouseUp="JogStop_MouseUp"/>
                                    </StackPanel>

                                    <!-- T 축 -->
                                    <StackPanel Margin="10,0,0,0">
                                        <Button Style="{StaticResource JogBtn}" Content="↑" Margin="0,0,0,6"
                                                Tag="T" IsEnabled="{Binding AxisT.CanJog, FallbackValue=False}"
                                                PreviewMouseDown="JogForward_MouseDown" PreviewMouseUp="JogStop_MouseUp"/>
                                        <TextBlock Text="T" Foreground="#C084FC" FontWeight="Bold" FontSize="13"
                                                   HorizontalAlignment="Center"/>
                                        <Button Style="{StaticResource JogBtn}" Content="↓" Margin="0,6,0,0"
                                                Tag="T" IsEnabled="{Binding AxisT.CanJog, FallbackValue=False}"
                                                PreviewMouseDown="JogBackward_MouseDown" PreviewMouseUp="JogStop_MouseUp"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Motion State (세로 배열) -->
                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="14">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Motion State" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>

                        <!-- Axis X -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Axis X" Foreground="#CBD5E1" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Style="{StaticResource PosBox}" Padding="10,8">
                                <TextBlock Style="{StaticResource PosText}" FontSize="16"
                                           Text="{Binding AxisX.CurrentPos, StringFormat={}{0:F3} mm, FallbackValue=-- mm}"/>
                            </Border>
                        </Grid>

                        <!-- Axis Y -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Axis Y" Foreground="#CBD5E1" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Style="{StaticResource PosBox}" Padding="10,8">
                                <TextBlock Style="{StaticResource PosText}" FontSize="16"
                                           Text="{Binding AxisY.CurrentPos, StringFormat={}{0:F3} mm, FallbackValue=-- mm}"/>
                            </Border>
                        </Grid>

                        <!-- Axis Z -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Axis Z" Foreground="#CBD5E1" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Style="{StaticResource PosBox}" Padding="10,8">
                                <TextBlock Style="{StaticResource PosText}" FontSize="16"
                                           Text="{Binding AxisZ.CurrentPos, StringFormat={}{0:F3} mm, FallbackValue=-- mm}"/>
                            </Border>
                        </Grid>

                        <!-- Axis T -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Axis T" Foreground="#CBD5E1" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Style="{StaticResource PosBox}" Padding="10,8">
                                <TextBlock Style="{StaticResource PosText}" FontSize="16"
                                           Text="{Binding AxisT.CurrentPos, StringFormat={}{0:F3} mm, FallbackValue=-- mm}"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>

        <!-- ══════════ 우측: Process / Print (게이지·Open Drop Watcher 제외) ══════════ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Fluidics + Pressure + Lamps -->
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>     <!-- Print / Voltage / Nozzle -->
            </Grid.RowDefinitions>

            <!-- ── 상단: Fluidics / Pressure / Status ── -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>  <!-- Fluidics -->
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>     <!-- Purge/Meniscus -->
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>  <!-- Pressure ctrl + lamps -->
                </Grid.ColumnDefinitions>

                <!-- Fluidics State (barrel / 주사기 / 밸브 / Head / 퍼지 bath 박스 다이어그램) -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="12" Width="220"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Fluidics State" Style="{StaticResource SectionTitle}"
                                   FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                        <!-- 명시적 Height 로 다이어그램 높이를 고정 → Row0 축소(하단 패널 공간 확보) -->
                        <Viewbox Stretch="Uniform" Height="250">
                            <Canvas Width="290" Height="462">
                                <!-- ── 배관(파이프) — 박스/컨트롤 뒤에 그려짐 ── -->
                                <!-- barrel/주사기 → 밸브 -->
                                <Line X1="90"  Y1="234" X2="90"  Y2="302" Stroke="#2C7A8C" StrokeThickness="5"/>
                                <Line X1="200" Y1="246" X2="200" Y2="302" Stroke="#2C7A8C" StrokeThickness="5"/>
                                <!-- 밸브 → H1 헤드 -->
                                <Line X1="90"  Y1="336" X2="90"  Y2="362" Stroke="#2C7A8C" StrokeThickness="5"/>
                                <Line X1="200" Y1="336" X2="200" Y2="362" Stroke="#2C7A8C" StrokeThickness="5"/>

                                <!-- ── 어두운 패널(컨트롤 배경) ── -->
                                <Border Canvas.Left="40"  Canvas.Top="6" Width="100" Height="232"
                                        Background="#0A0E14" CornerRadius="4"/>
                                <Border Canvas.Left="150" Canvas.Top="6" Width="100" Height="232"
                                        Background="#0A0E14" CornerRadius="4"/>

                                <!-- ── Barrel 컨트롤 (출력 팁 ≈ x90,y234) ── -->
                                <!-- 액위 센서 X100(LOW)/X101(HIGH) 에 따라 비주얼·센서 점이 실시간 변함 -->
                                <ctl:Barrel Canvas.Left="55" Canvas.Top="14" TagId="BARREL"
                                            LevelStatus="{Binding BarrelLevel}"
                                            SensorHigh="{Binding LevelSensorHigh}"
                                            SensorLow="{Binding LevelSensorLow}"/>

                                <!-- ── Syringe 10cc 컨트롤 (니들 ≈ x200,y246) ── -->
                                <ctl:Syringe10cc Canvas.Left="155" Canvas.Top="4"
                                                 TagId="SYRINGE" VolumeCc="5"/>

                                <!-- ── Valve L / Valve R (토글 스위치 + 라벨) ── -->
                                <!-- 라벨 (파이프 위에 카드색 배경으로 마스킹) -->
                                <Border Canvas.Left="58" Canvas.Top="248" Background="#0F1A24" Padding="4,1" CornerRadius="2">
                                    <TextBlock Text="Valve L" Foreground="#CBD5E1" FontSize="13" FontWeight="Bold"/>
                                </Border>
                                <Border Canvas.Left="168" Canvas.Top="248" Background="#0F1A24" Padding="4,1" CornerRadius="2">
                                    <TextBlock Text="Valve R" Foreground="#64748B" FontSize="13" FontWeight="Bold"/>
                                </Border>
                                <!-- 토글 스위치 (클릭 → 출력 Y100/Y101, OFF=좌측 회색 / ON=우측 녹색) -->
                                <Button Canvas.Left="62" Canvas.Top="300" Width="56" Height="34" Cursor="Hand"
                                        Command="{Binding ToggleValveLCommand}" ToolTip="Valve L (Y100 / DO_HEAD1_LEFT_VALVE)">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="trackL" Background="#0F1A24" BorderBrush="#475569"
                                                    BorderThickness="1.5" CornerRadius="6">
                                                <Border x:Name="knobL" Width="22" Height="24" Margin="3,0,0,0"
                                                        HorizontalAlignment="Left" Background="#334155" CornerRadius="4"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsValveLOn}" Value="True">
                                                    <Setter TargetName="knobL" Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter TargetName="knobL" Property="Margin" Value="0,0,3,0"/>
                                                    <Setter TargetName="knobL" Property="Background" Value="#22C55E"/>
                                                    <Setter TargetName="trackL" Property="BorderBrush" Value="#22C55E"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Canvas.Left="172" Canvas.Top="300" Width="56" Height="34" Cursor="Hand"
                                        Command="{Binding ToggleValveRCommand}" ToolTip="Valve R (Y101 / DO_HEAD1_RIGHT_VALVE)">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="trackR" Background="#0F1A24" BorderBrush="#475569"
                                                    BorderThickness="1.5" CornerRadius="6">
                                                <Border x:Name="knobR" Width="22" Height="24" Margin="3,0,0,0"
                                                        HorizontalAlignment="Left" Background="#334155" CornerRadius="4"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsValveROn}" Value="True">
                                                    <Setter TargetName="knobR" Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter TargetName="knobR" Property="Margin" Value="0,0,3,0"/>
                                                    <Setter TargetName="knobR" Property="Background" Value="#22C55E"/>
                                                    <Setter TargetName="trackR" Property="BorderBrush" Value="#22C55E"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- ── Head (프린트 헤드) ── -->
                                <Border Canvas.Left="35" Canvas.Top="362" Width="220" Height="56"
                                        Background="#0D1726" BorderBrush="#3B82F6" BorderThickness="2" CornerRadius="6">
                                    <TextBlock Text="Head" Foreground="#93C5FD" FontSize="20" FontWeight="Bold"
                                               FontFamily="Consolas"
                                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0"/>
                                </Border>
                                <!-- 노즐 플레이트(매니폴드 면) -->
                                <Border Canvas.Left="55" Canvas.Top="418" Width="180" Height="8"
                                        Background="#0D1726" BorderBrush="#3B82F6" BorderThickness="2,0,2,2" CornerRadius="0,0,3,3"/>

                                <!-- ── 노즐 8개 + SPIT 스트림 (P&ID와 동일하게 여러 노즐 토출) ── -->
                                <Rectangle Canvas.Left="68"  Canvas.Top="424" Width="4" Height="4" Fill="#1E3A5F"/>
                                <Rectangle Canvas.Left="90"  Canvas.Top="424" Width="4" Height="4" Fill="#1E3A5F"/>
                                <Rectangle Canvas.Left="112" Canvas.Top="424" Width="4" Height="4" Fill="#1E3A5F"/>
                                <Rectangle Canvas.Left="134" Canvas.Top="424" Width="4" Height="4" Fill="#1E3A5F"/>
                                <Rectangle Canvas.Left="156" Canvas.Top="424" Width="4" Height="4" Fill="#1E3A5F"/>
                                <Rectangle Canvas.Left="178" Canvas.Top="424" Width="4" Height="4" Fill="#1E3A5F"/>
                                <Rectangle Canvas.Left="200" Canvas.Top="424" Width="4" Height="4" Fill="#1E3A5F"/>
                                <Rectangle Canvas.Left="222" Canvas.Top="424" Width="4" Height="4" Fill="#1E3A5F"/>

                                <Line Canvas.Left="70"  Canvas.Top="428" Style="{StaticResource NozzleSpitStream}" Tag="{Binding IsSpitting}"/>
                                <Line Canvas.Left="92"  Canvas.Top="428" Style="{StaticResource NozzleSpitStream}" Tag="{Binding IsSpitting}"/>
                                <Line Canvas.Left="114" Canvas.Top="428" Style="{StaticResource NozzleSpitStream}" Tag="{Binding IsSpitting}"/>
                                <Line Canvas.Left="136" Canvas.Top="428" Style="{StaticResource NozzleSpitStream}" Tag="{Binding IsSpitting}"/>
                                <Line Canvas.Left="158" Canvas.Top="428" Style="{StaticResource NozzleSpitStream}" Tag="{Binding IsSpitting}"/>
                                <Line Canvas.Left="180" Canvas.Top="428" Style="{StaticResource NozzleSpitStream}" Tag="{Binding IsSpitting}"/>
                                <Line Canvas.Left="202" Canvas.Top="428" Style="{StaticResource NozzleSpitStream}" Tag="{Binding IsSpitting}"/>
                                <Line Canvas.Left="224" Canvas.Top="428" Style="{StaticResource NozzleSpitStream}" Tag="{Binding IsSpitting}"/>
                            </Canvas>
                        </Viewbox>
                    </StackPanel>
                </Border>

                <!-- Purge / Meniscus (게이지 없이 값 + 토글) -->
                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Purge -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Purge" Style="{StaticResource SectionTitle}" FontSize="12"
                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <!-- 현재값(읽기 전용) -->
                            <Border Style="{StaticResource PosBox}" Margin="0,0,0,5">
                                <TextBlock Style="{StaticResource PosText}"
                                           Text="{Binding PurgeCurrent, StringFormat={}{0:F3} kPa}"/>
                            </Border>
                            <!-- 셋팅값(입력 + 증감) -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="22"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource PosBox}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Background="Transparent" BorderThickness="0"
                                                 Foreground="#E2E8F0" CaretBrush="#E2E8F0"
                                                 FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                                 TextAlignment="Right" VerticalContentAlignment="Center"
                                                 Text="{Binding PurgeSetpoint, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="1" Text=" kPa" Foreground="#94A3B8"
                                                   FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                                   VerticalAlignment="Center" Margin="2,0,0,0"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="3,0,0,0">
                                    <Button Style="{StaticResource StepBtn}" Height="18" Content="+" Margin="0,0,0,2"
                                            Command="{Binding PurgeStepUpCommand}"/>
                                    <Button Style="{StaticResource StepBtn}" Height="18" Content="–"
                                            Command="{Binding PurgeStepDownCommand}"/>
                                </StackPanel>
                            </Grid>
                            <Button Style="{StaticResource ActionBtn}" Height="26" Margin="0,0,0,5" Content="Set Value"
                                    Command="{Binding SetPurgeCommand}"/>
                            <Button Height="40" Content="Toggle Purge"
                                    Command="{Binding TogglePurgeCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ActionBtn}">
                                        <Setter Property="Background"  Value="#1D4ED8"/>
                                        <Setter Property="BorderBrush" Value="#3B82F6"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPurgeOn}" Value="True">
                                                <Setter Property="Background"  Value="#059669"/>
                                                <Setter Property="BorderBrush" Value="#10B981"/>
                                                <Setter Property="Content"     Value="Purge ON"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Meniscus -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Meniscus" Style="{StaticResource SectionTitle}" FontSize="12"
                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <!-- 현재값(읽기 전용) -->
                            <Border Style="{StaticResource PosBox}" Margin="0,0,0,5">
                                <TextBlock Style="{StaticResource PosText}"
                                           Text="{Binding MeniscusCurrent, StringFormat={}{0:F0} Pa}"/>
                            </Border>
                            <!-- 셋팅값(입력 + 증감) -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="22"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource PosBox}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Background="Transparent" BorderThickness="0"
                                                 Foreground="#E2E8F0" CaretBrush="#E2E8F0"
                                                 FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                                 TextAlignment="Right" VerticalContentAlignment="Center"
                                                 Text="{Binding MeniscusSetpoint, StringFormat=F0, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="1" Text=" Pa" Foreground="#94A3B8"
                                                   FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                                   VerticalAlignment="Center" Margin="2,0,0,0"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="3,0,0,0">
                                    <Button Style="{StaticResource StepBtn}" Height="18" Content="+" Margin="0,0,0,2"
                                            Command="{Binding MeniscusStepUpCommand}"/>
                                    <Button Style="{StaticResource StepBtn}" Height="18" Content="–"
                                            Command="{Binding MeniscusStepDownCommand}"/>
                                </StackPanel>
                            </Grid>
                            <Button Style="{StaticResource ActionBtn}" Height="26" Margin="0,0,0,5" Content="Set Value"
                                    Command="{Binding SetMeniscusCommand}"/>
                            <Button Height="40" Content="Toggle Meniscus"
                                    Command="{Binding ToggleMeniscusCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ActionBtn}">
                                        <Setter Property="Background"  Value="#1D4ED8"/>
                                        <Setter Property="BorderBrush" Value="#3B82F6"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMeniscusOn}" Value="True">
                                                <Setter Property="Background"  Value="#059669"/>
                                                <Setter Property="BorderBrush" Value="#10B981"/>
                                                <Setter Property="Content"     Value="Meniscus ON"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Pressure control + Status lamps -->
                <Border Grid.Column="4" Style="{StaticResource CardBorder}" Padding="10" Width="150">
                    <StackPanel>
                        <Button Height="28" Margin="0,0,0,4" Content="Final VV"
                                Command="{Binding Vv.FinalVvCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ActionBtn}">
                                    <Setter Property="Background"  Value="#1D4ED8"/>
                                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Vv.FinalVvOn}" Value="True">
                                            <Setter Property="Background"  Value="#059669"/>
                                            <Setter Property="BorderBrush" Value="#10B981"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Height="28" Margin="0,0,0,4" Content="Switching Pressure"
                                Command="{Binding Vv.SwitchingPressureCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ActionBtn}">
                                    <Setter Property="Background"  Value="#1D4ED8"/>
                                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Vv.SwitchingPressureOn}" Value="True">
                                            <Setter Property="Background"  Value="#059669"/>
                                            <Setter Property="BorderBrush" Value="#10B981"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Height="28" Margin="0,0,0,6" Content="Pump Control"
                                Command="{Binding Vv.PumpControlCommand}"
                                IsEnabled="{Binding Vv.PumpControlEnabled}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ActionBtn}">
                                    <Setter Property="Background"  Value="#1D4ED8"/>
                                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Vv.PumpControlOn}" Value="True">
                                            <Setter Property="Background"  Value="#059669"/>
                                            <Setter Property="BorderBrush" Value="#10B981"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- 상태 램프 (VV_IND: DIN 폴링으로 갱신) -->
                        <ItemsControl ItemsSource="{Binding Vv.Indicators}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border x:Name="led" Width="26" Height="12" Background="#1E293B"
                                                BorderBrush="#334155" BorderThickness="1" CornerRadius="2" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="#CBD5E1"
                                                   FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsOn}" Value="True">
                                            <Setter TargetName="led" Property="Background" Value="#22C55E"/>
                                            <Setter TargetName="led" Property="BorderThickness" Value="0"/>
                                            <Setter TargetName="led" Property="Height" Value="14"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsOn}" Value="True"/>
                                                <Condition Binding="{Binding IsAlarm}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="led" Property="Background" Value="#EF4444"/>
                                        </MultiDataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── 하단: Motion(Home/Move) | Voltage·Nozzle·Print설정 | Print 실행 ── -->
            <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>      <!-- Motion (Home/Move) -->
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.25*"/>  <!-- Voltage / Nozzle / Print 설정 -->
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>      <!-- Print 실행 -->
                    </Grid.ColumnDefinitions>

                    <!-- ① Motion (Absolute / Axis / Move) + 티칭 포인트 바로가기 -->
                    <!-- 남는 세로 공간은 Motion 카드가 흡수한다 → ②③ 카드와 바닥이 맞음.
                         (StackPanel 로 감싸면 자식이 내용 높이만 가져서 왼쪽 컬럼만 짧아진다) -->
                    <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>     <!-- Motion 카드 -->
                        <RowDefinition Height="Auto"/>  <!-- Ready / Purge -->
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="12">
                        <StackPanel>
                            <ComboBox Height="30" Background="#0D1520" Foreground="Black" BorderBrush="#334155"
                                      VerticalContentAlignment="Center" FontWeight="Bold" Margin="0,0,0,5"
                                      SelectedIndex="{Binding MotionModeIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="Absolute"/>
                                <ComboBoxItem Content="Relative"/>
                            </ComboBox>
                            <ComboBox Height="30" Background="#0D1520" Foreground="Black" BorderBrush="#334155"
                                      VerticalContentAlignment="Center" FontWeight="Bold" Margin="0,0,0,5"
                                      SelectedIndex="{Binding MotionAxisIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="Axis X"/>
                                <ComboBoxItem Content="Axis Y"/>
                                <ComboBoxItem Content="Axis Z"/>
                                <ComboBoxItem Content="Axis T"/>
                            </ComboBox>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="26"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource PosBox}" Padding="8,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Background="Transparent" BorderThickness="0"
                                                 Foreground="#E2E8F0" CaretBrush="#E2E8F0"
                                                 FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                                                 TextAlignment="Right" VerticalContentAlignment="Center"
                                                 Text="{Binding MotionTarget, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="1" Text=" mm" Foreground="#94A3B8"
                                                   FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                                   VerticalAlignment="Center" Margin="2,0,0,0"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="3,0,0,0">
                                    <Button Style="{StaticResource StepBtn}" Height="18" Content="+" Margin="0,0,0,2"
                                            Command="{Binding MotionStepUpCommand}"/>
                                    <Button Style="{StaticResource StepBtn}" Height="18" Content="–"
                                            Command="{Binding MotionStepDownCommand}"/>
                                </StackPanel>
                            </Grid>
                            <Button Style="{StaticResource ActionBtn}" Height="40"
                                    Background="#475569" BorderBrush="#64748B" Content="Move"
                                    Command="{Binding MotionMoveCommand}"
                                    IsEnabled="{Binding SelectedMotionAxis.CanMove, FallbackValue=False}"/>
                        </StackPanel>
                    </Border>

                    <!-- 티칭 포인트 바로가기 — 활성 레시피의 READY / PURGE 좌표로 전축 이동 -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="8" Margin="0,10,0,0">
                        <StackPanel>
                            <Button Style="{StaticResource ActionBtn}" Height="34" Margin="0,0,0,6"
                                    Background="#1E293B" BorderBrush="#475569" Content="Ready Position"
                                    ToolTip="활성 레시피의 READY 티칭 포인트로 이동"
                                    Command="{Binding MoveReadyCommand}"/>
                            <Button Style="{StaticResource ActionBtn}" Height="34"
                                    Background="#1E293B" BorderBrush="#475569" Content="Purge Position"
                                    ToolTip="활성 레시피의 PURGE 티칭 포인트로 이동"
                                    Command="{Binding MovePurgeCommand}"/>
                        </StackPanel>
                    </Border>
                    </Grid>

                    <!-- ② Voltage / Nozzle / Print 설정 -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="12">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,4" Style="{StaticResource MutedLabel}">
                                <Run Text="Voltage offset "/><Run Text="-25~25" Foreground="#EF4444" FontSize="9"/>
                            </TextBlock>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource PosBox}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Background="Transparent" BorderThickness="0"
                                                 Foreground="#E2E8F0" CaretBrush="#E2E8F0"
                                                 FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                                 TextAlignment="Right" VerticalContentAlignment="Center"
                                                 Text="{Binding VoltageOffset, StringFormat=F2, UpdateSourceTrigger=LostFocus}"/>
                                        <TextBlock Grid.Column="1" Text=" %" Foreground="#94A3B8"
                                                   FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                                   VerticalAlignment="Center" Margin="2,0,0,0"/>
                                    </Grid>
                                </Border>
                                <Button Grid.Column="2" Style="{StaticResource ActionBtn}" Height="28" Width="100"
                                        Background="#1D4ED8" BorderBrush="#3B82F6" Content="Set Voltage"
                                        Command="{Binding SetVoltageCommand}"/>
                            </Grid>
                            <Button Style="{StaticResource ActionBtn}" Height="28" Margin="0,0,0,5" Content="Nozzle Select"
                                    Click="NozzleSelect_Click"/>
                            <Button Height="28" Margin="0,0,0,5" Content="Spit"
                                    Command="{Binding SpitCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ActionBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSpitting}" Value="True">
                                                <Setter Property="Background"  Value="#059669"/>
                                                <Setter Property="BorderBrush"  Value="#10B981"/>
                                                <Setter Property="Content"      Value="Spit ON"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <TextBlock Text="Print data Path" Style="{StaticResource MutedLabel}" Margin="0,0,0,2"/>
                            <TextBox Style="{x:Null}" Height="26" Background="#0D1520" Foreground="White"
                                     BorderBrush="#334155" BorderThickness="1" VerticalContentAlignment="Center"
                                     Padding="6,0" Margin="0,0,0,5"
                                     Text="{Binding PrintDataPath, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Style="{StaticResource ActionBtn}" Height="28" Margin="0,0,0,5"
                                    Background="#1D4ED8" BorderBrush="#3B82F6" Content="Set Print Origin"
                                    Click="SetPrintOrigin_Click"/>
                            <Button Style="{StaticResource ActionBtn}" Height="28"
                                    Background="#1D4ED8" BorderBrush="#3B82F6" Content="Print Image Design"
                                    Click="PrintImageDesign_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- ③ Print 실행 -->
                    <Border Grid.Column="4" Style="{StaticResource CardBorder}" Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MutedLabel}" Margin="0,0,0,2"
                                       Text="Print Velocity"/>
                            <Border Style="{StaticResource PosBox}" Padding="8,6" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Background="Transparent" BorderThickness="0"
                                             Foreground="#E2E8F0" CaretBrush="#E2E8F0"
                                             FontFamily="Consolas" FontSize="15" FontWeight="Bold"
                                             TextAlignment="Right" VerticalContentAlignment="Center"
                                             Text="{Binding PrintVelocity, StringFormat=F1, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Column="1" Text=" mm/s" Foreground="#94A3B8"
                                               FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                               VerticalAlignment="Center" Margin="2,0,0,0"/>
                                </Grid>
                            </Border>
                            <Button Style="{StaticResource ActionBtn}" Height="40" Margin="0,0,0,8" Content="Load Image"
                                    Command="{Binding LoadImageCommand}"
                                    ToolTip="이미지 파일을 열어 상단 Visual Monitor 에 표시"/>

                            <!-- 불러온 이미지명/경로 — 로드 전에는 숨김 -->
                            <StackPanel Margin="0,0,0,8"
                                        Visibility="{Binding HasLoadedImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding LoadedImageName}" Foreground="#E2E8F0"
                                           FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding LoadedImagePath}"/>
                                <TextBlock Text="{Binding LoadedImagePath}" Foreground="#94A3B8"
                                           FontSize="10" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding LoadedImagePath}"/>
                            </StackPanel>
                            <Button Height="54" FontSize="22" Command="{Binding PrintCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ActionBtn}">
                                        <Setter Property="Content"     Value="Print"/>
                                        <Setter Property="Background"  Value="#059669"/>
                                        <Setter Property="BorderBrush" Value="#10B981"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPrinting}" Value="True">
                                                <Setter Property="Content"     Value="Printing…"/>
                                                <Setter Property="Background"   Value="#475569"/>
                                                <Setter Property="BorderBrush"  Value="#64748B"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Height="42" FontSize="18" Margin="0,8,0,0"
                                    Content="Stop" Command="{Binding AbortCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ActionBtn}">
                                        <Setter Property="Background"  Value="#DC2626"/>
                                        <Setter Property="BorderBrush" Value="#EF4444"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background"   Value="#3A3F4B"/>
                                                <Setter Property="BorderBrush"  Value="#4B5563"/>
                                                <Setter Property="Foreground"   Value="#6B7280"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- ── 인쇄 진행 상태(Status) ───────────────────── -->
                            <Border Margin="0,10,0,0" Padding="12,10" CornerRadius="8"
                                    Background="#1E293B" BorderBrush="#334155" BorderThickness="1">
                                <StackPanel>
                                    <!-- 상태 뱃지 + 단계 카운터 -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="4" Padding="8,2"
                                                Background="{Binding StatusBrush}">
                                            <TextBlock Text="{Binding StatusText}" FontWeight="Bold"
                                                       FontSize="12" Foreground="White"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Print Status" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" Foreground="#94A3B8"
                                                   FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="2" Text="{Binding StepLabel}"
                                                   VerticalAlignment="Center" Foreground="#E2E8F0"
                                                   FontFamily="Consolas" FontSize="13" FontWeight="Bold"/>
                                    </Grid>

                                    <!-- 진행률 바 -->
                                    <ProgressBar Height="10" Margin="0,8,0,0" Minimum="0" Maximum="100"
                                                 Value="{Binding ProgressPercent, Mode=OneWay}"
                                                 Background="#0F172A" BorderThickness="0"
                                                 Foreground="{Binding StatusBrush}"/>

                                    <!-- 현재 단계 메시지 -->
                                    <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="#CBD5E1" FontSize="13"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
        </Grid>
    </Grid>
</UserControl>
