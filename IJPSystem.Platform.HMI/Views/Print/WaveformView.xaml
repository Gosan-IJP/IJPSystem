<UserControl x:Class="IJPSystem.Platform.HMI.Views.WaveformView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:IJPSystem.Platform.HMI.Common.Controls"
             Background="#0B0F1A">

    <UserControl.Resources>

        <!-- ── 파형 구조 패널 공통 ─────────────────────────────────────── -->
        <Style x:Key="WfSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#3B82F6"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin"     Value="0,0,0,8"/>
        </Style>
        <Style x:Key="WfLabel" TargetType="TextBlock">
            <Setter Property="Foreground"         Value="#94A3B8"/>
            <Setter Property="FontSize"           Value="11"/>
            <Setter Property="VerticalAlignment"  Value="Center"/>
        </Style>
        <Style x:Key="WfUnit" TargetType="TextBlock">
            <Setter Property="Foreground"        Value="#64748B"/>
            <Setter Property="FontSize"          Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="WfBox" TargetType="TextBox">
            <Setter Property="Background"                  Value="Transparent"/>
            <Setter Property="Foreground"                  Value="#E2E8F0"/>
            <Setter Property="CaretBrush"                  Value="#E2E8F0"/>
            <Setter Property="BorderThickness"             Value="0"/>
            <Setter Property="FontFamily"                  Value="Consolas"/>
            <Setter Property="FontSize"                    Value="11"/>
            <Setter Property="TextAlignment"               Value="Right"/>
            <Setter Property="VerticalContentAlignment"    Value="Center"/>
            <Setter Property="Padding"                     Value="4,0"/>
            <Style.Triggers>
                <!-- 계산값은 회색으로 — 입력칸처럼 보이면 넣어도 안 바뀐다고 오해한다. -->
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Foreground" Value="#64748B"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WfDivider" TargetType="Rectangle">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Fill"   Value="#334155"/>
            <Setter Property="Margin" Value="0,12"/>
        </Style>
        <Style x:Key="WfMatrixHead" TargetType="TextBlock">
            <Setter Property="Foreground"          Value="#64748B"/>
            <Setter Property="FontSize"            Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- 배정표 한 칸 — 세 상태 토글의 켜짐/꺼짐만 보이면 된다. -->
        <Style x:Key="WfMatrixCell" TargetType="Button">
            <Setter Property="FontSize"   Value="9"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#0F172A" BorderBrush="#334155"
                                BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#475569"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="#1D4ED8"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WfTabs" TargetType="TabControl">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="WfTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="#0F172A" BorderBrush="#334155"
                                BorderThickness="1" CornerRadius="4,4,0,0" Padding="10,4" Margin="0,0,3,0">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="#1E293B"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 세그먼트 그리드 — 왼쪽 라벨 한 줄 + 세그먼트마다 세로 한 칸.
             MetWaveEpson 과 같은 배치라 값을 그대로 대조할 수 있다. -->
        <DataTemplate x:Key="WfSegmentGrid">
            <Border Background="#1E293B" CornerRadius="0,4,4,4" Padding="8">
                <StackPanel>
                    <!-- Segment Count + Copy pulse to — MetWaveEpson 의 펄스 탭 머리와 같은 자리 -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Segment Count" VerticalAlignment="Center"
                                   FontSize="10.5" Foreground="#94A3B8" Margin="0,0,6,0"/>
                        <ComboBox Grid.Column="1" Width="56" Height="24"
                                  ItemsSource="{Binding SegmentCountOptions}"
                                  SelectedItem="{Binding SegmentCount}"
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  HorizontalAlignment="Left" FontSize="11" FontWeight="Normal"
                                  ToolTip="마지막 Vst 복귀 구간은 그대로 두고 앞쪽이 늘거나 줄어듭니다."/>

                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="10,0,6,0"
                                   FontSize="10" Foreground="#64748B">
                            <Run Text="펄스 길이 "/><Run Text="{Binding TotalTimeText, Mode=OneWay}"/>
                        </TextBlock>

                        <Button Grid.Column="3" Height="24" Padding="8,0" Click="OnCopyPulseClick"
                                Style="{StaticResource MutedActionButtonStyle}" Background="#1E293B"
                                ToolTip="이 펄스의 값을 다른 펄스 자리로 복사합니다. GL 배정은 그대로입니다.">
                            <TextBlock Text="Copy pulse to ..." FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                            <Button.ContextMenu>
                                <ContextMenu ItemsSource="{Binding CopyTargets}">
                                    <ContextMenu.ItemContainerStyle>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Header" Value="{Binding Header}"/>
                                            <Setter Property="Command" Value="{Binding Owner.CopyPulseCommand}"/>
                                            <Setter Property="CommandParameter" Value="{Binding}"/>
                                        </Style>
                                    </ContextMenu.ItemContainerStyle>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">

                            <!-- 라벨 열 -->
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text=" "             Height="20"/>
                                <TextBlock Text="Slew (V/µs)"   Height="26" Style="{StaticResource WfLabel}"/>
                                <TextBlock Text="Slew Time (µs)" Height="26" Style="{StaticResource WfLabel}"/>
                                <TextBlock Text="Hold Voltage (V)" Height="26" Style="{StaticResource WfLabel}"/>
                                <TextBlock Text="Hold Time (µs)" Height="26" Style="{StaticResource WfLabel}"/>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Segments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="74" Margin="0,0,4,0">
                                            <TextBlock Text="{Binding Header}" Height="20" FontSize="10"
                                                       Foreground="#94A3B8" FontWeight="Bold"
                                                       HorizontalAlignment="Center"/>

                                            <!-- Step 은 그 값의 양자화 격자와 같다(기울기 0.01 · 시간·전압 0.05).
                                                 격자와 다른 폭으로 올리면 저장 직전 계산에서 다시 반올림되어
                                                 화면 숫자와 실제 값이 어긋난다. -->
                                            <ctrl:NumericSpinner Height="24" Margin="0,0,0,2"
                                                                 Value="{Binding Slew, Mode=TwoWay}"
                                                                 Step="0.01" Minimum="0"
                                                                 IsReadOnly="{Binding DataContext.Editor.IsSlewTimeEditable,
                                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                                            <ctrl:NumericSpinner Height="24" Margin="0,0,0,2"
                                                                 Value="{Binding SlewTimeUs, Mode=TwoWay}"
                                                                 Step="0.05" Minimum="0"
                                                                 IsReadOnly="{Binding DataContext.Editor.IsSlewEditable,
                                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                                            <!-- 마지막 세그먼트는 Vst 복귀가 강제라 입력을 막는다. -->
                                            <ctrl:NumericSpinner Height="24" Margin="0,0,0,2"
                                                                 Value="{Binding HoldVoltage, Mode=TwoWay}"
                                                                 Step="0.05" Minimum="0"
                                                                 IsReadOnly="{Binding IsLast}"
                                                                 ToolTip="마지막 세그먼트는 Vst 로 복귀해야 하므로 값을 바꿀 수 없습니다."/>

                                            <ctrl:NumericSpinner Height="24"
                                                                 Value="{Binding HoldTimeUs, Mode=TwoWay}"
                                                                 Step="0.05" Minimum="0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ 헤더: 타이틀 · 로드/저장 · 시리즈 토글 ══════════════════════════════════ -->
        <Border Grid.Row="0" Background="#111827" CornerRadius="12,12,0,0"
                BorderBrush="#334155" BorderThickness="1,1,1,0" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>   <!-- 제목 · 파일명 -->
                    <ColumnDefinition Width="Auto"/>   <!-- 로드 / 저장 -->
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>   <!-- 시리즈 토글 -->
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Print Spit Waveform"
                               Foreground="White" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TitleText}"
                               Foreground="#64748B" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- 파일 동작이라 파일명 옆에 둔다. 저장은 레시피에 경로만 기록한다 —
                     편집한 파형 값은 아직 파일로 나가지 않는다. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="24,0,0,0">
                    <Button Command="{Binding LoadCommand}"
                            Width="92" Height="32" Margin="0,0,8,0"
                            Style="{StaticResource MutedActionButtonStyle}"
                            Background="#1E293B">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="□" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Btn_Load}" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ApplyToRecipeCommand}"
                            Width="132" Height="32"
                            Style="{StaticResource MutedActionButtonStyle}"
                            Background="#1E293B">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="■" FontSize="11" Margin="0,0,7,0" VerticalAlignment="Center" Foreground="#3B82F6"/>
                            <TextBlock Text="{DynamicResource Btn_ApplyToRecipe}" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 시리즈 가시성 토글 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <!-- ComA -->
                    <ToggleButton IsChecked="{Binding IsComAVisible}"
                                  Margin="0,0,6,0" Padding="10,5" Cursor="Hand">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background"   Value="#1E3A5F"/>
                                <Setter Property="BorderBrush"  Value="#3B82F6"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground"   Value="#93C5FD"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="False">
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="0.85"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                        <StackPanel Orientation="Horizontal">
                            <Line X1="0" Y1="4" X2="16" Y2="4" Stroke="#3B82F6"
                                  StrokeThickness="2" StrokeDashArray="4,2"
                                  VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="ComA" FontSize="11" FontWeight="Bold"
                                       Foreground="#93C5FD" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- ComB -->
                    <ToggleButton IsChecked="{Binding IsComBVisible}"
                                  Margin="0,0,6,0" Padding="10,5" Cursor="Hand">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background"   Value="#3B1218"/>
                                <Setter Property="BorderBrush"  Value="#EF4444"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="False">
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="0.85"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                        <StackPanel Orientation="Horizontal">
                            <Line X1="0" Y1="4" X2="16" Y2="4" Stroke="#EF4444"
                                  StrokeThickness="2" StrokeDashArray="4,2"
                                  VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="ComB" FontSize="11" FontWeight="Bold"
                                       Foreground="#FCA5A5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- Vst -->
                    <ToggleButton IsChecked="{Binding IsVstVisible}"
                                  Padding="10,5" Cursor="Hand">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background"   Value="#052E16"/>
                                <Setter Property="BorderBrush"  Value="#22C55E"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="False">
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="0.85"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                        <StackPanel Orientation="Horizontal">
                            <Line X1="0" Y1="4" X2="16" Y2="4" Stroke="#22C55E"
                                  StrokeThickness="1.5" StrokeDashArray="2,3"
                                  VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Vst" FontSize="11" FontWeight="Bold"
                                       Foreground="#86EFAC" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ 차트 + 파형 구조 ═══════════════════════════════════════════
             MetWaveEpson 배치를 따른다 — 왼쪽 그래프, 오른쪽에 파형을 만드는 값들.
             그래프만 있으면 "왜 이 모양인지"를 화면에서 알 수 없다. -->
        <Border Grid.Row="1" BorderBrush="#334155" BorderThickness="1,0,1,1"
                CornerRadius="0,0,12,12" Background="#0D1117">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"    MinWidth="320"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 파형 + 그 위의 편집 명령 줄 -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ── 편집 명령 ──────────────────────────────────────
                         MetWaveEpson 의 상단 버튼 줄. 그래프 바로 위에 두어
                         "지금 보고 있는 이 파형"에 걸리는 동작임이 드러나게 한다.
                         Save 는 고친 게 있거나 아직 파일이 없을 때만 켜진다. -->
                    <Border Grid.Row="0" Background="#111827"
                            BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="10,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Command="{Binding NewCommand}"
                                    Width="106" Height="32" Margin="0,0,6,0"
                                    Style="{StaticResource MutedActionButtonStyle}" Background="#1E293B">
                                <TextBlock Text="New" FontSize="12" FontWeight="Bold" Foreground="White"/>
                            </Button>
                            <Button Command="{Binding SaveCommand}"
                                    Width="106" Height="32" Margin="0,0,6,0"
                                    Style="{StaticResource MutedActionButtonStyle}" Background="#1D4ED8">
                                <TextBlock Text="Save" FontSize="12" FontWeight="Bold" Foreground="White"/>
                            </Button>
                            <Button Command="{Binding SaveAsCommand}"
                                    Width="106" Height="32" Margin="0,0,6,0"
                                    Style="{StaticResource MutedActionButtonStyle}" Background="#1E293B">
                                <TextBlock Text="Save As" FontSize="12" FontWeight="Bold" Foreground="White"/>
                            </Button>
                            <Button Command="{Binding InsertPulseCommand}"
                                    Width="106" Height="32" Margin="0,0,6,0"
                                    Style="{StaticResource MutedActionButtonStyle}" Background="#1E293B"
                                    ToolTip="선택한 펄스 뒤에 넣습니다. GL 배정표 열도 함께 밀립니다.">
                                <TextBlock Text="Insert Pulse" FontSize="12" FontWeight="Bold" Foreground="White"/>
                            </Button>
                            <Button Command="{Binding DeletePulseCommand}"
                                    Width="106" Height="32"
                                    Style="{StaticResource MutedActionButtonStyle}" Background="#1E293B"
                                    ToolTip="선택한 펄스를 지웁니다. GL 배정표 열도 함께 당겨집니다.">
                                <TextBlock Text="Delete Pulse" FontSize="12" FontWeight="Bold" Foreground="White"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- ComA / ComB 를 위아래로 나눠 그린다. 한 그래프에 겹치면
                         선 색으로만 채널을 구분해야 해서 모양 비교가 어렵다.
                         두 그래프는 같은 시간 눈금을 쓴다(코드 비하인드에서 맞춘다). -->
                    <Grid Grid.Row="1" Margin="8,6,8,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <ctrl:WaveformChart x:Name="ChartA" Grid.Row="0"/>
                        <ctrl:WaveformChart x:Name="ChartB" Grid.Row="2"/>
                    </Grid>
                </Grid>
                <Rectangle Grid.Column="1" Fill="#334155"/>

                <ScrollViewer Grid.Column="2" Width="520" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Background="#111827">
                    <StackPanel Margin="14,12">

                        <!-- ── 파일 ──────────────────────────────────────────
                             MetWaveEpson 상단의 파일 관리부. 어떤 설정 파일을 쓰고 어느
                             폴더의 목록인지가 보여야 "왜 이 목록인지"를 화면에서 알 수 있다. -->
                        <TextBlock Text="FILE" Style="{StaticResource WfSectionTitle}"/>

                        <TextBlock Text="Meteor configuration file"
                                   Style="{StaticResource WfLabel}" Margin="0,0,0,3"/>
                        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1"
                                CornerRadius="4" Padding="7,4" Margin="0,0,0,8">
                            <TextBlock Text="{Binding MeteorConfigText}"
                                       ToolTip="{Binding MeteorConfigPath}"
                                       FontFamily="Consolas" FontSize="10.5"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                        <Style.Triggers>
                                            <!-- 이 파일이 없으면 헤드가 조용히 가상으로 떨어진다. -->
                                            <DataTrigger Binding="{Binding HasMeteorConfig}" Value="False">
                                                <Setter Property="Foreground" Value="#F59E0B"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <TextBlock Text="Waveform" Style="{StaticResource WfLabel}" Margin="0,0,0,3"/>
                        <ComboBox ItemsSource="{Binding WaveformList}"
                                  SelectedItem="{Binding SelectedWaveform}"
                                  DisplayMemberPath="DisplayName"
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  HorizontalAlignment="Stretch" Width="Auto" Height="28"
                                  FontSize="11" FontWeight="Normal" Margin="0,0,0,6"/>

                        <UniformGrid Columns="4" Margin="0,0,0,6">
                            <Button Command="{Binding ImportCommand}" Height="30" Margin="0,0,4,0"
                                    Style="{StaticResource MutedActionButtonStyle}" Background="#1E293B">
                                <TextBlock Text="Import" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </Button>
                            <Button Command="{Binding RemoveCommand}" Height="30" Margin="2,0,2,0"
                                    Style="{StaticResource MutedActionButtonStyle}" Background="#1E293B">
                                <TextBlock Text="Remove" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </Button>
                            <Button Command="{Binding RenameCommand}" Height="30" Margin="2,0,2,0"
                                    Style="{StaticResource MutedActionButtonStyle}" Background="#1E293B">
                                <TextBlock Text="Rename" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </Button>
                            <Button Command="{Binding MakeDefaultCommand}" Height="30" Margin="4,0,0,0"
                                    Style="{StaticResource MutedActionButtonStyle}" Background="#1E293B">
                                <TextBlock Text="Make Default" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </Button>
                        </UniformGrid>

                        <TextBlock Text="{Binding WaveformRoot, StringFormat='폴더: {0}'}"
                                   ToolTip="{Binding WaveformRoot}"
                                   Foreground="#64748B" FontSize="10"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>

                        <Rectangle Style="{StaticResource WfDivider}"/>

                        <!-- ── 전역 파라미터 ─────────────────────────────── -->
                        <TextBlock Text="WAVEFORM" Style="{StaticResource WfSectionTitle}"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="24"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Vst (대기 전압)"
                                       Style="{StaticResource WfLabel}"/>
                            <ctrl:NumericSpinner Grid.Row="0" Grid.Column="1" Width="86" Height="24"
                                                 Value="{Binding Editor.Vst, Mode=TwoWay}"
                                                 Step="0.05" Minimum="0"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text=" V" Style="{StaticResource WfUnit}"/>

                            <!-- 둘 중 하나는 반드시 계산값이다 — 같이 입력받으면 ΔV 와 모순된다. -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="전압 조정"
                                       Style="{StaticResource WfLabel}"/>
                            <RadioButton Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                         Content="Constant Slew" Foreground="#E2E8F0" FontSize="11"
                                         GroupName="VAdj" IsChecked="{Binding Editor.IsConstantSlew}"
                                         ToolTip="기울기를 고정하고 천이 시간을 계산합니다. Slew Time 칸은 읽기 전용이 됩니다."/>
                            <RadioButton Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                         Content="Constant Duration" Foreground="#E2E8F0" FontSize="11"
                                         GroupName="VAdj" IsChecked="{Binding Editor.IsConstantDuration}"
                                         ToolTip="천이 시간을 고정하고 기울기를 계산합니다. Slew 칸은 읽기 전용이 됩니다."/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Wfm Max Frequency"
                                       Style="{StaticResource WfLabel}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                       Text="{Binding Editor.MaxFrequencyText}"
                                       Foreground="#22C55E" FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       ToolTip="긴 쪽 채널의 한 주기로 정해집니다. 짧은 채널은 기다립니다."/>
                        </Grid>

                        <TextBlock Text="{Binding Editor.ChannelTimeText}" Foreground="#64748B"
                                   FontFamily="Consolas" FontSize="10" Margin="0,0,0,6"/>

                        <!-- Scale Voltage — Vst 는 두고 진폭만 배율로 바꾼다. -->
                        <Button Command="{Binding ScaleVoltageCommand}"
                                Height="28" Margin="0,0,0,8" HorizontalAlignment="Stretch"
                                Style="{StaticResource MutedActionButtonStyle}" Background="#1E293B"
                                ToolTip="Vst 기준 진폭을 %로 키우거나 줄입니다. 대기 전압은 그대로 둡니다.">
                            <TextBlock Text="Scale Voltage" FontSize="11" FontWeight="Bold" Foreground="White"/>
                        </Button>

                        <!-- 저장은 파일에 쓴다. 다만 헤드로 내려보내는 경로는 아직 없다 —
                             이 사실을 안 적어 두면 저장했는데 토출이 안 바뀐 이유를 화면에서 못 찾는다. -->
                        <Border Background="#1E293B" CornerRadius="4" Padding="8,5" Margin="0,0,0,8">
                            <TextBlock Foreground="#F59E0B" FontSize="10" TextWrapping="Wrap"
                                       Text="Save 는 파형 파일(.ComA/.ComB)에 씁니다. 다만 저장한 파형을 헤드로 전송하는 기능은 아직 없습니다 — 장비에 반영하려면 PCC 설정을 다시 읽혀야 합니다."/>
                        </Border>

                        <!-- Com A/B · 노즐 행 모드 — MetWaveEpson 과 같이 라디오 두 벌.
                             둘 중 하나만 성립하는 값이라 체크박스보다 라디오가 맞다. -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Text="Com A/B mode"
                                       Style="{StaticResource WfLabel}" VerticalAlignment="Center"/>
                            <RadioButton Grid.Row="0" Grid.Column="1" Content="Synchronous"
                                         Foreground="#E2E8F0" FontSize="11" GroupName="ComAb"
                                         IsChecked="{Binding Editor.IsSynchronous}"
                                         ToolTip="ComB 를 ComA 의 복제로 둡니다. ComB 를 따로 편집해도 저장 시 덮어써집니다."/>
                            <RadioButton Grid.Row="1" Grid.Column="1" Content="Independent"
                                         Foreground="#E2E8F0" FontSize="11" GroupName="ComAb"
                                         IsChecked="{Binding Editor.IsIndependent}"
                                         ToolTip="ComA 와 ComB 를 따로 편집합니다."/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Grid.RowSpan="2" Text="Nozzle Row A/B mode"
                                       Style="{StaticResource WfLabel}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <RadioButton Grid.Row="3" Grid.Column="1" Content="Single colour"
                                         Foreground="#E2E8F0" FontSize="11" GroupName="NozzleRow"
                                         IsChecked="{Binding Editor.IsSingleColour}"
                                         ToolTip="노즐 행 A/B 가 같은 잉크입니다."/>
                            <RadioButton Grid.Row="4" Grid.Column="1" Content="Dual colour"
                                         Foreground="#E2E8F0" FontSize="11" GroupName="NozzleRow"
                                         IsChecked="{Binding Editor.IsDualColour}"
                                         ToolTip="노즐 행 A/B 를 서로 다른 잉크로 다룹니다."/>
                        </Grid>

                        <!-- Graph Highlight — 고른 펄스만 남기고 그래프를 어둡게 덮는다. -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Graph Highlight"
                                       Style="{StaticResource WfLabel}"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Editor.HighlightOptions}"
                                      SelectedItem="{Binding Editor.SelectedHighlight}"
                                      DisplayMemberPath="Header"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      HorizontalAlignment="Stretch" Width="Auto" Height="26"
                                      FontSize="11" FontWeight="Normal"
                                      ToolTip="고른 펄스 구간만 밝게 두고 나머지를 덮습니다. 파형은 바뀌지 않습니다."/>
                        </Grid>

                        <Rectangle Style="{StaticResource WfDivider}"/>

                        <!-- ── GL × Pulse 배정표 ─────────────────────────── -->
                        <TextBlock Text="GREY LEVEL × PULSE" Style="{StaticResource WfSectionTitle}"/>
                        <TextBlock Text="그레이 레벨마다 어느 펄스를 어느 Com 라인으로 쏠지 — 액적 크기를 정합니다."
                                   Foreground="#64748B" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <UniformGrid Grid.Column="1" Columns="4">
                                <TextBlock Text="Pulse 1" Style="{StaticResource WfMatrixHead}"/>
                                <TextBlock Text="Pulse 2" Style="{StaticResource WfMatrixHead}"/>
                                <TextBlock Text="Pulse 3" Style="{StaticResource WfMatrixHead}"/>
                                <TextBlock Text="Pulse 4" Style="{StaticResource WfMatrixHead}"/>
                            </UniformGrid>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Editor.GreyLevelRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Header}"
                                                   Foreground="#94A3B8" FontSize="11" FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Columns="8"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Label}" Height="22" Margin="1"
                                                            Style="{StaticResource WfMatrixCell}"
                                                            Command="{Binding DataContext.Editor.ToggleGreyLevelCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 배정이 없는 GL 은 토출 자체가 안 되는데 화면에는 이상이 없어 보인다. -->
                        <Border Background="#1E293B" CornerRadius="4" Padding="8,5" Margin="0,6,0,0"
                                Visibility="{Binding Editor.HasUnassignedGreyLevel,
                                             Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding Editor.UnassignedGreyLevelsText}"
                                       Foreground="#FCD34D" FontSize="10" TextWrapping="Wrap"/>
                        </Border>

                        <Rectangle Style="{StaticResource WfDivider}"/>

                        <!-- ── 세그먼트 ──────────────────────────────────── -->
                        <TextBlock Text="SEGMENTS · ComA" Style="{StaticResource WfSectionTitle}"/>
                        <TabControl ItemsSource="{Binding Editor.ComAPulses}"
                                    SelectedItem="{Binding Editor.SelectedComAPulse}"
                                    Style="{StaticResource WfTabs}"
                                    ItemContainerStyle="{StaticResource WfTabItem}"
                                    ContentTemplate="{StaticResource WfSegmentGrid}"
                                    DisplayMemberPath="Header"/>

                        <TextBlock Text="SEGMENTS · ComB" Style="{StaticResource WfSectionTitle}" Margin="0,12,0,8"/>
                        <TabControl ItemsSource="{Binding Editor.ComBPulses}"
                                    SelectedItem="{Binding Editor.SelectedComBPulse}"
                                    IsEnabled="{Binding Editor.IsComBEditable}"
                                    Style="{StaticResource WfTabs}"
                                    ItemContainerStyle="{StaticResource WfTabItem}"
                                    ContentTemplate="{StaticResource WfSegmentGrid}"
                                    DisplayMemberPath="Header"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
