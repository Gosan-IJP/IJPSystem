<Window x:Class="IJPSystem.Platform.HMI.Views.GvcLiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GVC LIVE"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        SizeToContent="Manual"
        Background="#0B0F1A">

    <Border Background="#0B0F1A" BorderBrush="#3B82F6" BorderThickness="1.5" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="24"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 제목줄 — 끌어서 옮길 수 있다. 화면을 가리면 치우면 되지, 끄게 만들 이유는 없다. -->
            <Border Grid.Row="0" Background="#1E293B" CornerRadius="5,5,0,0"
                    MouseLeftButtonDown="OnHeaderDrag">
                <Grid>
                    <TextBlock Text="GVC  ·  GLASS VIEW" Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#94A3B8" FontFamily="Consolas"
                               FontSize="10" FontWeight="Bold"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="#22C55E"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="StateText" Text="LIVE" Margin="5,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#22C55E" FontFamily="Consolas"
                                   FontSize="10" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Background="#060C18">
                <Image x:Name="LiveImage" Stretch="Uniform" Margin="2"
                       RenderOptions.BitmapScalingMode="LowQuality"/>

                <!-- 프레임이 아직 없을 때. 검은 사각형만 띄워 두면 고장인지 대기인지 알 수 없다. -->
                <TextBlock x:Name="WaitText" Text="카메라 연결 대기"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#475569" FontFamily="Consolas" FontSize="11"/>
            </Grid>
        </Grid>
    </Border>
</Window>
