<UserControl x:Class="IJPSystem.Platform.HMI.Views.RecipeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:cvt="clr-namespace:IJPSystem.Platform.HMI.Common.Converters"
             mc:Ignorable="d" d:DesignHeight="750" d:DesignWidth="1200"
             Background="#0F172A">
    <UserControl.Resources>
        <!-- ── 이 파일에서만 쓰는 스타일 ── -->
        <cvt:PrintAxisValueConverter x:Key="PrintAxisValueConverter"/>
        <cvt:IsScanAxisConverter     x:Key="IsScanAxisConverter"/>

        <Style x:Key="RecipeColumnHeaderStyle" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource CommonColumnHeaderStyle}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height"   Value="45"/>
        </Style>
        <Style x:Key="RecipeCompareCellStyle" TargetType="DataGridCell"
               BasedOn="{StaticResource CompareCellStyle}">
            <Setter Property="FontSize"                   Value="15"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
        </Style>

        <!-- PRINT 열 전용 셀 스타일 — 스캔축(Y)이 아니면 편집 잠금 + 흐리게(해당 없음).
             인쇄 프로파일은 Y축만 사용하므로 X/Z/T 행의 PRINT 칸은 편집할 수 없다. -->
        <Style x:Key="PrintCellStyle" TargetType="DataGridCell"
               BasedOn="{StaticResource RecipeCompareCellStyle}">
            <Style.Triggers>
                <DataTrigger Value="False"
                             Binding="{Binding Info.AxisNo, Converter={StaticResource IsScanAxisConverter}}">
                    <Setter Property="IsEnabled"  Value="False"/>
                    <Setter Property="Foreground" Value="#475569"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NumericEditingStyle" TargetType="TextBox">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="15"/>
            <EventSetter Event="PreviewTextInput" Handler="TextBox_PreviewTextInput"/>
            <EventSetter Event="PreviewKeyDown" Handler="TextBox_PreviewKeyDown"/>
            <EventSetter Event="GotFocus" Handler="TextBox_GotFocus"/>
            <Style.Triggers>
                <!-- 미사용 축(AxisUsed=false → IsEnabled=false) 표시: 어두운 적갈색 + 흐린 텍스트
                     기본 WPF disabled 회색보다 명확히 "사용 안함"임을 인식할 수 있게 한다 -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background"  Value="#3F1D1D"/>
                    <Setter Property="BorderBrush" Value="#7F1D1D"/>
                    <Setter Property="Foreground"  Value="#FCA5A5"/>
                    <Setter Property="Opacity"     Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- ── 노즐/글라스 정보 입력 칸 ──────────────────────────────────────────
             라벨·입력상자·단위 3요소가 반복되므로 스타일로 묶는다.
             ※ 반드시 NumericEditingStyle <b>뒤에</b> 두어야 한다 — StaticResource 는 같은
               딕셔너리에서 <b>앞에 정의된 것만</b> 찾는다. 위쪽에 뒀다가 레시피 화면 진입 시
               'NumericEditingStyle 을 찾을 수 없음' 으로 앱이 죽었다(2026-08-07). -->
        <Style x:Key="SpecFieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground"        Value="#94A3B8"/>
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width"             Value="104"/>
            <Setter Property="Margin"            Value="0,4,10,4"/>
        </Style>
        <Style x:Key="SpecFieldBox" TargetType="Border">
            <Setter Property="Background"      Value="#0F172A"/>
            <Setter Property="BorderBrush"     Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Width"           Value="104"/>
            <Setter Property="Height"          Value="30"/>
            <Setter Property="Margin"          Value="0,4"/>
        </Style>
        <Style x:Key="SpecTextBox" TargetType="TextBox" BasedOn="{StaticResource NumericEditingStyle}">
            <Setter Property="Foreground"                Value="White"/>
            <Setter Property="Background"                Value="Transparent"/>
            <Setter Property="BorderThickness"           Value="0"/>
            <Setter Property="FontSize"                  Value="14"/>
            <Setter Property="FontFamily"                Value="Consolas"/>
            <Setter Property="TextAlignment"             Value="Right"/>
            <Setter Property="VerticalContentAlignment"  Value="Center"/>
            <Setter Property="Padding"                   Value="8,0"/>
            <Setter Property="CaretBrush"                Value="White"/>
        </Style>
        <Style x:Key="SpecUnit" TargetType="TextBlock">
            <Setter Property="Foreground"        Value="#64748B"/>
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="6,0,14,0"/>
        </Style>

        <Style x:Key="NumericDisplayStyle" TargetType="TextBlock">
            <Setter Property="FontSize"             Value="15"/>
            <Setter Property="HorizontalAlignment"  Value="Center"/>
            <Setter Property="VerticalAlignment"    Value="Center"/>
            <Setter Property="TextAlignment"        Value="Center"/>
        </Style>
    </UserControl.Resources>
    
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1E293B" CornerRadius="12" Margin="0,0,20,0" BorderBrush="#334155" BorderThickness="1">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="5,0,0,15">
                    <TextBlock Text="📋" Foreground="#3B82F6" Margin="0,0,8,0" FontSize="16"/>
                    <TextBlock Text="RECIPE MODELS" Foreground="White" FontWeight="Bold" FontSize="14"/>
                </StackPanel>

                <ListBox Grid.Row="1" ItemsSource="{Binding RecipeNames}" 
                         SelectedItem="{Binding SelectedRecipeName}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" d:ItemsSource="{d:SampleData ItemCount=5}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder" Background="#111827" CornerRadius="6" Padding="12,10">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#1A2233"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#1D4ED8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                
                <UniformGrid Grid.Row="2" Rows="3" Columns="2" Margin="0,15,0,0">
                    <Button Content="{DynamicResource Btn_Add}"
                            FontSize="12" Padding="0" Width="110"
                            Command="{Binding CreateRecipeCommand}"
                            Style="{StaticResource MainDashboardButtonStyle}"
                            Height="38" Margin="0,0,2,2" Background="#059669"/>

                    <Button Content="{DynamicResource Btn_Copy}"
                            FontSize="12" Padding="0" Width="110"
                            Command="{Binding CopyRecipeCommand}"
                            Style="{StaticResource MainDashboardButtonStyle}"
                            Height="38" Margin="2,0,0,2" Background="#334155"/>

                    <Button Content="{DynamicResource Btn_Edit}"
                            FontSize="12" Padding="0" Width="110"
                            Command="{Binding RenameRecipeCommand}"
                            Style="{StaticResource MainDashboardButtonStyle}"
                            Height="38" Margin="0,2,2,2" Background="#334155"/>

                    <Button Content="{DynamicResource Btn_Delete}"
                            FontSize="12" Padding="0" Width="110"
                            Command="{Binding DeleteRecipeCommand}"
                            Style="{StaticResource MainDashboardButtonStyle}"
                            Height="38" Margin="2,2,0,2" Background="#DC2626"/>

                    <Button Content="{DynamicResource Btn_MoveUp}"
                            FontSize="12" Padding="0" Width="110"
                            Command="{Binding MoveRecipeUpCommand}"
                            Style="{StaticResource MainDashboardButtonStyle}"
                            Height="38" Margin="0,2,2,0" Background="#334155"/>

                    <Button Content="{DynamicResource Btn_MoveDown}"
                            FontSize="12" Padding="0" Width="110"
                            Command="{Binding MoveRecipeDownCommand}"
                            Style="{StaticResource MainDashboardButtonStyle}"
                            Height="38" Margin="2,2,0,0" Background="#334155"/>
                </UniformGrid>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
        
            <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="15,10" Margin="0,0,0,15" BorderBrush="#334155" BorderThickness="1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#064E3B" Padding="10,5" CornerRadius="6" Margin="0,0,25,0" BorderBrush="#22C55E" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="● RUNNING :" Foreground="#22C55E" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ActiveRecipeName}" Foreground="White" FontSize="15" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="EDITING :" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedRecipeName}" Foreground="#FCD34D" FontSize="20" FontWeight="Black" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="*" Foreground="#F59E0B" FontSize="24" FontWeight="Bold" Margin="5,-5,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="⚙️" Foreground="#3B82F6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding AxisList.Count, StringFormat='Axes: {0}'}" Foreground="White" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>

                        <Border Width="1" Background="#334155" Margin="16,4"/>

                        <!-- 가동 모델로 지정 (편집한 선택 모델을 설비 가동 모델로 지정) -->
                        <Button Command="{Binding ApplyRecipeCommand}"
                                Style="{StaticResource MainDashboardButtonStyle}"
                                ToolTip="{DynamicResource Btn_ApplyToMachine_Tip}"
                                Height="34" Padding="14,0" Background="#1D4ED8" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🚀" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Btn_ApplyToMachine}" FontWeight="Bold"
                                           FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <!-- ── 모터 파라미터 ─────────────────────────────────────── -->
                <Border Background="#111827" CornerRadius="8"
                        BorderBrush="#334155" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentDataType}" Value="Teach">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentDataType}" Value="Other">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DataGrid ItemsSource="{Binding AxisList}"
                              AutoGenerateColumns="False"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="False"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Standard"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              Background="Transparent" Foreground="White"
                              BorderThickness="0" BorderBrush="Transparent"
                              RowHeaderWidth="0" HeadersVisibility="Column"
                              RowHeight="42" ColumnHeaderHeight="42"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#2D3748"
                              RowBackground="#111827"
                              AlternatingRowBackground="#1A2233"
                              SelectionMode="Single"
                              ColumnHeaderStyle="{StaticResource RecipeColumnHeaderStyle}"
                              HorizontalScrollBarVisibility="Visible"
                              VerticalScrollBarVisibility="Auto"
                              GotFocus="DataGrid_GotFocus"
                              CellEditEnding="DataGrid_CellEditEnding">
                        <DataGrid.Resources>
                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ModernScrollBarStyle}"/>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="AXIS"
                                                Binding="{Binding Info.AxisNo}"
                                                IsReadOnly="True" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize"            Value="14"/>
                                        <Setter Property="FontWeight"          Value="Bold"/>
                                        <Setter Property="Foreground"          Value="#93C5FD"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment"   Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Move VEL"
                                                ElementStyle="{StaticResource NumericDisplayStyle}"
                                                EditingElementStyle="{StaticResource NumericEditingStyle}"
                                                Binding="{Binding Info.MotionConfig.Move.Velocity,          UpdateSourceTrigger=LostFocus}"
                                                CellStyle="{StaticResource RecipeCompareCellStyle}" Width="110"/>
                            <DataGridTextColumn Header="Move ACC"
                                                ElementStyle="{StaticResource NumericDisplayStyle}"
                                                EditingElementStyle="{StaticResource NumericEditingStyle}"
                                                Binding="{Binding Info.MotionConfig.Move.Acceleration,      UpdateSourceTrigger=LostFocus}"
                                                CellStyle="{StaticResource RecipeCompareCellStyle}" Width="110"/>
                            <DataGridTextColumn Header="Move DEC"
                                                ElementStyle="{StaticResource NumericDisplayStyle}"
                                                EditingElementStyle="{StaticResource NumericEditingStyle}"
                                                Binding="{Binding Info.MotionConfig.Move.Deceleration,      UpdateSourceTrigger=LostFocus}"
                                                CellStyle="{StaticResource RecipeCompareCellStyle}" Width="110"/>
                            <DataGridTextColumn Header="JOG VEL"
                                                ElementStyle="{StaticResource NumericDisplayStyle}"
                                                EditingElementStyle="{StaticResource NumericEditingStyle}"
                                                Binding="{Binding Info.MotionConfig.Jog.Velocity,           UpdateSourceTrigger=LostFocus}"
                                                CellStyle="{StaticResource RecipeCompareCellStyle}" Width="110"/>
                            <DataGridTextColumn Header="JOG ACC"
                                                ElementStyle="{StaticResource NumericDisplayStyle}"
                                                EditingElementStyle="{StaticResource NumericEditingStyle}"
                                                Binding="{Binding Info.MotionConfig.Jog.Acceleration,       UpdateSourceTrigger=LostFocus}"
                                                CellStyle="{StaticResource RecipeCompareCellStyle}" Width="110"/>
                            <DataGridTextColumn Header="JOG DEC"
                                                ElementStyle="{StaticResource NumericDisplayStyle}"
                                                EditingElementStyle="{StaticResource NumericEditingStyle}"
                                                Binding="{Binding Info.MotionConfig.Jog.Deceleration,       UpdateSourceTrigger=LostFocus}"
                                                CellStyle="{StaticResource RecipeCompareCellStyle}" Width="110"/>
                            <!-- PRINT VEL/ACC/DEC — 인쇄 프로파일은 스캔축(Y)만 사용.
                                 X/Z/T 행은 "–"로 표시하고 편집 잠금(PrintCellStyle). Y만 값 표시·편집. -->
                            <DataGridTemplateColumn Header="PRINT VEL (Y)" Width="110"
                                                    CellStyle="{StaticResource PrintCellStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource NumericDisplayStyle}">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource PrintAxisValueConverter}">
                                                    <Binding Path="Info.AxisNo"/>
                                                    <Binding Path="Info.MotionConfig.Printing.Velocity"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{StaticResource NumericEditingStyle}"
                                                 Text="{Binding Info.MotionConfig.Printing.Velocity, UpdateSourceTrigger=LostFocus}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="PRINT ACC (Y)" Width="110"
                                                    CellStyle="{StaticResource PrintCellStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource NumericDisplayStyle}">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource PrintAxisValueConverter}">
                                                    <Binding Path="Info.AxisNo"/>
                                                    <Binding Path="Info.MotionConfig.Printing.Acceleration"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{StaticResource NumericEditingStyle}"
                                                 Text="{Binding Info.MotionConfig.Printing.Acceleration, UpdateSourceTrigger=LostFocus}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="PRINT DEC (Y)" Width="110"
                                                    CellStyle="{StaticResource PrintCellStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource NumericDisplayStyle}">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource PrintAxisValueConverter}">
                                                    <Binding Path="Info.AxisNo"/>
                                                    <Binding Path="Info.MotionConfig.Printing.Deceleration"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{StaticResource NumericEditingStyle}"
                                                 Text="{Binding Info.MotionConfig.Printing.Deceleration, UpdateSourceTrigger=LostFocus}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- ── Purge 시간 설정 (OTHER INFO) ──────────────────────── -->
                <Border Background="#111827" CornerRadius="8"
                        BorderBrush="#334155" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentDataType}" Value="Other">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <!-- 왼쪽 열: Purge Time(위) + 프린트 설정(아래). Purge 가 세로를 다 쓰고 있어
                         오른쪽이 통째로 비어 있었다 → Purge 를 위쪽 절반만 쓰게 하고, 비운 자리에
                         프린트 설정을 내려 두고, 남은 오른쪽을 노즐/글라스 정보가 채운다. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>  <!-- Purge + 프린트 설정 -->
                            <ColumnDefinition Width="*"/>     <!-- 노즐 / 글라스 정보 -->
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- ── Purge Time 카드 (왼쪽 위) ── -->
                        <Border Grid.Column="0" Grid.Row="0" Background="#1E293B" CornerRadius="10"
                                BorderBrush="#334155" BorderThickness="1" Width="300"
                                Margin="20,20,20,10" Padding="16">
                            <StackPanel VerticalAlignment="Center">

                                <!-- 타이틀 — 값 표시와 한 줄에 두어 세로를 줄인다 -->
                                <DockPanel Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⏱" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="PURGE TIME" Foreground="White"
                                                   FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- 현재 값 표시 -->
                                    <Border Background="#0F172A" CornerRadius="8"
                                            BorderBrush="#3B82F6" BorderThickness="2"
                                            Padding="12,4" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding PurgeTime}"
                                                       Foreground="#60A5FA" FontSize="26" FontWeight="Black"
                                                       FontFamily="Consolas" VerticalAlignment="Center"/>
                                            <TextBlock Text=" sec" Foreground="#64748B"
                                                       FontSize="13" FontWeight="Bold"
                                                       VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                        </StackPanel>
                                    </Border>
                                </DockPanel>

                                <!-- 슬라이더 -->
                                <Slider Minimum="0" Maximum="60"
                                        IsSnapToTickEnabled="False"
                                        Value="{Binding PurgeTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="4,0,4,4" Height="26">
                                    <Slider.Style>
                                        <Style TargetType="Slider">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Slider">
                                                        <Grid>
                                                            <Border Height="6" CornerRadius="3"
                                                                    Background="#0F172A" BorderBrush="#334155" BorderThickness="1"
                                                                    VerticalAlignment="Center"/>
                                                            <Track x:Name="PART_Track">
                                                                <Track.DecreaseRepeatButton>
                                                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                                                  Background="Transparent" BorderThickness="0" Opacity="0"/>
                                                                </Track.DecreaseRepeatButton>
                                                                <Track.Thumb>
                                                                    <Thumb Cursor="Hand">
                                                                        <Thumb.Template>
                                                                            <ControlTemplate TargetType="Thumb">
                                                                                <Ellipse Fill="#3B82F6" Stroke="#93C5FD" StrokeThickness="2"
                                                                                         Width="20" Height="20">
                                                                                    <Ellipse.Effect>
                                                                                        <DropShadowEffect Color="#3B82F6" BlurRadius="8" ShadowDepth="0"/>
                                                                                    </Ellipse.Effect>
                                                                                </Ellipse>
                                                                            </ControlTemplate>
                                                                        </Thumb.Template>
                                                                    </Thumb>
                                                                </Track.Thumb>
                                                                <Track.IncreaseRepeatButton>
                                                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                                                  Background="Transparent" BorderThickness="0" Opacity="0"/>
                                                                </Track.IncreaseRepeatButton>
                                                            </Track>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Slider.Style>
                                </Slider>

                                <!-- 눈금 레이블 -->
                                <Grid Margin="4,0,4,16">
                                    <TextBlock Text="0" Foreground="#475569" FontSize="10" FontFamily="Consolas" HorizontalAlignment="Left"/>
                                    <TextBlock Text="30" Foreground="#475569" FontSize="10" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                    <TextBlock Text="60" Foreground="#475569" FontSize="10" FontFamily="Consolas" HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- 직접 입력 -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="직접 입력" Foreground="#64748B" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Border BorderBrush="#475569" BorderThickness="1" CornerRadius="6"
                                            Background="#0F172A" Width="60">
                                        <TextBox Text="{Binding PurgeTime, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Foreground="White" Background="Transparent"
                                                 BorderThickness="0" FontSize="15" FontFamily="Consolas"
                                                 TextAlignment="Center" VerticalContentAlignment="Center"
                                                 Padding="0,5"
                                                 Style="{StaticResource NumericEditingStyle}"/>
                                    </Border>
                                    <TextBlock Text=" sec" Foreground="#64748B" FontSize="12"
                                               VerticalAlignment="Center" Margin="5,0,0,0"/>
                                </StackPanel>

                            </StackPanel>
                        </Border>

                        <!-- ── 프린트 설정 카드 (Purge 를 줄여 비운 자리) ── -->
                        <Border Grid.Column="0" Grid.Row="1" Background="#1E293B" CornerRadius="10"
                                BorderBrush="#334155" BorderThickness="1" Width="300"
                                Margin="20,0,20,20" Padding="16"
                                VerticalAlignment="Top">
                            <StackPanel>
                                <!-- 타이틀 -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                    <TextBlock Text="🖨" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Lbl_PrintSettings}" Foreground="White"
                                               FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- 프린팅수 (Swath) -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="{DynamicResource Lbl_Swath}" Foreground="#94A3B8" FontSize="13"
                                               Width="118" VerticalAlignment="Center"/>
                                    <ComboBox Width="110" Height="32"
                                              Style="{StaticResource ModernComboBoxStyle}"
                                              ItemsSource="{Binding SwathOptions}"
                                              SelectedItem="{Binding SwathCount, Mode=TwoWay}"/>
                                </StackPanel>

                                <!-- Head 길이 (mm) -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="{DynamicResource Lbl_HeadLength}" Foreground="#94A3B8" FontSize="13"
                                               Width="118" VerticalAlignment="Center"/>
                                    <Border BorderBrush="#475569" BorderThickness="1" CornerRadius="6"
                                            Background="#0F172A" Width="110" Height="32">
                                        <TextBox Text="{Binding HeadLength, Mode=TwoWay, StringFormat={}{0:F3}, UpdateSourceTrigger=LostFocus}"
                                                 Foreground="White" Background="Transparent" BorderThickness="0"
                                                 FontSize="15" FontFamily="Consolas"
                                                 VerticalContentAlignment="Center" Padding="8,0"
                                                 Style="{StaticResource NumericEditingStyle}"/>
                                    </Border>
                                    <TextBlock Text=" mm" Foreground="#64748B" FontSize="13"
                                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>

                                <!-- 프린팅 방향 (0=단방향, 1=양방향) -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Lbl_PrintDirection}" Foreground="#94A3B8" FontSize="13"
                                               Width="118" VerticalAlignment="Center"/>
                                    <ComboBox Width="110" Height="32"
                                              Style="{StaticResource ModernComboBoxStyle}"
                                              SelectedIndex="{Binding PrintDirectionIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="{DynamicResource Opt_Unidirectional}"/>
                                        <ComboBoxItem Content="{DynamicResource Opt_Bidirectional}"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ── 노즐 정보 / 글라스 정보 (오른쪽 빈 공간) ──────────────────
                             헤드 사양과 글라스 치수를 레시피에 함께 둔다. 헤드를 바꾸면 피치·열
                             구성이 통째로 달라지고 인쇄 조건도 같이 바뀌므로, 한 곳에 묶여 있어야
                             헤드 교체가 레시피 전환으로 끝난다.
                             값 0 = 미입력이며, 아직 어떤 동작에도 쓰이지 않는다(입력·보관만). -->
                        <ScrollViewer Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
                                      VerticalScrollBarVisibility="Auto" Margin="0,20,20,20">
                            <ScrollViewer.Resources>
                                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ModernScrollBarStyle}"/>
                            </ScrollViewer.Resources>
                            <StackPanel>

                                <!-- 노즐 정보 -->
                                <Border Background="#1E293B" CornerRadius="10"
                                        BorderBrush="#334155" BorderThickness="1"
                                        Padding="16" Margin="0,0,0,12" HorizontalAlignment="Left" MinWidth="420">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <TextBlock Text="◇" FontSize="14" Foreground="#38BDF8"
                                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="노즐 정보" Foreground="White"
                                                       FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <!-- 이 값들은 레시피가 아니라 장비에 딸린다. 여기서 고치면
                                                 모든 레시피에 적용되므로 그 사실을 화면에 밝혀 둔다. -->
                                            <Border Background="#0B2A45" BorderBrush="#1D4ED8" BorderThickness="1"
                                                    CornerRadius="4" Padding="6,1" Margin="10,1,0,0"
                                                    VerticalAlignment="Center"
                                                    ToolTip="헤드는 장비에 달린 것이라 레시피를 바꿔도 그대로입니다. 드랍와처 화면도 같은 값을 씁니다.">
                                                <TextBlock Text="장비 공통" Foreground="#93C5FD" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="노즐 피치"
                                                       Style="{StaticResource SpecFieldLabel}"/>
                                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                                <Border Style="{StaticResource SpecFieldBox}">
                                                    <TextBox Text="{Binding NozzlePitchUm, Mode=TwoWay, StringFormat={}{0:F1}, UpdateSourceTrigger=LostFocus}"
                                                             Style="{StaticResource SpecTextBox}"/>
                                                </Border>
                                                <TextBlock Text="µm" Style="{StaticResource SpecUnit}"/>
                                                <TextBlock Text="같은 열 안 인접 노즐 간 거리"
                                                           Foreground="#475569" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="노즐 열 수"
                                                       Style="{StaticResource SpecFieldLabel}"/>
                                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                                <ComboBox Width="110" Height="30" Margin="0,4"
                                                          Style="{StaticResource ModernComboBoxStyle}"
                                                          ItemsSource="{Binding NozzleRowOptions}"
                                                          SelectedItem="{Binding NozzleRows, Mode=TwoWay}"/>
                                                <TextBlock Text="열" Style="{StaticResource SpecUnit}"/>
                                            </StackPanel>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="열 간격"
                                                       Style="{StaticResource SpecFieldLabel}"/>
                                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                                <Border Style="{StaticResource SpecFieldBox}">
                                                    <TextBox Text="{Binding NozzleRowPitchUm, Mode=TwoWay, StringFormat={}{0:F1}, UpdateSourceTrigger=LostFocus}"
                                                             Style="{StaticResource SpecTextBox}"/>
                                                </Border>
                                                <TextBlock Text="µm" Style="{StaticResource SpecUnit}"/>
                                                <TextBlock Text="1열 헤드는 사용 안 함"
                                                           Foreground="#475569" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="노즐 구경"
                                                       Style="{StaticResource SpecFieldLabel}"/>
                                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                                <Border Style="{StaticResource SpecFieldBox}">
                                                    <TextBox Text="{Binding NozzleDiameterUm, Mode=TwoWay, StringFormat={}{0:F1}, UpdateSourceTrigger=LostFocus}"
                                                             Style="{StaticResource SpecTextBox}"/>
                                                </Border>
                                                <TextBlock Text="µm" Style="{StaticResource SpecUnit}"/>
                                            </StackPanel>

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="총 노즐 수"
                                                       Style="{StaticResource SpecFieldLabel}"/>
                                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                                <Border Style="{StaticResource SpecFieldBox}">
                                                    <TextBox Text="{Binding NozzleCount, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                             Style="{StaticResource SpecTextBox}"/>
                                                </Border>
                                                <TextBlock Text="개" Style="{StaticResource SpecUnit}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 글라스 정보 -->
                                <Border Background="#1E293B" CornerRadius="10"
                                        BorderBrush="#334155" BorderThickness="1"
                                        Padding="16" HorizontalAlignment="Left" MinWidth="420">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <TextBlock Text="▭" FontSize="14" Foreground="#A78BFA"
                                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="글라스 정보" Foreground="White"
                                                       FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock Text="인쇄 대상 치수" Foreground="#475569" FontSize="11"
                                                       VerticalAlignment="Center" Margin="10,1,0,0"/>
                                        </StackPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="가로 × 세로"
                                                       Style="{StaticResource SpecFieldLabel}"/>
                                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                                <Border Style="{StaticResource SpecFieldBox}">
                                                    <TextBox Text="{Binding GlassWidthMm, Mode=TwoWay, StringFormat={}{0:F2}, UpdateSourceTrigger=LostFocus}"
                                                             Style="{StaticResource SpecTextBox}"/>
                                                </Border>
                                                <TextBlock Text="×" Foreground="#64748B" FontSize="13"
                                                           VerticalAlignment="Center" Margin="8,0"/>
                                                <Border Style="{StaticResource SpecFieldBox}">
                                                    <TextBox Text="{Binding GlassHeightMm, Mode=TwoWay, StringFormat={}{0:F2}, UpdateSourceTrigger=LostFocus}"
                                                             Style="{StaticResource SpecTextBox}"/>
                                                </Border>
                                                <TextBlock Text="mm" Style="{StaticResource SpecUnit}"/>
                                            </StackPanel>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="두께"
                                                       Style="{StaticResource SpecFieldLabel}"/>
                                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                                <Border Style="{StaticResource SpecFieldBox}">
                                                    <TextBox Text="{Binding GlassThicknessMm, Mode=TwoWay, StringFormat={}{0:F2}, UpdateSourceTrigger=LostFocus}"
                                                             Style="{StaticResource SpecTextBox}"/>
                                                </Border>
                                                <TextBlock Text="mm" Style="{StaticResource SpecUnit}"/>
                                                <TextBlock Text="헤드 갭 설정의 기준"
                                                           Foreground="#475569" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="원점 오프셋 X"
                                                       Style="{StaticResource SpecFieldLabel}"/>
                                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                                <Border Style="{StaticResource SpecFieldBox}">
                                                    <TextBox Text="{Binding GlassOriginXMm, Mode=TwoWay, StringFormat={}{0:F3}, UpdateSourceTrigger=LostFocus}"
                                                             Style="{StaticResource SpecTextBox}"/>
                                                </Border>
                                                <TextBlock Text="mm" Style="{StaticResource SpecUnit}"/>
                                                <TextBlock Text="척 기준점 → 글라스 기준점"
                                                           Foreground="#475569" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="원점 오프셋 Y"
                                                       Style="{StaticResource SpecFieldLabel}"/>
                                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                                <Border Style="{StaticResource SpecFieldBox}">
                                                    <TextBox Text="{Binding GlassOriginYMm, Mode=TwoWay, StringFormat={}{0:F3}, UpdateSourceTrigger=LostFocus}"
                                                             Style="{StaticResource SpecTextBox}"/>
                                                </Border>
                                                <TextBlock Text="mm" Style="{StaticResource SpecUnit}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                    </Grid>
                </Border>

                <!-- ── 티칭 포인트 ──────────────────────────────────────── -->
                <Border Background="#111827" CornerRadius="8"
                        BorderBrush="#334155" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentDataType}" Value="Teach">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DataGrid x:Name="TeachingPointGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="False"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Standard"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              Background="Transparent" Foreground="White"
                              BorderThickness="0" BorderBrush="Transparent"
                              RowHeaderWidth="0" HeadersVisibility="Column"
                              RowHeight="42" ColumnHeaderHeight="42"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#2D3748"
                              RowBackground="#111827"
                              AlternatingRowBackground="#1A2233"
                              SelectionMode="Single"
                              ColumnHeaderStyle="{StaticResource RecipeColumnHeaderStyle}"
                              HorizontalScrollBarVisibility="Visible"
                              VerticalScrollBarVisibility="Auto"
                              GotFocus="TeachingGrid_GotFocus"
                              CellEditEnding="TeachingGrid_CellEditEnding">
                        <DataGrid.Resources>
                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ModernScrollBarStyle}"/>
                        </DataGrid.Resources>
                    </DataGrid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" 
                    Padding="15" Margin="0,15,0,0" 
                    BorderBrush="#334155" BorderThickness="1">
                <Grid>
                    <TextBlock Text="{DynamicResource Recipe_SaveApplyHint}"
                            Foreground="#64748B" FontSize="10"
                            VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- CANCEL 버튼 (IsDirty일 때만 표시) -->
                        <Button Command="{Binding CancelEditCommand}"
                                Style="{StaticResource MainDashboardButtonStyle}"
                                Width="150" Height="45" Margin="0,0,10,0"
                                Background="#7F1D1D" BorderBrush="#EF4444"
                                Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✕" FontSize="14" Margin="0,0,6,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Btn_CancelEdit}" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- DIFF 버튼 — 활성/선택 레시피 비교 (또는 임의 두 레시피). Admin 모드에서만 표시 -->
                        <Button Command="{Binding OpenDiffCommand}"
                                Width="160" Height="45" Background="#7C3AED" Margin="0,0,10,0"
                                ToolTip="두 레시피의 모든 파라미터/티칭 좌표 차이를 비교">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MainDashboardButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.CurrentUserRole, RelativeSource={RelativeSource AncestorType=Window}}" Value="Admin">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⇄" FontSize="14" Margin="0,0,6,0"
                                            VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Btn_DiffModels}" FontWeight="Bold"
                                            VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- SAVE 버튼 -->
                        <Button Command="{Binding SaveRecipeCommand}"
                                Style="{StaticResource RecipeSaveButtonStyle}"
                                ToolTip="{DynamicResource Btn_SaveModel_Tip}"
                                Width="180" Height="45" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💾" FontSize="14" Margin="0,0,6,0"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Btn_SaveModel}" FontWeight="Bold"
                                            VerticalAlignment="Center"/>
                                </StackPanel>
                        </Button>
                        <!-- APPLY 버튼은 상단 바(Axes 옆)로 이동 -->
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>