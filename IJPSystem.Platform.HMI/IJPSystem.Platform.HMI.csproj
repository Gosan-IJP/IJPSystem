<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <BaseOutputPath></BaseOutputPath>
	  <DisableShadowCopy>true</DisableShadowCopy>
	  <DesignerDisableShadowCopy>true</DesignerDisableShadowCopy>
    <!-- Comizoa WDM 드라이버 접근용 관리자 권한 요청 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Images\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.72" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.0-rc5.4" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IJPSystem.Drivers.IO\IJPSystem.Drivers.IO.csproj" />
    <!-- Motion·Machines.Pulse 는 App.xaml.cs / MainViewModel / PnidViewModel 이 직접 쓰는데도
         참조가 빠져 있었다. 지워지지 않은 obj\project.assets.json 이 옛 참조를 들고 있어서
         빌드가 통과했고, obj 를 지우는 순간 드러났다(2026-08-08). 캐시가 가려 준 것이라
         새로 받은 PC 나 CI 에서는 처음부터 실패한다. -->
    <ProjectReference Include="..\IJPSystem.Drivers.Motion\IJPSystem.Drivers.Motion.csproj" />
    <ProjectReference Include="..\IJPSystem.Drivers.Vision\IJPSystem.Drivers.Vision.csproj" />
    <ProjectReference Include="..\IJPSystem.Machines.Pulse\IJPSystem.Machines.Pulse.csproj" />
    <ProjectReference Include="..\IJPSystem.Platform.Application\IJPSystem.Platform.Application.csproj" />
    <ProjectReference Include="..\IJPSystem.Platform.Infrastructure\IJPSystem.Platform.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Images\logo.png" />
  </ItemGroup>


</Project>
